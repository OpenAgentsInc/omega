name: omega
title: Omega
base: core24
version: "$RELEASE_VERSION"
summary: The OpenAgents desktop client and integrated development environment
description: |
  Omega brings people, agents, conversations, code, reviews, approvals, and
  execution into one native workspace.
grade: stable
confinement: classic
compression: lzo
website: https://www.openagents.com/
source-code: https://github.com/OpenAgentsInc/omega
issues: https://github.com/OpenAgentsInc/omega/issues

parts:
  omega:
    plugin: dump
    source: "https://github.com/OpenAgentsInc/omega/releases/download/v$RELEASE_VERSION/omega-linux-x86_64.tar.gz"

    organize:
      # These renames seem to not be necessary, but it's tidier.
      bin: usr/bin
      libexec: usr/libexec

    stage-packages:
      - libasound2t64
      # snapcraft has a lint that this is unused, but without it Zed exits with
      # "Missing Vulkan entry points: LibraryLoadFailure" in wgpu.
      - libvulkan1
      # snapcraft has a lint that this is unused, but without it Zed exits with
      # "NoWaylandLib" when run with Wayland.
      - libwayland-client0
      - libxcb1
      - libxkbcommon-x11-0
      - libxkbcommon0

    build-attributes:
      - enable-patchelf

    prime:
      # Omit unneeded files from the tarball
      - -lib
      - -licenses.md
      - -share

      # Omit unneeded files from stage-packages
      - -etc
      - -usr/share/doc
      - -usr/share/lintian
      - -usr/share/man

apps:
  omega:
    command: usr/bin/omega
    common-id: com.openagents.omega
    environment:
      ZED_BUNDLE_TYPE: snap
