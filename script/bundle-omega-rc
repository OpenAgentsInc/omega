#!/usr/bin/env bash
# Owned Omega RC macOS package entry point (OMEGA-BRAND-05).
#
# Produces (or dry-runs the contract for):
#   Omega-v0.2.0-rc32-macos-arm64.dmg
#
# Does not claim notarization success. Notarization runs only when owner
# notarization secrets are present; otherwise the release record records that
# notarization was not attempted.

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$ROOT"

readonly OMEGA_RC_VERSION="0.2.0-rc32"
readonly OMEGA_RC_SEMVER="0.2.0"
readonly OMEGA_RC_CHANNEL="preview"
readonly OMEGA_RC_DISPLAY_CHANNEL="rc"
readonly OMEGA_TEAM_ID="HQWSG26L43"
readonly OMEGA_SIGNING_IDENTITY="Developer ID Application: OpenAgents, Inc. (${OMEGA_TEAM_ID})"
readonly OMEGA_BUNDLE_ID="com.openagents.omega.rc"
readonly OMEGA_VOLUME_NAME="Omega RC"
readonly OMEGA_ARTIFACT_NAME="Omega-v${OMEGA_RC_VERSION}-macos-arm64.dmg"
readonly OMEGA_RELEASE_RECORD_SCHEMA_VERSION=1
readonly OMEGA_BUILD_LOCK_SNAPSHOT_NAME="Cargo.lock.omega-v${OMEGA_RC_VERSION}"
readonly OMEGA_SOURCE_VERIFIER_PATH="script/verify-omega-identity"
readonly OMEGA_IDENTITY_BOUNDARY_LIST="BUZZ_PRIVATE_KEY,identity.key,get_nsec"
readonly OMEGA_BRAND_VERIFIER_PATH="script/verify-omega-brand"
readonly OMEGA_BRAND_POLICY_PATH="script/omega-brand-gate.json"
readonly OMEGA_EFFECTD_RELEASE_TAG="omega-effectd-v0.1.0-rc.12"
readonly OMEGA_EFFECTD_ASSET_NAME="omega-effectd-v0.1.0-macos-arm64.tar.gz"
readonly OMEGA_EFFECTD_ASSET_SHA256="7b4b34501aa9b53755413188ab67166fe7309ef9d12b59777bbd3644c21f1fdd"
readonly OMEGA_EFFECTD_MANIFEST_ASSET_SHA256="8f2760ba3a127b9141da747fd0015df96999aca573c0f6f454bc50b714f29f32"
readonly OMEGA_EFFECTD_SOURCE_COMMIT="43c090a191e779a97f0abe9cf7f14d9ff8317e91"
readonly OMEGA_EFFECTD_SOURCE_TREE="d77915cfe228a3b85d8241c03b8b2cba56579e0d"
readonly OMEGA_EFFECTD_DOWNLOAD_URL="https://github.com/OpenAgentsInc/openagents/releases/download/${OMEGA_EFFECTD_RELEASE_TAG}/${OMEGA_EFFECTD_ASSET_NAME}"

DRY_RUN=false
SKIP_BUILD=false
SELF_TEST_NOTARIZATION_KEY=false
TARGET_TRIPLE="aarch64-apple-darwin"
OUTPUT_DIR="${ROOT}/target/omega-rc"
RELEASE_RECORD_PATH=""
BUILD_LOCK_SNAPSHOT_PATH=""
BUILD_LOCK_SNAPSHOT_NAME=""
BUILD_LOCK_SNAPSHOT_DIGEST=""
OMEGA_BINARY_DIGEST=""
CLI_BINARY_DIGEST=""
IDENTITY_PROOF_BINARY_DIGEST=""
SCV_BINARY_DIGEST=""
SOURCE_VERIFIER_DIGEST=""
SOURCE_VERIFIER_PASSED=false
PACKAGED_BOUNDARY_SCAN_PASSED=false
BRAND_VERIFIER_DIGEST=""
BRAND_POLICY_DIGEST=""
BRAND_SOURCE_SCAN_PASSED=false
BRAND_PACKAGED_SCAN_PASSED=false
OMEGA_EFFECTD_ARCHIVE_PATH="${ROOT}/target/omega-effectd-cache/${OMEGA_EFFECTD_RELEASE_TAG}/${OMEGA_EFFECTD_ASSET_NAME}"
OMEGA_EFFECTD_MANIFEST_SHA256=""
OMEGA_EFFECTD_WRAPPER_SHA256=""
OMEGA_EFFECTD_BUNDLE_SHA256=""
OMEGA_EFFECTD_SOURCE_NODE_SHA256=""
OMEGA_EFFECTD_PACKAGED_NODE_SHA256=""
NOTARIZATION_KEY_FILE=""
NOTARIZATION_KEY_FILE_IS_TEMPORARY=false
PACKAGED_BINDINGS_JSON=""

usage() {
  cat <<EOF
Usage: ${0##*/} [--dry-run] [--skip-build] [--output-dir DIR] [--release-record PATH]
                       [--self-test-notarization-key]

Owned Omega RC packaging for macOS arm64.

Options:
  --dry-run              Validate prerequisites and release-record schema without
                         compiling, signing, or notarizing.
  --skip-build           Reuse an existing DMG at the expected output path and
                         validate its existing release record without modifying
                         or relabeling either file.
  --output-dir DIR       Directory for the DMG and release record
                         (default: target/omega-rc).
  --release-record PATH  Explicit release-record JSON path.
  --self-test-notarization-key
                         Verify path and inline PEM input normalization without
                         compiling, signing, or notarizing.
  -h, --help             Show this help.

Environment (owner secrets; never commit):
  MACOS_CERTIFICATE / MACOS_CERTIFICATE_PASSWORD
      Optional keychain import path (same shape as script/bundle-mac).
  APPLE_NOTARIZATION_KEY / APPLE_NOTARIZATION_KEY_ID / APPLE_NOTARIZATION_ISSUER_ID
      Required only when notarization should be attempted after signing. The
      key may be inline PEM contents or a path to a readable PEM file.
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --dry-run) DRY_RUN=true ;;
    --skip-build) SKIP_BUILD=true ;;
    --output-dir)
      OUTPUT_DIR="$2"
      shift
      ;;
    --release-record)
      RELEASE_RECORD_PATH="$2"
      shift
      ;;
    --self-test-notarization-key) SELF_TEST_NOTARIZATION_KEY=true ;;
    -h|--help)
      usage
      exit 0
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      usage >&2
      exit 2
      ;;
  esac
  shift
done

if [[ "${DRY_RUN}" == "true" && "${SKIP_BUILD}" == "true" ]]; then
  echo "error: --dry-run and --skip-build are mutually exclusive." >&2
  exit 2
fi

if [[ "${SELF_TEST_NOTARIZATION_KEY}" == "true" && ( "${DRY_RUN}" == "true" || "${SKIP_BUILD}" == "true" ) ]]; then
  echo "error: --self-test-notarization-key cannot be combined with build modes." >&2
  exit 2
fi

mkdir -p "${OUTPUT_DIR}"
BUILD_LOCK_SNAPSHOT_PATH="${OUTPUT_DIR}/${OMEGA_BUILD_LOCK_SNAPSHOT_NAME}"
if [[ -z "${RELEASE_RECORD_PATH}" ]]; then
  RELEASE_RECORD_PATH="${OUTPUT_DIR}/omega-v${OMEGA_RC_VERSION}-macos-arm64.release.json"
fi

sha256_file() {
  local path="$1"
  if [[ ! -f "${path}" ]]; then
    echo ""
    return 0
  fi
  shasum -a 256 "${path}" | awk '{print $1}'
}

prepare_notarization_key_file() {
  local key_input="$1"

  NOTARIZATION_KEY_FILE=""
  NOTARIZATION_KEY_FILE_IS_TEMPORARY=false

  if [[ -f "${key_input}" && -r "${key_input}" ]]; then
    NOTARIZATION_KEY_FILE="${key_input}"
    return 0
  fi

  if [[ "${key_input}" != *"-----BEGIN PRIVATE KEY-----"* ]]; then
    echo "error: APPLE_NOTARIZATION_KEY must be inline PEM contents or a readable file path." >&2
    return 1
  fi

  NOTARIZATION_KEY_FILE="$(mktemp)"
  NOTARIZATION_KEY_FILE_IS_TEMPORARY=true
  chmod 600 "${NOTARIZATION_KEY_FILE}"
  printf '%s\n' "${key_input}" > "${NOTARIZATION_KEY_FILE}"
}

cleanup_notarization_key_file() {
  if [[ "${NOTARIZATION_KEY_FILE_IS_TEMPORARY}" == "true" && -n "${NOTARIZATION_KEY_FILE}" ]]; then
    rm -f "${NOTARIZATION_KEY_FILE}"
  fi
  NOTARIZATION_KEY_FILE=""
  NOTARIZATION_KEY_FILE_IS_TEMPORARY=false
}

self_test_notarization_key() {
  local test_directory
  local path_key
  local inline_key
  local expected_digest
  local observed_digest

  test_directory="$(mktemp -d)"
  path_key="${test_directory}/AuthKey_TEST.p8"
  inline_key=$'-----BEGIN PRIVATE KEY-----\ndeterministic-test-value\n-----END PRIVATE KEY-----'
  printf '%s\n' "${inline_key}" > "${path_key}"

  prepare_notarization_key_file "${path_key}"
  if [[ "${NOTARIZATION_KEY_FILE}" != "${path_key}" || "${NOTARIZATION_KEY_FILE_IS_TEMPORARY}" != "false" ]]; then
    echo "error: notarization key path normalization self-test failed." >&2
    rm -rf "${test_directory}"
    return 1
  fi

  prepare_notarization_key_file "${inline_key}"
  expected_digest="$(printf '%s\n' "${inline_key}" | shasum -a 256 | awk '{print $1}')"
  observed_digest="$(sha256_file "${NOTARIZATION_KEY_FILE}")"
  if [[ "${expected_digest}" != "${observed_digest}" || "${NOTARIZATION_KEY_FILE_IS_TEMPORARY}" != "true" ]]; then
    echo "error: inline notarization key normalization self-test failed." >&2
    cleanup_notarization_key_file
    rm -rf "${test_directory}"
    return 1
  fi

  cleanup_notarization_key_file
  rm -rf "${test_directory}"
  echo "notarization key normalization self-test passed."
}

prepare_omega_effectd_archive() {
  mkdir -p "$(dirname "${OMEGA_EFFECTD_ARCHIVE_PATH}")"
  if [[ ! -f "${OMEGA_EFFECTD_ARCHIVE_PATH}" ]]; then
    local download_path="${OMEGA_EFFECTD_ARCHIVE_PATH}.download"
    curl --fail --location --silent --show-error \
      "${OMEGA_EFFECTD_DOWNLOAD_URL}" --output "${download_path}"
    mv "${download_path}" "${OMEGA_EFFECTD_ARCHIVE_PATH}"
  fi

  local archive_digest
  archive_digest="$(sha256_file "${OMEGA_EFFECTD_ARCHIVE_PATH}")"
  if [[ "${archive_digest}" != "${OMEGA_EFFECTD_ASSET_SHA256}" ]]; then
    echo "error: cached omega-effectd archive digest does not match the pinned release asset." >&2
    echo "  expected: ${OMEGA_EFFECTD_ASSET_SHA256}" >&2
    echo "  observed: ${archive_digest}" >&2
    exit 1
  fi

  local component_json
  component_json="$(python3 - "${OMEGA_EFFECTD_ARCHIVE_PATH}" "${OMEGA_EFFECTD_SOURCE_COMMIT}" "${OMEGA_EFFECTD_SOURCE_TREE}" <<'PY'
import hashlib
import json
import pathlib
import sys
import tarfile

archive_path = pathlib.Path(sys.argv[1])
expected_source_commit = sys.argv[2]
expected_source_tree = sys.argv[3]
expected_files = {
    "omega-effectd/bin/omega-effectd",
    "omega-effectd/component-manifest.json",
    "omega-effectd/dist/omega-effectd.mjs",
    "omega-effectd/dist/omega-effectd.mjs.LEGAL.txt",
    "omega-effectd/licenses/Node-LICENSE.txt",
    "omega-effectd/licenses/OpenAgents-Apache-2.0.txt",
    "omega-effectd/licenses/THIRD_PARTY_LICENSES.txt",
    "omega-effectd/licenses/THIRD_PARTY_NOTICES.json",
    "omega-effectd/runtime/bin/node",
}

with tarfile.open(archive_path, "r:gz") as archive:
    members = archive.getmembers()
    names = [member.name for member in members]
    if len(names) != len(set(names)):
        raise SystemExit("omega-effectd archive contains duplicate paths")
    for member in members:
        path = pathlib.PurePosixPath(member.name)
        if path.is_absolute() or ".." in path.parts:
            raise SystemExit(f"omega-effectd archive contains unsafe path: {member.name}")
        if not (member.isdir() or member.isfile()):
            raise SystemExit(f"omega-effectd archive contains unsupported entry: {member.name}")
    regular_files = {member.name for member in members if member.isfile()}
    if regular_files != expected_files:
        missing = sorted(expected_files - regular_files)
        unexpected = sorted(regular_files - expected_files)
        raise SystemExit(
            f"omega-effectd archive inventory mismatch; missing={missing}, unexpected={unexpected}"
        )

    def bytes_for(name: str) -> bytes:
        extracted = archive.extractfile(name)
        if extracted is None:
            raise SystemExit(f"omega-effectd archive entry is unreadable: {name}")
        return extracted.read()

    manifest_bytes = bytes_for("omega-effectd/component-manifest.json")
    manifest = json.loads(manifest_bytes)
    expected_manifest = {
        "schema": "openagents.omega.effectd.component.v1",
        "package": "@openagentsinc/omega-effectd",
        "serviceVersion": "0.1.0",
        "protocol": "openagents.omega.effectd.v1",
        "platform": "darwin-arm64",
    }
    for key, expected in expected_manifest.items():
        if manifest.get(key) != expected:
            raise SystemExit(f"omega-effectd manifest {key} does not match the pin")
    if manifest.get("source", {}).get("commit") != expected_source_commit:
        raise SystemExit("omega-effectd manifest source commit does not match the pin")
    if manifest.get("source", {}).get("tree") != expected_source_tree:
        raise SystemExit("omega-effectd manifest source tree does not match the pin")

    for relative, expected_digest in manifest.get("files", {}).items():
        name = f"omega-effectd/{relative}"
        if name not in regular_files:
            raise SystemExit(f"omega-effectd manifest names missing file: {relative}")
        observed = hashlib.sha256(bytes_for(name)).hexdigest()
        if observed != expected_digest:
            raise SystemExit(f"omega-effectd manifest digest mismatch: {relative}")

    node_bytes = bytes_for("omega-effectd/runtime/bin/node")
    source_node_digest = hashlib.sha256(node_bytes).hexdigest()
    if source_node_digest != manifest.get("node", {}).get("binarySha256"):
        raise SystemExit("omega-effectd Node binary digest does not match the manifest")
    if manifest.get("node", {}).get("version") != "24.13.1":
        raise SystemExit("omega-effectd Node version does not match the pin")

    print(json.dumps({
        "manifest_sha256": hashlib.sha256(manifest_bytes).hexdigest(),
        "wrapper_sha256": hashlib.sha256(bytes_for("omega-effectd/bin/omega-effectd")).hexdigest(),
        "bundle_sha256": hashlib.sha256(bytes_for("omega-effectd/dist/omega-effectd.mjs")).hexdigest(),
        "source_node_sha256": source_node_digest,
    }))
PY
)"

  OMEGA_EFFECTD_MANIFEST_SHA256="$(jq -r '.manifest_sha256' <<<"${component_json}")"
  OMEGA_EFFECTD_WRAPPER_SHA256="$(jq -r '.wrapper_sha256' <<<"${component_json}")"
  OMEGA_EFFECTD_BUNDLE_SHA256="$(jq -r '.bundle_sha256' <<<"${component_json}")"
  OMEGA_EFFECTD_SOURCE_NODE_SHA256="$(jq -r '.source_node_sha256' <<<"${component_json}")"
  if [[ "${OMEGA_EFFECTD_MANIFEST_SHA256}" != "${OMEGA_EFFECTD_MANIFEST_ASSET_SHA256}" ]]; then
    echo "error: omega-effectd component manifest digest does not match the pinned release asset." >&2
    exit 1
  fi
}

stage_omega_effectd_component() {
  local app_path="$1"
  local staging_directory
  staging_directory="$(mktemp -d)"
  tar -xzf "${OMEGA_EFFECTD_ARCHIVE_PATH}" -C "${staging_directory}"
  local component_source="${staging_directory}/omega-effectd"
  local component_target="${app_path}/Contents/Resources/omega-effectd"
  if [[ ! -x "${component_source}/bin/omega-effectd" || ! -x "${component_source}/runtime/bin/node" ]]; then
    echo "error: omega-effectd archive executables are not executable." >&2
    rm -rf "${staging_directory}"
    exit 1
  fi
  rm -rf "${component_target}"
  ditto "${component_source}" "${component_target}"
  rm -rf "${staging_directory}"

  if [[ "$(sha256_file "${component_target}/component-manifest.json")" != "${OMEGA_EFFECTD_MANIFEST_SHA256}" || \
        "$(sha256_file "${component_target}/bin/omega-effectd")" != "${OMEGA_EFFECTD_WRAPPER_SHA256}" || \
        "$(sha256_file "${component_target}/dist/omega-effectd.mjs")" != "${OMEGA_EFFECTD_BUNDLE_SHA256}" || \
        "$(sha256_file "${component_target}/runtime/bin/node")" != "${OMEGA_EFFECTD_SOURCE_NODE_SHA256}" ]]; then
    echo "error: staged omega-effectd component differs from the verified release archive." >&2
    exit 1
  fi
}

require_clean_checkout() {
  if [[ -n "$(git status --porcelain)" ]]; then
    echo "error: working tree is dirty; refuse to build an Omega RC candidate from an unrecorded tree." >&2
    git status --short >&2
    exit 1
  fi
}

require_arm64_host_or_target() {
  if [[ "${TARGET_TRIPLE}" != "aarch64-apple-darwin" ]]; then
    echo "error: this RC command only produces macos-arm64 artifacts (got ${TARGET_TRIPLE})." >&2
    exit 1
  fi
}

find_openagents_signing_identity() {
  local identities
  identities="$(security find-identity -v -p codesigning 2>/dev/null || true)"
  if ! grep -Fq "${OMEGA_SIGNING_IDENTITY}" <<<"${identities}"; then
    echo "error: required OpenAgents signing identity is missing:" >&2
    echo "  ${OMEGA_SIGNING_IDENTITY}" >&2
    echo "Team ID ${OMEGA_TEAM_ID} must be available in the login keychain before an RC package can be signed." >&2
    echo "Available codesigning identities:" >&2
    echo "${identities:-  (none)}" >&2
    exit 1
  fi
}

verify_packaged_identity_boundaries() {
  local app_path="$1"
  local forbidden_literal
  local matches
  local -a forbidden_literals=("BUZZ_PRIVATE_KEY" "identity.key" "get_nsec")
  for forbidden_literal in "${forbidden_literals[@]}"; do
    matches="$(LC_ALL=C grep -aRFl -- "${forbidden_literal}" "${app_path}" || true)"
    if [[ -n "${matches}" ]]; then
      echo "error: packaged Omega contains forbidden identity boundary ${forbidden_literal}:" >&2
      echo "${matches}" >&2
      exit 1
    fi
  done
  PACKAGED_BOUNDARY_SCAN_PASSED=true
}

verify_source_identity_boundaries() {
  "${OMEGA_SOURCE_VERIFIER_PATH}"
  SOURCE_VERIFIER_DIGEST="$(sha256_file "${OMEGA_SOURCE_VERIFIER_PATH}")"
  if [[ -z "${SOURCE_VERIFIER_DIGEST}" ]]; then
    echo "error: source identity verifier digest is unavailable." >&2
    exit 1
  fi
  SOURCE_VERIFIER_PASSED=true
}

# OMEGA-DELTA-0017 and OMEGA-DELTA-0018, source side.
verify_source_brand() {
  "${OMEGA_BRAND_VERIFIER_PATH}"
  BRAND_VERIFIER_DIGEST="$(sha256_file "${OMEGA_BRAND_VERIFIER_PATH}")"
  BRAND_POLICY_DIGEST="$(sha256_file "${OMEGA_BRAND_POLICY_PATH}")"
  if [[ -z "${BRAND_VERIFIER_DIGEST}" || -z "${BRAND_POLICY_DIGEST}" ]]; then
    echo "error: brand gate digests are unavailable." >&2
    exit 1
  fi
  BRAND_SOURCE_SCAN_PASSED=true
}

# OMEGA-DELTA-0017 and OMEGA-DELTA-0018, packaged side.
#
# 0.2.0-rc10 shipped thirteen Zed strings in its signed Info.plist and Zed logo
# marks on its status bar while every brand check on omega#16 passed, because
# those checks read the executable for three identity literals. Nothing had
# ever read Info.plist, and no string scan can see a logo. This runs against
# the built bundle, before signing, so a packaging regression fails here rather
# than in a macOS permission dialog on the owner's machine.
verify_packaged_brand() {
  local app_path="$1"
  "${OMEGA_BRAND_VERIFIER_PATH}" --app "${app_path}"
  BRAND_PACKAGED_SCAN_PASSED=true
}

validate_release_record_schema() {
  local path="$1"
  python3 - \
    "${path}" \
    "${OMEGA_RELEASE_RECORD_SCHEMA_VERSION}" \
    "${OMEGA_RC_VERSION}" \
    "${OMEGA_ARTIFACT_NAME}" \
    "${OMEGA_BUILD_LOCK_SNAPSHOT_NAME}" \
    "${OMEGA_RC_CHANNEL}" <<'PY'
import hashlib
import json
import re
import sys

path = sys.argv[1]
expected_schema = int(sys.argv[2])
expected_version, expected_artifact, expected_build_lock, expected_release_channel = (
    sys.argv[3:]
)
with open(path, encoding="utf-8") as handle:
    record = json.load(handle)

def valid_sha256(value):
    return isinstance(value, str) and re.fullmatch(r"[0-9a-f]{64}", value) is not None

required = [
    "schema_version",
    "product",
    "channel",
    "version",
    "bundle_version",
    "artifact_name",
    "volume_name",
    "bundle_identifier",
    "team_id",
    "signing_identity",
    "source",
    "toolchains",
    "execution",
    "build_inputs",
    "components",
    "digests",
    "identity_boundaries",
    "brand_gate",
    "notarization",
    "legal",
    "publication",
]
missing = [key for key in required if key not in record]
if missing:
    raise SystemExit(f"release-record missing keys: {', '.join(missing)}")

if record["schema_version"] != expected_schema:
    raise SystemExit(
        f"schema_version {record['schema_version']} != expected {expected_schema}"
    )
if record["product"] != "Omega":
    raise SystemExit("product must be Omega")
if record["channel"] != "rc":
    raise SystemExit("channel must be rc")
if record["version"] != expected_version:
    raise SystemExit(f"version must be {expected_version}")
if record["artifact_name"] != expected_artifact:
    raise SystemExit(f"artifact_name must be {expected_artifact}")
if record["bundle_version"] != "0.2.0":
    raise SystemExit("bundle_version must be 0.2.0")
if record["publication"].get("repository") != "OpenAgentsInc/omega":
    raise SystemExit("publication.repository must be OpenAgentsInc/omega")
if record["publication"].get("tag") != f"v{expected_version}":
    raise SystemExit(f"publication.tag must be v{expected_version}")
if record["publication"].get("prerelease") is not True:
    raise SystemExit("publication.prerelease must be true")
if record["publication"].get("latest") is not False:
    raise SystemExit("publication.latest must be false")
if record["legal"].get("commercial_terms_attached") is not False:
    raise SystemExit("legal.commercial_terms_attached must be false")
legal_notices = record["legal"].get("notices")
if not isinstance(legal_notices, dict) or not legal_notices:
    raise SystemExit("legal.notices must bind packaged paths to SHA-256 digests")
if not all(
    isinstance(name, str) and name and valid_sha256(digest)
    for name, digest in legal_notices.items()
):
    raise SystemExit("every legal notice must have a path and SHA-256 digest")
if "commit" not in record["source"]:
    raise SystemExit("source.commit is required")
if record["source"].get("dirty") is not False:
    raise SystemExit("source.dirty must be false")
worktree_entries = record["source"].get("worktree_entries")
if not isinstance(worktree_entries, list) or not all(
    isinstance(entry, str) and entry for entry in worktree_entries
):
    raise SystemExit("source.worktree_entries must be a list of non-empty strings")
transformations = record["source"].get("build_transformations")
if not isinstance(transformations, list):
    raise SystemExit("source.build_transformations must be a list")
if worktree_entries != (
    [] if not transformations else [" M crates/omega/RELEASE_CHANNEL"]
):
    raise SystemExit("source.worktree_entries includes an unowned build change")
for transformation in transformations:
    if not isinstance(transformation, dict) or set(transformation) != {
        "kind",
        "path",
        "committed_sha256",
        "generated_sha256",
        "generated_value",
    }:
        raise SystemExit("source.build_transformations has an invalid entry")
    if (
        transformation["kind"] != "temporary_release_channel"
        or transformation["path"] != "crates/omega/RELEASE_CHANNEL"
        or transformation["generated_value"] != expected_release_channel
        or not valid_sha256(transformation["committed_sha256"])
        or not valid_sha256(transformation["generated_sha256"])
        or transformation["generated_sha256"]
        != hashlib.sha256(f"{expected_release_channel}\n".encode()).hexdigest()
        or transformation["committed_sha256"]
        == transformation["generated_sha256"]
        or " M crates/omega/RELEASE_CHANNEL" not in worktree_entries
    ):
        raise SystemExit("source.build_transformations is not the owned channel rewrite")
digests = record["digests"]
for key in ("cargo_lock_sha256", "icon_family_manifest_sha256"):
    if key not in digests or not valid_sha256(digests[key]):
        raise SystemExit(f"digests.{key} must be a SHA-256 digest")
if "package_sha256" not in digests:
    raise SystemExit("digests.package_sha256 is required (null when absent)")
for key in ("omega_binary_sha256", "cli_binary_sha256"):
    if key not in digests:
        raise SystemExit(f"digests.{key} is required (null when absent)")
packaged_icons = digests.get("packaged_icon_outputs")
if not isinstance(packaged_icons, dict) or set(packaged_icons) != {
    "Contents/Resources/openagents-icon.icns",
    "Contents/Resources/Document.icns",
}:
    raise SystemExit("digests.packaged_icon_outputs has the wrong inventory")
if not all(valid_sha256(digest) for digest in packaged_icons.values()):
    raise SystemExit("every packaged icon output must have a SHA-256 digest")

execution = record["execution"]
if not isinstance(execution.get("dry_run"), bool):
    raise SystemExit("execution.dry_run must be a boolean")

owner_blockers = record.get("owner_blockers")
if not isinstance(owner_blockers, list) or not all(
    isinstance(blocker, str) and blocker for blocker in owner_blockers
):
    raise SystemExit("owner_blockers must be a list of non-empty strings")
notarization = record["notarization"]
# OMEGA-DELTA-0023. A stapled disk image whose application carries no ticket is
# the 0.2.0-rc11 shape: Gatekeeper acceptance of the installed product would
# rest on an online lookup and offline first start could not be proven.
if "app_stapled" not in notarization:
    raise SystemExit("notarization.app_stapled is required")
if notarization.get("stapled") is True and notarization.get("app_stapled") is not True:
    raise SystemExit(
        "the disk image is stapled but Omega.app is not; offline first start "
        "cannot be proven from this candidate"
    )
if notarization.get("stapled") is True and any(
    "notarization" in blocker.lower() for blocker in owner_blockers
):
    raise SystemExit("stapled releases must not retain a notarization blocker")
if execution["dry_run"] is False and any(
    "developer id" in blocker.lower() for blocker in owner_blockers
):
    raise SystemExit("built releases must not retain a Developer ID blocker")
if not any("publication" in blocker.lower() for blocker in owner_blockers):
    raise SystemExit("release record must retain the external publication blocker")

build_lock = record["build_inputs"].get("cargo_lock_snapshot", {})
for key in ("name", "sha256"):
    if key not in build_lock:
        raise SystemExit(f"build_inputs.cargo_lock_snapshot.{key} is required")

effectd = record["components"].get("omega_effectd", {})
expected_effectd = {
    "package": "@openagentsinc/omega-effectd",
    "service_version": "0.1.0",
    "protocol": "openagents.omega.effectd.v1",
    "platform": "darwin-arm64",
    "release_tag": "omega-effectd-v0.1.0-rc.12",
    "asset_name": "omega-effectd-v0.1.0-macos-arm64.tar.gz",
    "archive_sha256": "7b4b34501aa9b53755413188ab67166fe7309ef9d12b59777bbd3644c21f1fdd",
    "manifest_sha256": "8f2760ba3a127b9141da747fd0015df96999aca573c0f6f454bc50b714f29f32",
    "source_commit": "43c090a191e779a97f0abe9cf7f14d9ff8317e91",
    "source_tree": "d77915cfe228a3b85d8241c03b8b2cba56579e0d",
}
for key, expected in expected_effectd.items():
    if effectd.get(key) != expected:
        raise SystemExit(f"components.omega_effectd.{key} does not match the pin")
for key in ("wrapper_sha256", "bundle_sha256", "source_node_sha256"):
    if not valid_sha256(effectd.get(key)):
        raise SystemExit(f"components.omega_effectd.{key} must be a SHA-256 digest")
if effectd.get("packaged_node_sha256") is not None and not valid_sha256(effectd["packaged_node_sha256"]):
    raise SystemExit("components.omega_effectd.packaged_node_sha256 must be null or a SHA-256 digest")

identity_proof = record["components"].get("identity_proof_driver", {})
expected_identity_proof = {
    "path": "Contents/MacOS/omega-identity-proof",
    "protocol": "openagents.omega.identity-proof.v1",
    "keyring_service": "com.openagents.omega.identity-proof.v1",
    "keyring_account": "disposable-proof-only",
}
for key, expected in expected_identity_proof.items():
    if identity_proof.get(key) != expected:
        raise SystemExit(f"components.identity_proof_driver.{key} is invalid")
if identity_proof.get("binary_sha256") is not None and not valid_sha256(identity_proof["binary_sha256"]):
    raise SystemExit("components.identity_proof_driver.binary_sha256 must be null or a SHA-256 digest")

scv_agent = record["components"].get("scv_agent", {})
if scv_agent.get("path") != "Contents/MacOS/scv":
    raise SystemExit("components.scv_agent.path is invalid")
if scv_agent.get("protocol") != "acp":
    raise SystemExit("components.scv_agent.protocol is invalid")
if scv_agent.get("binary_sha256") is not None and not valid_sha256(scv_agent["binary_sha256"]):
    raise SystemExit("components.scv_agent.binary_sha256 must be null or a SHA-256 digest")

boundaries = record["identity_boundaries"]
source_verifier = boundaries.get("source_verifier", {})
if source_verifier.get("path") != "script/verify-omega-identity":
    raise SystemExit("identity_boundaries.source_verifier.path is invalid")
if source_verifier.get("passed") is not True:
    raise SystemExit("identity_boundaries.source_verifier.passed must be true")
if not valid_sha256(source_verifier.get("sha256")):
    raise SystemExit("identity_boundaries.source_verifier.sha256 must be a SHA-256 digest")
packaged_scan = boundaries.get("packaged_scan", {})
if packaged_scan.get("forbidden_literals") != [
    "BUZZ_PRIVATE_KEY",
    "identity.key",
    "get_nsec",
]:
    raise SystemExit("identity_boundaries.packaged_scan.forbidden_literals is invalid")

# OMEGA-DELTA-0017 and OMEGA-DELTA-0018. A release record that cannot say the
# brand gate ran is not evidence that it ran.
brand = record["brand_gate"]
brand_source = brand.get("source_verifier", {})
if brand_source.get("path") != "script/verify-omega-brand":
    raise SystemExit("brand_gate.source_verifier.path is invalid")
if brand_source.get("passed") is not True:
    raise SystemExit("brand_gate.source_verifier.passed must be true")
if not valid_sha256(brand_source.get("sha256")):
    raise SystemExit("brand_gate.source_verifier.sha256 must be a SHA-256 digest")
brand_policy = brand.get("policy", {})
if brand_policy.get("path") != "script/omega-brand-gate.json":
    raise SystemExit("brand_gate.policy.path is invalid")
if not valid_sha256(brand_policy.get("sha256")):
    raise SystemExit("brand_gate.policy.sha256 must be a SHA-256 digest")
brand_packaged = brand.get("packaged_scan", {})
if brand_packaged.get("surfaces") != ["Contents/Info.plist", "embedded icon assets"]:
    raise SystemExit("brand_gate.packaged_scan.surfaces is invalid")

if execution["dry_run"]:
    if any(build_lock.get(key) is not None for key in ("name", "sha256")):
        raise SystemExit("dry-run must not claim a build Cargo.lock snapshot")
    if any(
        digests.get(key) is not None
        for key in ("package_sha256", "omega_binary_sha256", "cli_binary_sha256")
    ):
        raise SystemExit("dry-run must not claim package or binary digests")
    if packaged_scan.get("passed") is not False:
        raise SystemExit("dry-run packaged boundary scan must be false")
    if brand_packaged.get("passed") is not False:
        raise SystemExit("dry-run packaged brand scan must be false")
    if effectd.get("packaged_node_sha256") is not None:
        raise SystemExit("dry-run must not claim a signed packaged omega-effectd Node digest")
    if identity_proof.get("binary_sha256") is not None:
        raise SystemExit("dry-run must not claim an identity proof driver digest")
else:
    if set(legal_notices) != {"LICENSE-GPL", "LICENSE-APACHE", "licenses.md"}:
        raise SystemExit("built release legal notice inventory is incomplete")
    for key in ("name", "sha256"):
        if not isinstance(build_lock.get(key), str) or not build_lock[key]:
            raise SystemExit(f"build_inputs.cargo_lock_snapshot.{key} must be non-empty")
    if build_lock["name"] != expected_build_lock:
        raise SystemExit("build_inputs.cargo_lock_snapshot.name is invalid")
    if not valid_sha256(build_lock["sha256"]):
        raise SystemExit("build_inputs.cargo_lock_snapshot.sha256 must be a SHA-256 digest")
    if digests["cargo_lock_sha256"] != build_lock["sha256"]:
        raise SystemExit("build Cargo.lock snapshot digest must match cargo_lock_sha256")
    for key in ("package_sha256", "omega_binary_sha256", "cli_binary_sha256"):
        if not valid_sha256(digests.get(key)):
            raise SystemExit(f"digests.{key} must be a SHA-256 digest")
    if packaged_scan.get("passed") is not True:
        raise SystemExit("built package boundary scan must pass")
    if brand_packaged.get("passed") is not True:
        raise SystemExit("built package brand scan must pass")
    if not valid_sha256(effectd.get("packaged_node_sha256")):
        raise SystemExit("built package must bind the signed omega-effectd Node digest")
    if not valid_sha256(identity_proof.get("binary_sha256")):
        raise SystemExit("built package must bind the signed identity proof driver digest")
print(f"release-record schema ok: {path}")
PY
}

collect_icon_digests_json() {
  python3 - <<'PY'
import json
from pathlib import Path

manifest_path = Path("crates/omega/resources/icon_family/manifest.json")
manifest = json.loads(manifest_path.read_text(encoding="utf-8"))
outputs = {
    relative: {"sha256": record["sha256"], "format": record["format"]}
    for relative, record in manifest.get("outputs", {}).items()
}
print(json.dumps({
    "manifest_sha256": __import__("hashlib").sha256(manifest_path.read_bytes()).hexdigest(),
    "pinned_png_sha256": manifest["pinned_source"]["png_sha256"],
    "pinned_icns_sha256": manifest["pinned_source"]["icns_sha256"],
    "outputs": outputs,
}))
PY
}

collect_source_packaged_bindings_json() {
  python3 - <<'PY'
import hashlib
import json
from pathlib import Path

legal = {}
for source, packaged in (
    (Path("LICENSE-GPL"), "LICENSE-GPL"),
    (Path("LICENSE-APACHE"), "LICENSE-APACHE"),
    (Path("assets/licenses.md"), "licenses.md"),
):
    if source.is_file():
        legal[packaged] = hashlib.sha256(source.read_bytes()).hexdigest()

icons = {}
for source, packaged in (
    (
        Path("crates/omega/resources/icon_family/source/openagents-icon.icns"),
        "Contents/Resources/openagents-icon.icns",
    ),
    (
        Path("crates/omega/resources/Document.icns"),
        "Contents/Resources/Document.icns",
    ),
):
    if not source.is_file():
        raise SystemExit(f"missing packaged icon source: {source}")
    icons[packaged] = hashlib.sha256(source.read_bytes()).hexdigest()

print(json.dumps({"legal_notices": legal, "icon_outputs": icons}, sort_keys=True))
PY
}

collect_staged_packaged_bindings_json() {
  local staged_root="$1"
  python3 - "${staged_root}" <<'PY'
import hashlib
import json
import plistlib
import sys
from pathlib import Path

root = Path(sys.argv[1])
app = root / "Omega.app"
if not app.is_dir():
    raise SystemExit(f"staged Omega app is missing: {app}")

legal = {}
for name in ("LICENSE-GPL", "LICENSE-APACHE", "licenses.md"):
    path = root / name
    if path.is_file():
        legal[name] = hashlib.sha256(path.read_bytes()).hexdigest()
if set(legal) != {"LICENSE-GPL", "LICENSE-APACHE", "licenses.md"}:
    raise SystemExit("staged package legal notice inventory is incomplete")

info = plistlib.loads((app / "Contents/Info.plist").read_bytes())
icon_name = info.get("CFBundleIconFile")
if not isinstance(icon_name, str) or not icon_name:
    raise SystemExit("staged Omega Info.plist has no CFBundleIconFile")
if not icon_name.endswith(".icns"):
    icon_name += ".icns"
icon_paths = [
    Path("Contents/Resources") / icon_name,
    Path("Contents/Resources/Document.icns"),
]
icons = {}
for relative in icon_paths:
    path = app / relative
    if not path.is_file():
        raise SystemExit(f"staged packaged icon is missing: {relative}")
    icons[relative.as_posix()] = hashlib.sha256(path.read_bytes()).hexdigest()

print(json.dumps({"legal_notices": legal, "icon_outputs": icons}, sort_keys=True))
PY
}

write_release_record() {
  local package_path="$1"
  local notarization_status="$2"
  local notarization_attempted="$3"
  local notarization_stapled="$4"
  local app_stapled="$5"
  local package_digest
  if [[ "${DRY_RUN}" == "true" ]]; then
    package_digest=""
  else
    package_digest="$(sha256_file "${package_path}")"
  fi
  if [[ -z "${package_digest}" ]]; then
    package_digest="null"
  fi

  local commit upstream_commit upstream_remote rustc_version host_triple cargo_lock_digest icon_json packaged_bindings_json
  commit="$(git rev-parse HEAD)"
  # The upstream Zed remote is named `zed`. `upstream` is the retired name and
  # is accepted only until every checkout has been renamed. This value is
  # release provenance, so an absent remote must fail loudly rather than
  # silently record a null upstream commit.
  for upstream_remote in zed upstream; do
    upstream_commit="$(git rev-parse "${upstream_remote}/main" 2>/dev/null || true)"
    if [[ -z "${upstream_commit}" ]]; then
      upstream_commit="$(git merge-base HEAD "${upstream_remote}/main" 2>/dev/null || true)"
    fi
    [[ -n "${upstream_commit}" ]] && break
  done
  if [[ -z "${upstream_commit}" ]]; then
    echo "error: no upstream Zed remote found (tried zed/main and upstream/main)." >&2
    echo "       add it with: git remote add zed https://github.com/zed-industries/zed.git" >&2
    echo "       then: git remote set-url --push zed DISABLED && git fetch zed main" >&2
    exit 1
  fi
  rustc_version="$(rustc --version)"
  host_triple="$(rustc -vV | awk '/^host:/{print $2}')"
  cargo_lock_digest="$(sha256_file Cargo.lock)"
  icon_json="$(collect_icon_digests_json)"
  packaged_bindings_json="${PACKAGED_BINDINGS_JSON:-$(collect_source_packaged_bindings_json)}"

  OMEGA_RC_RECORD_OUT="${RELEASE_RECORD_PATH}" \
  OMEGA_RC_SCHEMA_VERSION="${OMEGA_RELEASE_RECORD_SCHEMA_VERSION}" \
  OMEGA_RC_VERSION_VALUE="${OMEGA_RC_VERSION}" \
  OMEGA_RC_CHANNEL_VALUE="${OMEGA_RC_CHANNEL}" \
  OMEGA_RC_BUNDLE_VERSION_VALUE="${OMEGA_RC_SEMVER}" \
  OMEGA_RC_ARTIFACT_NAME="${OMEGA_ARTIFACT_NAME}" \
  OMEGA_RC_VOLUME_NAME="${OMEGA_VOLUME_NAME}" \
  OMEGA_RC_BUNDLE_ID="${OMEGA_BUNDLE_ID}" \
  OMEGA_RC_TEAM_ID="${OMEGA_TEAM_ID}" \
  OMEGA_RC_SIGNING_IDENTITY="${OMEGA_SIGNING_IDENTITY}" \
  OMEGA_RC_COMMIT="${commit}" \
  OMEGA_RC_UPSTREAM_COMMIT="${upstream_commit}" \
  OMEGA_RC_RUSTC="${rustc_version}" \
  OMEGA_RC_HOST="${host_triple}" \
  OMEGA_RC_CARGO_LOCK_DIGEST="${cargo_lock_digest}" \
  OMEGA_RC_BUILD_LOCK_SNAPSHOT_NAME="${BUILD_LOCK_SNAPSHOT_NAME:-}" \
  OMEGA_RC_BUILD_LOCK_SNAPSHOT_DIGEST="${BUILD_LOCK_SNAPSHOT_DIGEST}" \
  OMEGA_RC_ICON_JSON="${icon_json}" \
  OMEGA_RC_PACKAGED_BINDINGS_JSON="${packaged_bindings_json}" \
  OMEGA_RC_PACKAGE_DIGEST="${package_digest}" \
  OMEGA_RC_OMEGA_BINARY_DIGEST="${OMEGA_BINARY_DIGEST}" \
  OMEGA_RC_CLI_BINARY_DIGEST="${CLI_BINARY_DIGEST}" \
  OMEGA_RC_IDENTITY_PROOF_BINARY_DIGEST="${IDENTITY_PROOF_BINARY_DIGEST}" \
  OMEGA_RC_SCV_BINARY_DIGEST="${SCV_BINARY_DIGEST}" \
  OMEGA_RC_EFFECTD_RELEASE_TAG="${OMEGA_EFFECTD_RELEASE_TAG}" \
  OMEGA_RC_EFFECTD_ASSET_NAME="${OMEGA_EFFECTD_ASSET_NAME}" \
  OMEGA_RC_EFFECTD_ARCHIVE_DIGEST="${OMEGA_EFFECTD_ASSET_SHA256}" \
  OMEGA_RC_EFFECTD_SOURCE_COMMIT="${OMEGA_EFFECTD_SOURCE_COMMIT}" \
  OMEGA_RC_EFFECTD_SOURCE_TREE="${OMEGA_EFFECTD_SOURCE_TREE}" \
  OMEGA_RC_EFFECTD_MANIFEST_DIGEST="${OMEGA_EFFECTD_MANIFEST_SHA256}" \
  OMEGA_RC_EFFECTD_WRAPPER_DIGEST="${OMEGA_EFFECTD_WRAPPER_SHA256}" \
  OMEGA_RC_EFFECTD_BUNDLE_DIGEST="${OMEGA_EFFECTD_BUNDLE_SHA256}" \
  OMEGA_RC_EFFECTD_SOURCE_NODE_DIGEST="${OMEGA_EFFECTD_SOURCE_NODE_SHA256}" \
  OMEGA_RC_EFFECTD_PACKAGED_NODE_DIGEST="${OMEGA_EFFECTD_PACKAGED_NODE_SHA256}" \
  OMEGA_RC_SOURCE_VERIFIER_PATH="${OMEGA_SOURCE_VERIFIER_PATH}" \
  OMEGA_RC_SOURCE_VERIFIER_DIGEST="${SOURCE_VERIFIER_DIGEST}" \
  OMEGA_RC_SOURCE_VERIFIER_PASSED="${SOURCE_VERIFIER_PASSED}" \
  OMEGA_RC_PACKAGED_SCAN_PASSED="${PACKAGED_BOUNDARY_SCAN_PASSED}" \
  OMEGA_RC_IDENTITY_BOUNDARIES="${OMEGA_IDENTITY_BOUNDARY_LIST}" \
  OMEGA_RC_BRAND_VERIFIER_PATH="${OMEGA_BRAND_VERIFIER_PATH}" \
  OMEGA_RC_BRAND_VERIFIER_DIGEST="${BRAND_VERIFIER_DIGEST}" \
  OMEGA_RC_BRAND_POLICY_PATH="${OMEGA_BRAND_POLICY_PATH}" \
  OMEGA_RC_BRAND_POLICY_DIGEST="${BRAND_POLICY_DIGEST}" \
  OMEGA_RC_BRAND_SOURCE_PASSED="${BRAND_SOURCE_SCAN_PASSED}" \
  OMEGA_RC_BRAND_PACKAGED_PASSED="${BRAND_PACKAGED_SCAN_PASSED}" \
  OMEGA_RC_DRY_RUN="${DRY_RUN}" \
  OMEGA_RC_NOTARIZATION_STATUS="${notarization_status}" \
  OMEGA_RC_NOTARIZATION_ATTEMPTED="${notarization_attempted}" \
  OMEGA_RC_NOTARIZATION_STAPLED="${notarization_stapled}" \
  OMEGA_RC_NOTARIZATION_APP_STAPLED="${app_stapled}" \
  OMEGA_RC_PACKAGE_PATH="${package_path}" \
  python3 <<'PY'
import json
import os
from pathlib import Path

from script.omega_rc_source_state import classify_worktree_state


source_is_dirty, worktree_entries, build_transformations = classify_worktree_state(
    Path.cwd(), os.environ["OMEGA_RC_CHANNEL_VALUE"]
)
if source_is_dirty:
    raise SystemExit(
        "working tree changed unexpectedly during the RC build; refusing to write "
        "a release record"
    )
icons = json.loads(os.environ["OMEGA_RC_ICON_JSON"])
packaged_bindings = json.loads(os.environ["OMEGA_RC_PACKAGED_BINDINGS_JSON"])
upstream = os.environ.get("OMEGA_RC_UPSTREAM_COMMIT") or None
package_digest = os.environ["OMEGA_RC_PACKAGE_DIGEST"]
package_sha256 = None if package_digest == "null" else package_digest
package_path = os.environ["OMEGA_RC_PACKAGE_PATH"]
version = os.environ["OMEGA_RC_VERSION_VALUE"]
build_lock_name = os.environ.get("OMEGA_RC_BUILD_LOCK_SNAPSHOT_NAME") or None
build_lock_digest = os.environ.get("OMEGA_RC_BUILD_LOCK_SNAPSHOT_DIGEST") or None
omega_binary_digest = os.environ.get("OMEGA_RC_OMEGA_BINARY_DIGEST") or None
cli_binary_digest = os.environ.get("OMEGA_RC_CLI_BINARY_DIGEST") or None
identity_proof_binary_digest = os.environ.get("OMEGA_RC_IDENTITY_PROOF_BINARY_DIGEST") or None
scv_binary_digest = os.environ.get("OMEGA_RC_SCV_BINARY_DIGEST") or None
dry_run = os.environ["OMEGA_RC_DRY_RUN"] == "true"
notarization_attempted = os.environ["OMEGA_RC_NOTARIZATION_ATTEMPTED"] == "true"
notarization_stapled = os.environ["OMEGA_RC_NOTARIZATION_STAPLED"] == "true"

owner_blockers = []
if dry_run:
    owner_blockers.append(
        "Developer ID signing must complete before this dry-run record can become a release candidate"
    )
if not notarization_stapled:
    owner_blockers.append(
        "Owner notarization must complete and staple the candidate before distribution"
    )
owner_blockers.append("Human publication of the GitHub prerelease (never latest)")

record = {
    "schema_version": int(os.environ["OMEGA_RC_SCHEMA_VERSION"]),
    "product": "Omega",
    "channel": "rc",
    "version": version,
    "bundle_version": os.environ["OMEGA_RC_BUNDLE_VERSION_VALUE"],
    "artifact_name": os.environ["OMEGA_RC_ARTIFACT_NAME"],
    "volume_name": os.environ["OMEGA_RC_VOLUME_NAME"],
    "bundle_identifier": os.environ["OMEGA_RC_BUNDLE_ID"],
    "team_id": os.environ["OMEGA_RC_TEAM_ID"],
    "signing_identity": os.environ["OMEGA_RC_SIGNING_IDENTITY"],
    "source": {
        "commit": os.environ["OMEGA_RC_COMMIT"],
        "upstream_commit": upstream,
        # The owned channel rewrite is recorded below. Any other entry aborts
        # before a release record can be written.
        "dirty": source_is_dirty,
        "worktree_entries": worktree_entries,
        "build_transformations": build_transformations,
        "repository": "https://github.com/OpenAgentsInc/omega",
    },
    "toolchains": {
        "rustc": os.environ["OMEGA_RC_RUSTC"],
        "host": os.environ["OMEGA_RC_HOST"],
        "target": "aarch64-apple-darwin",
    },
    "execution": {
        "dry_run": dry_run,
    },
    "build_inputs": {
        "cargo_lock_snapshot": {
            "name": build_lock_name,
            "sha256": build_lock_digest,
        },
    },
    "digests": {
        "cargo_lock_sha256": os.environ["OMEGA_RC_CARGO_LOCK_DIGEST"],
        "icon_family_manifest_sha256": icons["manifest_sha256"],
        "pinned_png_sha256": icons["pinned_png_sha256"],
        "pinned_icns_sha256": icons["pinned_icns_sha256"],
        "icon_outputs": icons["outputs"],
        "packaged_icon_outputs": packaged_bindings["icon_outputs"],
        "package_sha256": package_sha256,
        "omega_binary_sha256": omega_binary_digest,
        "cli_binary_sha256": cli_binary_digest,
    },
    "components": {
        "omega_effectd": {
            "package": "@openagentsinc/omega-effectd",
            "service_version": "0.1.0",
            "protocol": "openagents.omega.effectd.v1",
            "platform": "darwin-arm64",
            "release_tag": os.environ["OMEGA_RC_EFFECTD_RELEASE_TAG"],
            "asset_name": os.environ["OMEGA_RC_EFFECTD_ASSET_NAME"],
            "archive_sha256": os.environ["OMEGA_RC_EFFECTD_ARCHIVE_DIGEST"],
            "source_commit": os.environ["OMEGA_RC_EFFECTD_SOURCE_COMMIT"],
            "source_tree": os.environ["OMEGA_RC_EFFECTD_SOURCE_TREE"],
            "manifest_sha256": os.environ["OMEGA_RC_EFFECTD_MANIFEST_DIGEST"],
            "wrapper_sha256": os.environ["OMEGA_RC_EFFECTD_WRAPPER_DIGEST"],
            "bundle_sha256": os.environ["OMEGA_RC_EFFECTD_BUNDLE_DIGEST"],
            "source_node_sha256": os.environ["OMEGA_RC_EFFECTD_SOURCE_NODE_DIGEST"],
            "packaged_node_sha256": (
                os.environ.get("OMEGA_RC_EFFECTD_PACKAGED_NODE_DIGEST") or None
            ),
        },
        "identity_proof_driver": {
            "path": "Contents/MacOS/omega-identity-proof",
            "binary_sha256": identity_proof_binary_digest,
            "protocol": "openagents.omega.identity-proof.v1",
            "keyring_service": "com.openagents.omega.identity-proof.v1",
            "keyring_account": "disposable-proof-only",
        },
        # OMEGA-DELTA-0203. The first-party agent Omega offers to delegate to,
        # recorded so a build that stopped shipping it is visible in the
        # release record rather than only on the owner's machine.
        "scv_agent": {
            "path": "Contents/MacOS/scv",
            "binary_sha256": scv_binary_digest,
            "protocol": "acp",
        },
    },
    "identity_boundaries": {
        "source_verifier": {
            "path": os.environ["OMEGA_RC_SOURCE_VERIFIER_PATH"],
            "sha256": os.environ["OMEGA_RC_SOURCE_VERIFIER_DIGEST"],
            "passed": os.environ["OMEGA_RC_SOURCE_VERIFIER_PASSED"] == "true",
        },
        "packaged_scan": {
            "passed": os.environ["OMEGA_RC_PACKAGED_SCAN_PASSED"] == "true",
            "forbidden_literals": os.environ["OMEGA_RC_IDENTITY_BOUNDARIES"].split(","),
        },
    },
    "brand_gate": {
        "source_verifier": {
            "path": os.environ["OMEGA_RC_BRAND_VERIFIER_PATH"],
            "sha256": os.environ["OMEGA_RC_BRAND_VERIFIER_DIGEST"],
            "passed": os.environ["OMEGA_RC_BRAND_SOURCE_PASSED"] == "true",
        },
        "policy": {
            "path": os.environ["OMEGA_RC_BRAND_POLICY_PATH"],
            "sha256": os.environ["OMEGA_RC_BRAND_POLICY_DIGEST"],
        },
        "packaged_scan": {
            "passed": os.environ["OMEGA_RC_BRAND_PACKAGED_PASSED"] == "true",
            "surfaces": ["Contents/Info.plist", "embedded icon assets"],
        },
    },
    "notarization": {
        "attempted": notarization_attempted,
        "stapled": notarization_stapled,
        "app_stapled": os.environ["OMEGA_RC_NOTARIZATION_APP_STAPLED"] == "true",
        "status": os.environ["OMEGA_RC_NOTARIZATION_STATUS"],
    },
    "legal": {
        "commercial_terms_attached": False,
        "notices": packaged_bindings["legal_notices"],
    },
    "publication": {
        "repository": "OpenAgentsInc/omega",
        "prerelease": True,
        "latest": False,
        "tag": f"v{version}",
    },
    "package_path": package_path if not dry_run and Path(package_path).is_file() else None,
    "owner_blockers": owner_blockers,
}

out_path = Path(os.environ["OMEGA_RC_RECORD_OUT"])
out_path.write_text(json.dumps(record, indent=2) + "\n", encoding="utf-8")
print(f"wrote release record: {out_path}")
PY

  validate_release_record_schema "${RELEASE_RECORD_PATH}"
}

validate_existing_release_record() {
  local package_path="$1"
  if [[ ! -f "${RELEASE_RECORD_PATH}" ]]; then
    echo "error: --skip-build requires existing release record at ${RELEASE_RECORD_PATH}" >&2
    exit 1
  fi
  validate_release_record_schema "${RELEASE_RECORD_PATH}"

  local commit package_digest verifier_digest
  commit="$(git rev-parse HEAD)"
  package_digest="$(sha256_file "${package_path}")"
  verifier_digest="$(sha256_file "${OMEGA_SOURCE_VERIFIER_PATH}")"
  python3 - \
    "${RELEASE_RECORD_PATH}" \
    "${OUTPUT_DIR}" \
    "${commit}" \
    "${OMEGA_ARTIFACT_NAME}" \
    "${package_digest}" \
    "${verifier_digest}" <<'PY'
import hashlib
import json
import sys
from pathlib import Path

record_path, output_dir, commit, artifact_name, package_digest, verifier_digest = (
    sys.argv[1:]
)
record = json.loads(Path(record_path).read_text(encoding="utf-8"))

if record["execution"]["dry_run"]:
    raise SystemExit("--skip-build cannot reuse a dry-run release record")
if record["source"].get("commit") != commit:
    raise SystemExit("--skip-build release record commit does not match HEAD")
if record.get("artifact_name") != artifact_name:
    raise SystemExit("--skip-build release record artifact name is stale")
if record["digests"].get("package_sha256") != package_digest:
    raise SystemExit("--skip-build package digest does not match release record")
if record["identity_boundaries"]["source_verifier"].get("sha256") != verifier_digest:
    raise SystemExit("--skip-build source verifier digest does not match release record")

snapshot = record["build_inputs"]["cargo_lock_snapshot"]
snapshot_name = snapshot["name"]
if Path(snapshot_name).name != snapshot_name:
    raise SystemExit("--skip-build Cargo.lock snapshot name must be a basename")
snapshot_path = Path(output_dir) / snapshot_name
if not snapshot_path.is_file():
    raise SystemExit(f"--skip-build Cargo.lock snapshot is missing: {snapshot_path}")
snapshot_digest = hashlib.sha256(snapshot_path.read_bytes()).hexdigest()
if snapshot_digest != snapshot["sha256"]:
    raise SystemExit("--skip-build Cargo.lock snapshot digest does not match release record")

print(f"validated existing Omega RC artifact and release record: {record_path}")
PY
}

restore_channel_and_version() {
  (
    cd "${ROOT}"
    if [[ -f "${_OMEGA_RC_CHANNEL_BACKUP_FILE:-}" ]]; then
      cp "${_OMEGA_RC_CHANNEL_BACKUP_FILE}" crates/omega/RELEASE_CHANNEL
      rm -f "${_OMEGA_RC_CHANNEL_BACKUP_FILE}"
    fi
    if [[ -f "${_OMEGA_RC_CARGO_BACKUP_FILE:-}" ]]; then
      cp "${_OMEGA_RC_CARGO_BACKUP_FILE}" crates/omega/Cargo.toml
      rm -f "${_OMEGA_RC_CARGO_BACKUP_FILE}"
    fi
    if [[ -f "${_OMEGA_RC_LOCK_BACKUP_FILE:-}" ]]; then
      cp "${_OMEGA_RC_LOCK_BACKUP_FILE}" Cargo.lock
      rm -f "${_OMEGA_RC_LOCK_BACKUP_FILE}"
    fi
    rm -f crates/omega/Cargo.toml.backup
  )
}

set_channel_and_version() {
  _OMEGA_RC_CHANNEL_BACKUP_FILE="$(mktemp)"
  _OMEGA_RC_CARGO_BACKUP_FILE="$(mktemp)"
  _OMEGA_RC_LOCK_BACKUP_FILE="$(mktemp)"
  cp crates/omega/RELEASE_CHANNEL "${_OMEGA_RC_CHANNEL_BACKUP_FILE}"
  cp crates/omega/Cargo.toml "${_OMEGA_RC_CARGO_BACKUP_FILE}"
  cp Cargo.lock "${_OMEGA_RC_LOCK_BACKUP_FILE}"

  printf '%s\n' "${OMEGA_RC_CHANNEL}" > crates/omega/RELEASE_CHANNEL
  python3 - <<PY
import re
from pathlib import Path
cargo = Path("crates/omega/Cargo.toml")
text = cargo.read_text(encoding="utf-8")
text2, count = re.subn(
    r'(?m)^version = "[^"]+"',
    'version = "${OMEGA_RC_SEMVER}"',
    text,
    count=1,
)
if count != 1:
    raise SystemExit("failed to set crates/omega/Cargo.toml version")
cargo.write_text(text2, encoding="utf-8")
PY
  export ZED_RELEASE_CHANNEL="${OMEGA_RC_CHANNEL}"
  export ZED_APP_VERSION="${OMEGA_RC_SEMVER}"
  export RELEASE_CHANNEL="${OMEGA_RC_CHANNEL}"
  # The per-version build number the settings footer renders (`v0.2.0 b28`).
  # It reuses the RC number, which this script already increments exactly once
  # per cut of the version, so no second counter exists to drift.
  local build_number="${OMEGA_RC_VERSION##*rc}"
  if ! [[ "${build_number}" =~ ^[0-9]+$ ]]; then
    echo "error: cannot derive OMEGA_BUILD_NUMBER from OMEGA_RC_VERSION=${OMEGA_RC_VERSION}" >&2
    exit 1
  fi
  export OMEGA_BUILD_NUMBER="${build_number}"
}

maybe_import_certificate() {
  if [[ -z "${MACOS_CERTIFICATE:-}" || -z "${MACOS_CERTIFICATE_PASSWORD:-}" ]]; then
    return 0
  fi
  echo "Importing MACOS_CERTIFICATE into a temporary keychain..."
  security create-keychain -p "${MACOS_CERTIFICATE_PASSWORD}" omega-rc.keychain || true
  security default-keychain -s omega-rc.keychain
  security unlock-keychain -p "${MACOS_CERTIFICATE_PASSWORD}" omega-rc.keychain
  security set-keychain-settings omega-rc.keychain
  echo "${MACOS_CERTIFICATE}" | base64 --decode > /tmp/omega-rc-certificate.p12
  security import /tmp/omega-rc-certificate.p12 -k omega-rc.keychain -P "${MACOS_CERTIFICATE_PASSWORD}" -T /usr/bin/codesign
  rm -f /tmp/omega-rc-certificate.p12
  security set-key-partition-list -S apple-tool:,apple:,codesign: -s -k "${MACOS_CERTIFICATE_PASSWORD}" omega-rc.keychain
  _OMEGA_RC_KEYCHAIN_CREATED=1
}

cleanup() {
  restore_channel_and_version || true
  cleanup_notarization_key_file
  if [[ "${_OMEGA_RC_KEYCHAIN_CREATED:-0}" == "1" ]]; then
    security default-keychain -s login.keychain || true
    security delete-keychain omega-rc.keychain || true
  fi
}

trap cleanup EXIT

if [[ "${SELF_TEST_NOTARIZATION_KEY}" == "true" ]]; then
  self_test_notarization_key
  exit 0
fi

require_arm64_host_or_target
require_clean_checkout
verify_source_identity_boundaries
verify_source_brand
prepare_omega_effectd_archive

DMG_PATH="${OUTPUT_DIR}/${OMEGA_ARTIFACT_NAME}"

if [[ "${SKIP_BUILD}" == "true" ]]; then
  if [[ ! -f "${DMG_PATH}" ]]; then
    echo "error: --skip-build requires existing package at ${DMG_PATH}" >&2
    exit 1
  fi
  validate_existing_release_record "${DMG_PATH}"
  exit 0
fi

if [[ "${DRY_RUN}" == "true" ]]; then
  echo "Omega RC dry-run"
  echo "  version:            ${OMEGA_RC_VERSION}"
  echo "  channel file value: ${OMEGA_RC_CHANNEL} (maps to ${OMEGA_RC_DISPLAY_CHANNEL})"
  echo "  bundle id:          ${OMEGA_BUNDLE_ID}"
  echo "  volume:             ${OMEGA_VOLUME_NAME}"
  echo "  artifact:           ${OMEGA_ARTIFACT_NAME}"
  echo "  team:               ${OMEGA_TEAM_ID}"
  echo "  signing identity:   ${OMEGA_SIGNING_IDENTITY}"
  find_openagents_signing_identity
  # Five arguments, not four: `app_stapled` arrived with the app-level staple
  # check and this call was not widened with it, so every dry run since has
  # died on `$5: unbound variable` after printing the plan. A dry run is the
  # affordance an independent reviewer is told to use before trusting a
  # candidate, so it has to reach the end.
  write_release_record "${DMG_PATH}" "not_attempted" "false" "false" "false"
  echo "dry-run complete; no compile, codesign, or notarization was performed."
  exit 0
fi

find_openagents_signing_identity
maybe_import_certificate
find_openagents_signing_identity

set_channel_and_version

echo "Preparing Omega RC ${OMEGA_RC_VERSION} (channel=${OMEGA_RC_CHANNEL})"
echo "Updating temporary Cargo.lock for omega ${OMEGA_RC_SEMVER}"
cargo update --package omega --precise "${OMEGA_RC_SEMVER}"
cp Cargo.lock "${BUILD_LOCK_SNAPSHOT_PATH}"
BUILD_LOCK_SNAPSHOT_NAME="${OMEGA_BUILD_LOCK_SNAPSHOT_NAME}"
BUILD_LOCK_SNAPSHOT_DIGEST="$(sha256_file "${BUILD_LOCK_SNAPSHOT_PATH}")"
if [[ -z "${BUILD_LOCK_SNAPSHOT_DIGEST}" ]]; then
  echo "error: failed to capture build Cargo.lock snapshot." >&2
  exit 1
fi

script/generate-licenses

rustup target add "${TARGET_TRIPLE}"

cargo_bundle_version="$(cargo -q bundle --help 2>&1 | head -n 1 || echo "")"
if [[ "${cargo_bundle_version}" != "cargo-bundle v0.6.1-zed" ]]; then
  cargo install cargo-bundle --git https://github.com/zed-industries/cargo-bundle.git --branch zed-deploy
fi

export CXXFLAGS="-stdlib=libc++"
export ZED_BUNDLE=true
export ZED_COMMIT_SHA="$(git rev-parse HEAD)"

echo "Compiling omega binaries for ${TARGET_TRIPLE}"
# OMEGA-DELTA-0203. `scv` is built here, with the same profile and target as
# the application, because it is a first-party agent Omega offers to delegate
# to. Nothing built it before, so the only machines that could start it were
# the ones where somebody had compiled and copied it onto PATH by hand.
cargo build --locked --release --package omega --package cli --package omega_identity --package scv --target "${TARGET_TRIPLE}"
cargo build --locked --release --package remote_server --target "${TARGET_TRIPLE}"

echo "Creating application bundle"
pushd crates/omega >/dev/null
cp Cargo.toml Cargo.toml.backup
sed \
  -i.backup \
  "s/package.metadata.bundle-${OMEGA_RC_CHANNEL}/package.metadata.bundle/" \
  Cargo.toml
app_path="$(TERM=xterm-256color CARGO_TERM_COLOR=never cargo bundle --release --target "${TARGET_TRIPLE}" --select-workspace-root | xargs)"
if [[ "$(sha256_file "${ROOT}/Cargo.lock")" != "${BUILD_LOCK_SNAPSHOT_DIGEST}" ]]; then
  echo "error: cargo-bundle changed Cargo.lock after the locked release build." >&2
  exit 1
fi
mv Cargo.toml.backup Cargo.toml
rm -f Cargo.toml.backup
popd >/dev/null

document_icon_source="crates/omega/resources/Document.icns"
document_icon_target="${app_path}/Contents/Resources/Document.icns"
if [[ -f "${document_icon_source}" ]]; then
  mkdir -p "$(dirname "${document_icon_target}")"
  cp "${document_icon_source}" "${document_icon_target}"
fi

# Do not embed the inherited Zed preview provisioning profile (team MQ55VZLNZQ).
rm -f "${app_path}/Contents/embedded.provisionprofile"

cp "target/${TARGET_TRIPLE}/release/omega" "${app_path}/Contents/MacOS/omega"
cp "target/${TARGET_TRIPLE}/release/cli" "${app_path}/Contents/MacOS/cli"
cp "target/${TARGET_TRIPLE}/release/omega-identity-proof" "${app_path}/Contents/MacOS/omega-identity-proof"
# Beside the application executable, which is where `omega_agent_detect` looks
# first: a packaged Omega has no shell PATH to fall back on.
cp "target/${TARGET_TRIPLE}/release/scv" "${app_path}/Contents/MacOS/scv"
stage_omega_effectd_component "${app_path}"
verify_packaged_identity_boundaries "${app_path}"
verify_packaged_brand "${app_path}"

# Strip associated-domains entitlement: it requires an Omega-owned profile.
entitlements_path="${OUTPUT_DIR}/omega-rc.entitlements"
sed '/com.apple.developer.associated-domains/,+1d' \
  crates/omega/resources/zed.entitlements > "${entitlements_path}"
effectd_node_entitlements_path="${OUTPUT_DIR}/omega-effectd-node.entitlements"
plutil -create xml1 "${effectd_node_entitlements_path}"
plutil -insert 'com\.apple\.security\.cs\.allow-jit' -bool true \
  "${effectd_node_entitlements_path}"
plutil -insert 'com\.apple\.security\.cs\.allow-unsigned-executable-memory' -bool true \
  "${effectd_node_entitlements_path}"

echo "Code signing with ${OMEGA_SIGNING_IDENTITY}"
/usr/bin/codesign --force --timestamp --options runtime \
  --entitlements "${effectd_node_entitlements_path}" \
  --sign "${OMEGA_SIGNING_IDENTITY}" \
  "${app_path}/Contents/Resources/omega-effectd/runtime/bin/node" -v
OMEGA_EFFECTD_PACKAGED_NODE_SHA256="$(sha256_file "${app_path}/Contents/Resources/omega-effectd/runtime/bin/node")"
/usr/bin/codesign --deep --force --timestamp --options runtime \
  --sign "${OMEGA_SIGNING_IDENTITY}" "${app_path}/Contents/MacOS/cli" -v
/usr/bin/codesign --deep --force --timestamp --options runtime \
  --sign "${OMEGA_SIGNING_IDENTITY}" "${app_path}/Contents/MacOS/omega-identity-proof" -v
/usr/bin/codesign --deep --force --timestamp --options runtime \
  --sign "${OMEGA_SIGNING_IDENTITY}" "${app_path}/Contents/MacOS/scv" -v
/usr/bin/codesign --deep --force --timestamp --options runtime \
  --entitlements "${entitlements_path}" \
  --sign "${OMEGA_SIGNING_IDENTITY}" "${app_path}/Contents/MacOS/omega" -v
/usr/bin/codesign --force --timestamp --options runtime \
  --entitlements "${entitlements_path}" \
  --sign "${OMEGA_SIGNING_IDENTITY}" "${app_path}" -v
OMEGA_BINARY_DIGEST="$(sha256_file "${app_path}/Contents/MacOS/omega")"
CLI_BINARY_DIGEST="$(sha256_file "${app_path}/Contents/MacOS/cli")"
IDENTITY_PROOF_BINARY_DIGEST="$(sha256_file "${app_path}/Contents/MacOS/omega-identity-proof")"
SCV_BINARY_DIGEST="$(sha256_file "${app_path}/Contents/MacOS/scv")"
if [[ -z "${SCV_BINARY_DIGEST}" ]]; then
  echo "error: the SCV agent binary is missing from the packaged application." >&2
  exit 1
fi
if [[ -z "${OMEGA_BINARY_DIGEST}" || -z "${CLI_BINARY_DIGEST}" || -z "${IDENTITY_PROOF_BINARY_DIGEST}" ]]; then
  echo "error: signed Omega binary digests are unavailable." >&2
  exit 1
fi

# OMEGA-DELTA-0023. Staple the APPLICATION, before the disk image is built.
#
# This script used to staple the DMG only. A DMG ticket covers the disk image
# the owner throws away; it does not travel with the application that ends up
# in /Applications, so `stapler validate /Applications/Omega.app` reported no
# ticket and Gatekeeper acceptance of the installed product could rest on an
# online lookup with Apple. omega#16 requires OFFLINE first start, which that
# cannot prove. The app is submitted and stapled here so the disk image below
# is assembled from an already-stapled application.
app_stapled="false"
if [[ -n "${APPLE_NOTARIZATION_KEY:-}" && -n "${APPLE_NOTARIZATION_KEY_ID:-}" && -n "${APPLE_NOTARIZATION_ISSUER_ID:-}" ]]; then
  echo "Submitting Omega.app for notarization (owner secrets present)..."
  prepare_notarization_key_file "${APPLE_NOTARIZATION_KEY}"
  xcode_bin_dir_path="$(xcode-select -p)/usr/bin"
  app_notarization_zip="${OUTPUT_DIR}/omega-app-notarization.zip"
  rm -f "${app_notarization_zip}"
  # notarytool takes an archive, not a bundle directory. ditto --keepParent
  # preserves the .app wrapper and its extended attributes.
  /usr/bin/ditto -c -k --keepParent "${app_path}" "${app_notarization_zip}"
  if "${xcode_bin_dir_path}/notarytool" submit --wait \
    --key "${NOTARIZATION_KEY_FILE}" \
    --key-id "${APPLE_NOTARIZATION_KEY_ID}" \
    --issuer "${APPLE_NOTARIZATION_ISSUER_ID}" \
    "${app_notarization_zip}"; then
    "${xcode_bin_dir_path}/stapler" staple "${app_path}"
    if "${xcode_bin_dir_path}/stapler" validate "${app_path}"; then
      app_stapled="true"
      echo "Stapled and validated ${app_path}"
    else
      echo "error: ${app_path} has no valid notarization ticket after stapling." >&2
      exit 1
    fi
  else
    echo "warning: app notarization submit failed; Omega.app remains signed but unstapled." >&2
    echo "         offline first start cannot be proven from this candidate." >&2
  fi
  rm -f "${app_notarization_zip}"
  cleanup_notarization_key_file
else
  echo "Notarization secrets absent; Omega.app is signed but not stapled."
  echo "Offline first start cannot be proven from this candidate."
fi

dmg_source_directory="${OUTPUT_DIR}/dmg-src"
rm -rf "${dmg_source_directory}"
mkdir -p "${dmg_source_directory}"
mv "${app_path}" "${dmg_source_directory}/"
stapled_app_path="${dmg_source_directory}/$(basename "${app_path}")"
ln -s /Applications "${dmg_source_directory}/Applications"
cp LICENSE-GPL LICENSE-APACHE "${dmg_source_directory}/"
if [[ -f assets/licenses.md ]]; then
  cp assets/licenses.md "${dmg_source_directory}/"
fi
PACKAGED_BINDINGS_JSON="$(collect_staged_packaged_bindings_json "${dmg_source_directory}")"

echo "Creating DMG ${DMG_PATH}"
rm -f "${DMG_PATH}"

# `hdiutil create -srcfolder` mounts its staging volume under /Volumes and
# copies there. On this host that copy began failing with
#
#   could not access /Volumes/Omega RC/Omega.app - Operation not permitted
#
# after 0.2.0-rc16 had built the same way from the same directory. The source
# tree is readable, carries no special flags, and /Volumes holds no stale
# mount; the refusal is on the destination, which is the shape of a privacy
# restriction on mounted volumes rather than anything about the artifact.
#
# A release must not depend on whether this machine will let a tool write
# under /Volumes, so the image is built at a mountpoint we choose. Same
# contents, same compressed format, no /Volumes involvement.
dmg_scratch_image="${OUTPUT_DIR}/.dmg-scratch.dmg"
dmg_scratch_mount="${OUTPUT_DIR}/.dmg-mnt"
rm -f "${dmg_scratch_image}"
rm -rf "${dmg_scratch_mount}"
mkdir -p "${dmg_scratch_mount}"

dmg_staged_megabytes="$(du -sm "${dmg_source_directory}" | cut -f1)"
hdiutil create -size "$(( dmg_staged_megabytes + 120 ))m" -fs HFS+ \
  -volname "${OMEGA_VOLUME_NAME}" -layout NONE "${dmg_scratch_image}" >/dev/null
hdiutil attach "${dmg_scratch_image}" -nobrowse -quiet -mountpoint "${dmg_scratch_mount}"
cp -R "${dmg_source_directory}/." "${dmg_scratch_mount}/"
hdiutil detach "${dmg_scratch_mount}" -quiet
hdiutil convert "${dmg_scratch_image}" -format UDZO -o "${DMG_PATH}" >/dev/null
rm -f "${dmg_scratch_image}"
rmdir "${dmg_scratch_mount}" 2>/dev/null || true

rm -f "${dmg_source_directory}/Applications"

/usr/bin/codesign --deep --force --timestamp --options runtime \
  --sign "${OMEGA_SIGNING_IDENTITY}" "${DMG_PATH}" -v

notarization_status="not_attempted"
notarization_attempted="false"
notarization_stapled="false"

if [[ -n "${APPLE_NOTARIZATION_KEY:-}" && -n "${APPLE_NOTARIZATION_KEY_ID:-}" && -n "${APPLE_NOTARIZATION_ISSUER_ID:-}" ]]; then
  notarization_attempted="true"
  echo "Submitting DMG for notarization (owner secrets present)..."
  prepare_notarization_key_file "${APPLE_NOTARIZATION_KEY}"
  xcode_bin_dir_path="$(xcode-select -p)/usr/bin"
  if "${xcode_bin_dir_path}/notarytool" submit --wait \
    --key "${NOTARIZATION_KEY_FILE}" \
    --key-id "${APPLE_NOTARIZATION_KEY_ID}" \
    --issuer "${APPLE_NOTARIZATION_ISSUER_ID}" \
    "${DMG_PATH}"; then
    "${xcode_bin_dir_path}/stapler" staple "${DMG_PATH}"
    if ! "${xcode_bin_dir_path}/stapler" validate "${DMG_PATH}"; then
      echo "error: ${DMG_PATH} has no valid notarization ticket after stapling." >&2
      exit 1
    fi
    notarization_status="submitted_and_stapled"
    notarization_stapled="true"
    # OMEGA-DELTA-0023. Both artifacts are validated, and the app ticket is
    # re-validated through its staged path so a stapled bundle cannot be
    # reported on the strength of the DMG's ticket alone.
    if ! "${xcode_bin_dir_path}/stapler" validate "${stapled_app_path}"; then
      echo "error: the staged Omega.app inside the disk image has no ticket." >&2
      exit 1
    fi
    echo "Stapled and validated ${DMG_PATH} and ${stapled_app_path}"
  else
    notarization_status="submit_failed"
    echo "warning: notarization submit failed; DMG remains signed but unstapled." >&2
  fi
  cleanup_notarization_key_file
else
  echo "Notarization secrets absent; leaving DMG signed but not notarized."
  echo "Release record will set notarization.status=not_attempted."
fi

write_release_record "${DMG_PATH}" "${notarization_status}" "${notarization_attempted}" "${notarization_stapled}" "${app_stapled}"

echo "Omega RC package ready:"
echo "  ${DMG_PATH}"
echo "  ${RELEASE_RECORD_PATH}"
if [[ "${notarization_stapled}" != "true" ]]; then
  echo "Note: notarization was not completed in this run."
fi
if [[ "${app_stapled}" != "true" ]]; then
  echo "Note: Omega.app is not stapled, so offline first start is not proven."
fi
