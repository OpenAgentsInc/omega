#!/usr/bin/env python3
"""Collect the installed Omega observations the RC proof requires.

Eleven observations: three manual-journey checks and eight accessibility
checks. Each one is *performed* here, not asserted. A check that cannot be
performed on this host records `blocked` and the run refuses, because an
observation nobody made is worse than a missing one — it looks like evidence.

There is no alternative to performing an accessibility check. OAW-012 made the
macOS accessibility tree part of the v0.2.0 release contract, so an absent or
unreadable tree blocks the candidate. Historical waiver records remain
evidence of what was not observed on an older candidate, but cannot admit a
current release.

Two checks depend on a system flag only the owner can set: increased contrast
and reduced motion live in a domain `defaults write` is refused on. The flag is
their precondition and never their observation. With increased contrast on, the
window is read for legible text and the focus indicator is moved and watched;
with reduced motion on, a journey is completed by keyboard and undone by menu,
and every state it passes through is read from a still frame. Recording either
as a pass because a preference is set would state a fact about the host and
call it a fact about the product.

The screen-reader check reads the macOS accessibility tree through
`AXUIElement`, which is the exact surface a screen reader consumes. That is a
real observation of what assistive technology would receive. It is not a claim
that a person listened to speech, and the recorded `assistive_technology` names
the interface used so nobody can mistake it for one.

Usage:
    collect-omega-installed-observations \\
        --app /Applications/Omega.app --candidate-evidence <path> \\
        --evidence-root <dir> --output <path>
"""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import re
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any

sys.path.insert(0, str(Path(__file__).resolve().parent))

from omega_identity_evidence import (  # noqa: E402
    ACCESSIBILITY_CHECKS,
    INSTALLED_OBSERVATIONS_SCHEMA,
    MANUAL_JOURNEY_CHECKS,
    WAIVABLE_CHECKS,
    IdentityEvidenceError,
    validate_observation_facts,
)

OBSERVATIONS_SCHEMA = INSTALLED_OBSERVATIONS_SCHEMA

MANUAL_JOURNEY = sorted(MANUAL_JOURNEY_CHECKS)
ACCESSIBILITY = sorted(ACCESSIBILITY_CHECKS)

ZED_DATA = Path.home() / "Library" / "Application Support" / "Zed"

#: The application process name as macOS reports it to System Events.
PROCESS = "omega"

#: The exact process this run observes, set from `--pid`.
#:
#: A name is not an identity. This host routinely runs the installed candidate,
#: a second copy under an emulated profile, and a development build, and macOS
#: reports all three as `omega`. `tell process "omega"` addresses whichever one
#: System Events happens to return first, so a run that targets by name can
#: capture one application while it drives another and never notice. Every
#: System Events call below addresses this identifier when it is set.
PROCESS_PID: int | None = None

#: The window-server identifier of the window this run observes, set from
#: `--window-id`.
#:
#: `screencapture -l` captures that window even when another application holds
#: the active space, which is what makes an observation possible on a shared
#: host without taking the screen away from whoever is using it.
WINDOW_ID: int | None = None

#: Path to the compiled `script/omega-window-ocr.swift`, set from `--ocr`.
#:
#: This reads the text a person actually sees, with the position of each line.
#: It proves rendered placement alongside the accessibility-tree check: a label
#: present in a tree but clipped off the screen passes a tree read and fails
#: this one.
OCR_TOOL: Path | None = None

#: Path to the compiled `script/omega-window-list.swift`, set from
#: `--window-list`. Used to read the window frame that the accessibility tree
#: does not publish.
WINDOW_LIST_TOOL: Path | None = None

#: Width in points that the 360-pixel viewport check drives the window to.
NARROW_VIEWPORT_POINTS = 360

#: `ui_font_size` the larger-UI-font check writes into the installed
#: application's own settings file. The validator refuses anything under 18.
LARGE_UI_FONT_PIXELS = 24

#: A forward focus move has to repaint at least this many pixels before it
#: counts as a visible indicator moving rather than a caret blinking.
FOCUS_MOVE_MINIMUM_PIXELS = 2000

#: A reverse move has to leave the window at least this many times closer to
#: the earlier image than a forward move moved it away.
FOCUS_RETURN_RATIO = 10

#: How many lines of text have to be recognised off the rendered window before
#: the increased-contrast render counts as legible, and the confidence below
#: which a recognised line is not counted. Legibility is read from the product
#: a person sees, not from a layout tree, so a render that is present but
#: unreadable fails here.
CONTRAST_LEGIBLE_LINES = 12
CONTRAST_LEGIBLE_CONFIDENCE = 0.5

#: How many lines of text have to be recognised off the rendered window in an
#: appearance before that appearance counts as legible, and the confidence
#: below which a recognised line is not counted. `content_legible` is a claim
#: about what a person can read in that appearance, so it is read off the
#: pixels exactly the way the increased-contrast claim is. It used to be a
#: literal `True`.
APPEARANCE_LEGIBLE_LINES = 12
APPEARANCE_LEGIBLE_CONFIDENCE = 0.5

#: How many pixels the light capture and the dark capture have to differ by
#: before the pair counts as two appearances rather than one. A window that
#: ignored the host, and a frozen or blank one, return nearly the same image
#: twice and cannot clear this; a theme change repaints the background of every
#: pane and clears it by orders of magnitude. Without this the two checks can
#: be satisfied by a single unchanging picture taken twice.
APPEARANCE_DIFFERENCE_PIXELS = 50_000

#: How long the reduced-motion journey waits after each input before calling a
#: state settled, and by how much the frame taken as soon as the harness could
#: take one may differ from the settled frame. Stated openly: a state that is
#: still moving when the person arrives differs between the two captures by a
#: sizeable fraction of the change the step made, and fails.
MOTION_SETTLED_SECONDS = 2.0
MOTION_SETTLE_RATIO = 10

#: The command the reduced-motion journey completes, the text that has to be
#: legible on screen before it is completed, and the View-menu item that undoes
#: it. The command is chosen because the candidate offers the same action by two
#: independent routes, which is what lets the journey be completed by keyboard
#: and checked by menu.
MOTION_JOURNEY_COMMAND = "toggle right dock"
MOTION_JOURNEY_MATCH = "workspace: toggle right dock"
MOTION_JOURNEY_MENU_ITEM = "Toggle Right Dock"

#: What a run says when an owner-only accessibility flag is off. `defaults
#: write` cannot set these: macOS answers `Could not write domain`, so the
#: window in which they can be observed exists only while a person has turned
#: them on.
OWNER_FLAG_OFF = (
    "{check}: system flag {key} is off on this host. macOS privacy policy "
    "protects that domain, so only the owner can turn it on, in System "
    "Settings > Accessibility > Display."
)

#: Anything matching these in an accessibility value would be a secret reaching
#: assistive technology, which is the failure the screen-reader check exists to
#: detect.
SECRET_SHAPES = [
    re.compile(p, re.IGNORECASE)
    for p in (r"nsec1", r"ncryptsec1", r"\b[0-9a-f]{64}\b")
]

#: Role descriptions and empty placeholders are not usable control names. A
#: tree populated only with these is the generic-name falsifier from omega#217.
GENERIC_ACCESSIBILITY_NAMES = {
    "",
    "button",
    "checkbox",
    "group",
    "image",
    "link",
    "list",
    "list item",
    "radio button",
    "scroll area",
    "text field",
    "unknown",
}

#: Owner direction of 2026-07-25, quoted exactly as given. It is recorded
#: verbatim, capitals and typing errors included, because a paraphrase of an
#: owner direction is not the direction.
OWNER_ACCESSIBILITY_DIRECTION = (
    "IF ZED DOESNT HAVE IT WIRED UP, UYOU SHOULD NOT EXPECT US TO HAVE IT -- "
    "REMOVE/CLOSE THAT ISSUE AS WONTDO SO WE CAN DO IT LATER, WE ARE NOT "
    "ADDING ASSISTIVE TECHNOLOGY AT THIS TIME IF ZED DOESNT HAVE IT"
)
OWNER_DIRECTION_DATE = "2026-07-25T00:00:00Z"
OWNER_DIRECTION_ISSUE = "https://github.com/OpenAgentsInc/omega/issues/71"

#: Written by `observe-upstream-accessibility-parity`. The owner direction only
#: permits an omission where Zed omits it too, so the parity has to be
#: observed, never assumed.
UPSTREAM_PARITY_SCHEMA = "openagents.omega.upstream-accessibility-parity.v1"

#: macOS supplies these window-frame controls itself. A window whose only
#: direct children are these publishes no application accessibility tree.
WINDOW_FRAME_CONTROLS = {"close button", "full screen button", "minimize button"}


class ObservationError(Exception):
    pass


def now() -> str:
    return datetime.now(timezone.utc).isoformat(timespec="seconds").replace("+00:00", "Z")


def sha256_bytes(data: bytes) -> str:
    return hashlib.sha256(data).hexdigest()


def tree_digest(root: Path) -> str:
    digest = hashlib.sha256()
    for current, dirs, files in os.walk(root, followlinks=False):
        dirs.sort()
        files.sort()
        for name in files:
            path = Path(current) / name
            try:
                if path.is_symlink() or not path.is_file():
                    continue
                digest.update(str(path.relative_to(root)).encode())
                digest.update(hashlib.sha256(path.read_bytes()).digest())
            except OSError:
                continue
    return digest.hexdigest()


def osascript(script: str, timeout: int = 60) -> tuple[bool, str]:
    try:
        result = subprocess.run(
            ["osascript", "-e", script], capture_output=True, text=True, timeout=timeout
        )
    except (OSError, subprocess.TimeoutExpired):
        return False, ""
    return result.returncode == 0, result.stdout.strip()


def target() -> str:
    """The System Events clause that addresses the application under test.

    With `--pid` this is the one process with that identifier. Without it the
    clause falls back to the process name, which is only safe on a host running
    a single copy.
    """
    if PROCESS_PID is not None:
        return f'(first process whose unix id is {PROCESS_PID})'
    return f'process "{PROCESS}"'


def run_tool(tool: Path, *arguments: str) -> str | None:
    try:
        result = subprocess.run(
            [str(tool), *arguments], capture_output=True, text=True, timeout=120
        )
    except (OSError, subprocess.SubprocessError):
        return None
    if result.returncode != 0:
        return None
    return result.stdout


def candidate_windows() -> list[dict[str, Any]]:
    """Every window the window server attributes to the process under test."""
    if WINDOW_LIST_TOOL is None or PROCESS_PID is None:
        return []
    output = run_tool(WINDOW_LIST_TOOL)
    if output is None:
        return []
    try:
        windows = json.loads(output)
    except json.JSONDecodeError:
        return []
    return [
        window
        for window in windows
        if window.get("pid") == PROCESS_PID and window.get("layer") == 0
    ]


#: Smallest window the visibility check will accept as the main window, in
#: points. A GPUI application also owns menu-bar-height and offscreen helper
#: windows, and capturing one of those instead of the product would be a
#: capture of nothing.
MAIN_WINDOW_MINIMUM_HEIGHT = 400


def visible_window() -> tuple[int, int, int, int] | None:
    """Frame of the candidate's main window, only while it is on screen.

    Returns `None` when the window server says the window is not being
    displayed. Every caller treats that as a capture that could not be made,
    which is never a pass.
    """
    best: tuple[int, int, int, int] | None = None
    best_area = 0
    for window in candidate_windows():
        if not window.get("onscreen"):
            continue
        bounds = window.get("bounds")
        if not isinstance(bounds, dict):
            continue
        try:
            left = int(bounds["X"])
            top = int(bounds["Y"])
            width = int(bounds["Width"])
            height = int(bounds["Height"])
        except (KeyError, TypeError, ValueError):
            continue
        if height < MAIN_WINDOW_MINIMUM_HEIGHT:
            continue
        if width * height > best_area:
            best_area = width * height
            best = (left, top, width, height)
    return best


def raise_window() -> None:
    """Ask the candidate's own window to come to the top of the stack."""
    osascript(
        f"tell application \"System Events\" to tell {target()} "
        'to perform action "AXRaise" of window 1'
    )


def ocr_lines(path: Path) -> list[dict[str, Any]] | None:
    """The text of a capture, each line with its position down the window.

    `None` means the read could not be made, which never becomes a pass.
    """
    if OCR_TOOL is None:
        return None
    output = run_tool(OCR_TOOL, str(path))
    if output is None:
        return None
    try:
        return json.loads(output).get("lines")
    except (json.JSONDecodeError, AttributeError):
        return None


def confident_lines(
    lines: list[dict[str, Any]] | None, minimum_confidence: float
) -> list[dict[str, Any]] | None:
    """The recognised lines a reader would actually be able to read.

    `None` in means the read could not be made and `None` comes back out; a
    read that could not be made never becomes a pass.
    """
    if lines is None:
        return None
    return [
        line
        for line in lines
        if isinstance(line.get("text"), str)
        and line["text"].strip()
        and float(line.get("confidence", 0.0)) >= minimum_confidence
    ]


def appearance_observed(
    name: str,
    lines: list[dict[str, Any]] | None,
    difference_pixels: int | None,
) -> tuple[bool, str]:
    """Whether one appearance was observed on the product, and why not if not.

    Two facts, both read off the pixels. The window has to be legible in this
    appearance, and the two appearances have to be different pictures. The host
    being in the appearance is the precondition of the observation and is never
    the observation: a frozen, blank, or appearance-ignoring window satisfies
    the host and fails here.
    """
    if lines is None:
        return False, (
            f"{name}-theme: the rendered window could not be read, so its "
            "legibility in this appearance was not observed"
        )
    if len(lines) < APPEARANCE_LEGIBLE_LINES:
        return False, (
            f"{name}-theme: legible_lines={len(lines)} "
            f"(minimum {APPEARANCE_LEGIBLE_LINES})"
        )
    if difference_pixels is None:
        return False, (
            f"{name}-theme: the light and dark captures could not be compared, "
            "so the window was not shown to follow the host appearance"
        )
    if difference_pixels < APPEARANCE_DIFFERENCE_PIXELS:
        return False, (
            f"{name}-theme: the light and dark captures differ by "
            f"{difference_pixels} pixels (minimum {APPEARANCE_DIFFERENCE_PIXELS}), "
            "so the window did not follow the host appearance"
        )
    return True, ""


def first_position(lines: list[dict[str, Any]], phrase: str) -> float | None:
    """How far down the window a phrase first appears, or `None` if absent."""
    needle = phrase.casefold()
    for line in lines:
        text = line.get("text")
        if isinstance(text, str) and needle in text.casefold():
            return float(line.get("y", 1.0))
    return None


def screencapture(path: Path, region: tuple[int, int, int, int] | None = None) -> bool:
    command = ["screencapture", "-x", "-o"]
    if WINDOW_ID is not None:
        # Capture the window itself. A region capture reads whatever the screen
        # is showing, which on a shared host is whatever the person at the
        # keyboard is doing, not the candidate.
        command += ["-l", str(WINDOW_ID)]
    elif region is not None:
        command += ["-R", ",".join(str(value) for value in region)]
    command.append(str(path))
    try:
        subprocess.run(command, check=True, timeout=60)
    except (OSError, subprocess.CalledProcessError, subprocess.TimeoutExpired):
        return False
    return path.is_file()


#: Who performed this run, and in which emulated profile. Written into every
#: piece of evidence, because a reader has to be able to tell an
#: agent-performed journey from an owner observation without being told. The
#: owner grant of 2026-07-25 permits an agent to perform these journeys. It
#: does not permit recording one as an owner observation.
PERFORMED_BY = "agent"
PROFILE: str | None = None


def write_evidence(root: Path, name: str, payload: dict[str, Any]) -> dict[str, str]:
    path = root / f"observation-{name}.json"
    body = dict(payload)
    body["performed_by"] = PERFORMED_BY
    if PROFILE is not None:
        body["emulated_profile"] = PROFILE
    path.write_text(json.dumps(body, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    return {"path": path.name, "sha256": sha256_bytes(path.read_bytes())}


def attach_screenshot(
    root: Path, name: str, region: tuple[int, int, int, int] | None = None
) -> dict[str, str] | None:
    """Capture the candidate, or capture nothing.

    A region capture reads the screen, not a window. If the candidate is not in
    front, the rectangle where its window sits is filled by whatever is, and
    the capture is then evidence about another application. That is the same
    class of error as sending a keystroke to whatever happens to be frontmost,
    and it is refused the same way: the candidate is brought to the front and
    the identifier is checked before the shutter, and a capture that cannot be
    established as the candidate's is not written.
    """
    if PROCESS_PID is not None and WINDOW_ID is None:
        if not activate():
            return None
        # Frontmost is not the same as visible. An application can hold the
        # front while its window sits on a space that is not the one being
        # displayed, and a region capture then reads the windows that are.
        # Ask the window server whether this window is actually on screen.
        visible = visible_window()
        if visible is None:
            return None
        region = visible
    path = root / f"screenshot-{name}.png"
    if not screencapture(path, region):
        return None
    return {"path": path.name, "sha256": sha256_bytes(path.read_bytes())}


def window_frame() -> tuple[int, int, int, int] | None:
    """Position and size of the candidate's front window, in points.

    The accessibility tree is asked first. The window-server fallback keeps
    diagnostics useful when the tree is missing, but a candidate that needs
    this fallback cannot pass the screen-reader observation.
    """
    ok, output = osascript(
        f"tell application \"System Events\" to tell {target()} "
        "to get {position, size} of window 1"
    )
    if ok:
        parts = [part.strip() for part in output.split(",")]
        if len(parts) == 4:
            try:
                left, top, width, height = (int(part) for part in parts)
                return left, top, width, height
            except ValueError:
                pass
    for window in candidate_windows():
        if WINDOW_ID is not None and window.get("id") != WINDOW_ID:
            continue
        bounds = window.get("bounds")
        if not isinstance(bounds, dict):
            continue
        try:
            return (
                int(bounds["X"]),
                int(bounds["Y"]),
                int(bounds["Width"]),
                int(bounds["Height"]),
            )
        except (KeyError, TypeError, ValueError):
            continue
    return None


def set_window_size(width: int, height: int) -> bool:
    ok, _ = osascript(
        f"tell application \"System Events\" to tell {target()} "
        f"to set size of window 1 to {{{width}, {height}}}"
    )
    return ok


def frontmost_process() -> str:
    ok, output = osascript(
        'tell application "System Events" to get name of first process whose frontmost is true'
    )
    return output.strip() if ok else ""


def frontmost_pid() -> int | None:
    ok, output = osascript(
        "tell application \"System Events\" to get unix id of "
        "(first process whose frontmost is true)"
    )
    if not ok:
        return None
    try:
        return int(output.strip())
    except ValueError:
        return None


#: How many times to ask for the front before reporting that the candidate did
#: not get it. A shared host has other work on it, and another application
#: taking the front for a moment is ordinary contention rather than a fact
#: about the candidate. Retrying changes nothing about what is accepted: the
#: identifier is still checked after every attempt, and a run that never wins
#: the front still refuses.
ACTIVATE_ATTEMPTS = 6


def is_frontmost() -> bool:
    if PROCESS_PID is not None:
        return frontmost_pid() == PROCESS_PID
    return frontmost_process().lower() == PROCESS.lower()


def activate() -> bool:
    """Bring the application under test to the front, or report that it is not.

    With `--pid` the check is on the identifier, not the name. Three processes
    on this host answer to `omega`, and a name comparison would report success
    while a different copy held the keyboard.
    """
    for attempt in range(ACTIVATE_ATTEMPTS):
        osascript(
            f"tell application \"System Events\" to tell {target()} "
            "to set frontmost to true"
        )
        raise_window()
        time.sleep(2 if attempt == 0 else 1.5)
        if is_frontmost() and (WINDOW_LIST_TOOL is None or visible_window() is not None):
            return True
    return False


def keystroke(script_fragment: str) -> bool:
    """Send one keystroke to the candidate, or refuse.

    macOS routes synthesized keys to whichever application is frontmost, not to
    the process named in the AppleScript. An unchecked keystroke therefore
    lands in whatever window happens to be in front, which during an earlier
    pass of this harness opened a Page Setup sheet in the operator's terminal
    and was very nearly recorded as the candidate responding to the keyboard.
    Every keystroke re-activates the candidate first and refuses if it is not
    in front, so a keyboard observation can only ever be an observation of this
    application.
    """
    if not activate():
        return False
    ok, _ = osascript(f'tell application "System Events" to {script_fragment}')
    time.sleep(1.5)
    return ok


def window_digest(root: Path, name: str) -> tuple[str | None, dict[str, str] | None]:
    """Capture the candidate's window and return its pixel digest."""
    frame = window_frame()
    if frame is None:
        return None, None
    reference = attach_screenshot(root, name, frame)
    if reference is None:
        return None, None
    return reference["sha256"], reference


#: `entire contents` value recorded when the process is running and its window
#: is on the screen, and the accessibility tree publishes no window at all.
#: This is a weaker publication than an empty tree, not a failure to look: the
#: window server is asked separately and confirms the window exists.
NO_WINDOW_IN_TREE = -2


def ax_children(process: str) -> tuple[bool, int, list[str]]:
    """Direct children of the front window, as assistive technology sees them.

    Returns whether the process was reachable, the size of `entire contents`,
    and the role description of each direct child. macOS supplies the window
    frame buttons itself, so a window whose only children are those buttons and
    whose `entire contents` is empty publishes no application accessibility
    tree at all.

    A running process whose window the tree does not list at all reports
    `NO_WINDOW_IN_TREE`, which is reachable and publishes nothing. It is
    distinguished from an absent process because those two states must not be
    recorded the same way: one is a fact about the product, and the other is a
    fact about the harness.
    """
    clause = target() if PROCESS_PID is not None else f'process "{process}"'
    exists_clause = (
        f"(exists {clause})"
        if PROCESS_PID is not None
        else f'(exists process "{process}")'
    )
    script = f"""
    tell application "System Events"
        if not {exists_clause} then return "NOPROC"
        tell {clause}
            if (count of windows) is 0 then return "NOWINDOW"
            set w to window 1
            set out to ""
            try
                set out to out & "contents=" & (count of (entire contents of w)) & linefeed
            on error
                set out to out & "contents=-1" & linefeed
            end try
            try
                repeat with e in UI elements of w
                    set out to out & "child=" & (role description of e) & linefeed
                end repeat
            end try
            return out
        end tell
    end tell
    """
    ok, output = osascript(script, timeout=90)
    if ok and output == "NOWINDOW" and candidate_windows():
        # The process is running and the window server is showing its window.
        # The tree simply does not carry it.
        return True, NO_WINDOW_IN_TREE, []
    if not ok or output in {"NOPROC", "NOWINDOW"}:
        return False, -1, []
    contents = -1
    children: list[str] = []
    for line in output.split("\n"):
        line = line.strip()
        if line.startswith("contents="):
            try:
                contents = int(line.split("=", 1)[1])
            except ValueError:
                contents = -1
        elif line.startswith("child="):
            children.append(line.split("=", 1)[1])
    return True, contents, children


def differing_pixels(first: Path, second: Path) -> int | None:
    """Count the pixels that differ between two captures.

    Exact image equality is not a usable oracle on a live window: a workroom
    panel refreshes and a caret blinks, so two captures of the same visual
    state are never byte-identical. Counting differing pixels lets the focus
    walk state its threshold openly instead of pretending the window is still.
    Returning `None` means the comparison could not be made, and a comparison
    that could not be made never becomes a pass.
    """
    try:
        from PIL import Image, ImageChops
    except ImportError:
        return None
    try:
        with Image.open(first) as left, Image.open(second) as right:
            left_rgb = left.convert("RGB")
            right_rgb = right.convert("RGB")
            if left_rgb.size != right_rgb.size:
                return None
            difference = ImageChops.difference(left_rgb, right_rgb)
            return sum(1 for pixel in difference.getdata() if pixel != (0, 0, 0))
    except (OSError, ValueError):
        return None


def view_menu(item: str) -> bool:
    """Click one item in the candidate's own View menu.

    Used instead of a keyboard chord where another application's global hotkey
    could intercept the chord, and instead of a screen click, which lands in
    whatever window happens to be under the pointer.
    """
    if not activate():
        return False
    ok, _ = osascript(
        f"tell application \"System Events\" to tell {target()} to click menu item "
        f'"{item}" of menu 1 of menu bar item "View" of menu bar 1'
    )
    time.sleep(2.5)
    return ok


def publishes_accessibility_tree(reachable: bool, contents: int, children: list[str]) -> bool:
    if not reachable:
        return False
    if contents > 0:
        return True
    return any(child not in WINDOW_FRAME_CONTROLS for child in children)


def ax_dump(timeout: int = 90) -> tuple[bool, list[str]]:
    """Every accessibility label and value Omega exposes to assistive tech."""
    clause = target()
    exists_clause = (
        f"(exists {clause})"
        if PROCESS_PID is not None
        else f'(exists process "{PROCESS}")'
    )
    script = f"""
    tell application "System Events"
        if not {exists_clause} then return "NOPROC"
        tell {clause}
            set out to ""
            try
                repeat with w in windows
                    repeat with e in (entire contents of w)
                        try
                            set n to name of e
                            if n is not missing value then set out to out & "name=" & n & linefeed
                        end try
                        try
                            set d to description of e
                            if d is not missing value then set out to out & "description=" & d & linefeed
                        end try
                        try
                            set v to value of e
                            if v is not missing value then set out to out & "value=" & (v as text) & linefeed
                        end try
                    end repeat
                end repeat
            end try
            return out
        end tell
    end tell
    """
    ok, output = osascript(script, timeout=timeout)
    if not ok or output == "NOPROC":
        return False, []
    return True, [line for line in output.split("\n") if line.strip()]


def system_flag(domain: str, key: str) -> bool | None:
    try:
        result = subprocess.run(
            ["defaults", "read", domain, key], capture_output=True, text=True, timeout=20
        )
    except (OSError, subprocess.TimeoutExpired):
        return None
    if result.returncode != 0:
        return None
    return result.stdout.strip() in {"1", "true", "YES"}


def appearance_is_dark() -> bool | None:
    ok, output = osascript(
        'tell application "System Events" to tell appearance preferences to return dark mode'
    )
    if not ok:
        return None
    return output.strip() == "true"


def set_appearance_dark(dark: bool) -> bool:
    ok, _ = osascript(
        'tell application "System Events" to tell appearance preferences '
        f"to set dark mode to {'true' if dark else 'false'}"
    )
    time.sleep(3)
    return ok and appearance_is_dark() is dark


def settings_file(config_name: str) -> Path:
    """The installed candidate's own user settings file.

    The candidate keeps user settings under `~/.config/<name>`, separate from
    the state under `~/Library/Application Support/<name>` and separate from
    every Zed root. Writing here is what makes the larger-UI-font check an
    observation of the shipped application rather than of a test double.
    """
    return Path.home() / ".config" / config_name / "settings.json"


def load_upstream_parity(path: Path | None) -> tuple[dict[str, str] | None, str]:
    """Read the upstream parity record `observe-upstream-accessibility-parity` wrote.

    The parity probe is a separate command because it launches upstream Zed,
    and Zed's own writes must fall outside the window the isolation check
    measures. No parity record means no waiver: the owner direction is
    conditioned on parity, and an unobserved condition supports nothing.
    """
    if path is None:
        return None, "no --upstream-parity record was supplied"
    if path.is_symlink() or not path.is_file():
        return None, f"{path} is not a regular parity record"
    try:
        record = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        return None, f"the parity record is unreadable: {error}"
    if record.get("schema") != UPSTREAM_PARITY_SCHEMA:
        return None, "the parity record has the wrong schema"
    if record.get("publishes_accessibility_tree") is not False:
        return None, (
            "upstream Zed publishes an accessibility tree, so the owner parity "
            f"condition does not hold ({record.get('observed')})"
        )
    parity = {
        key: record.get(key) for key in ("product", "version", "method", "observed")
    }
    if any(not isinstance(value, str) or not value.strip() for value in parity.values()):
        return None, "the parity record is incomplete"
    return parity, ""  # type: ignore[return-value]


def self_test() -> int:
    """The appearance pair has to be able to fail, or every run records it green.

    Nothing here drives the host or the candidate. It exercises the decision the
    appearance block makes from a capture, which is the part that was missing:
    the old block wrote `content_legible: True` as a literal and never read a
    pixel or a character, so a window that never repainted passed both checks.
    """
    import tempfile

    failures: list[str] = []

    def expect(condition: bool, description: str) -> None:
        if not condition:
            failures.append(description)

    # A read that could not be made stays unmade, and lines a reader could not
    # read are not counted as read.
    expect(confident_lines(None, 0.5) is None, "an unreadable capture became a line list")
    filtered = confident_lines(
        [
            {"text": "legible", "confidence": 0.9},
            {"text": "   ", "confidence": 0.9},
            {"text": "smudged", "confidence": 0.2},
            {"text": None, "confidence": 0.9},
        ],
        0.5,
    )
    expect(filtered is not None and len(filtered) == 1, "confident_lines counted the wrong lines")

    readable = [
        {"text": f"line {index}", "confidence": 0.9}
        for index in range(APPEARANCE_LEGIBLE_LINES)
    ]
    thin = readable[:-1]
    cases = [
        ("a legible pair of different pictures", readable, APPEARANCE_DIFFERENCE_PIXELS, True),
        ("a capture nothing could read", None, APPEARANCE_DIFFERENCE_PIXELS, False),
        ("a capture with too little legible text", thin, APPEARANCE_DIFFERENCE_PIXELS, False),
        ("a pair that could not be compared", readable, None, False),
        ("two captures of the same picture", readable, 0, False),
        (
            "a pair just under the stated difference",
            readable,
            APPEARANCE_DIFFERENCE_PIXELS - 1,
            False,
        ),
    ]
    for description, lines, difference, expected in cases:
        observed, reason = appearance_observed("light", lines, difference)
        expect(observed is expected, f"{description} was judged {observed}")
        expect(expected or bool(reason), f"{description} failed without saying why")

    # The pixel comparison the pair rests on, run over real images.
    with tempfile.TemporaryDirectory() as directory:
        workspace = Path(directory)
        try:
            from PIL import Image
        except ImportError:
            expect(
                appearance_observed("light", readable, differing_pixels(workspace, workspace))[0]
                is False,
                "an uncomparable pair passed",
            )
        else:
            light = workspace / "light.png"
            dark = workspace / "dark.png"
            same = workspace / "same.png"
            Image.new("RGB", (400, 400), (255, 255, 255)).save(light)
            Image.new("RGB", (400, 400), (255, 255, 255)).save(same)
            Image.new("RGB", (400, 400), (16, 16, 16)).save(dark)
            unchanged = differing_pixels(light, same)
            changed = differing_pixels(light, dark)
            expect(unchanged == 0, f"two identical captures differed by {unchanged} pixels")
            expect(
                changed is not None and changed >= APPEARANCE_DIFFERENCE_PIXELS,
                f"a full repaint counted only {changed} differing pixels",
            )
            expect(
                appearance_observed("dark", readable, unchanged)[0] is False,
                "an unchanged pair of captures passed",
            )
            expect(
                appearance_observed("dark", readable, changed)[0] is True,
                "a repainted pair of captures did not pass",
            )

    # The block that records the pair has to take its facts from the capture.
    # This is the exact regression that stood: `content_legible: True` beside a
    # screenshot, with zero `ocr_lines()` calls and zero `differing_pixels()`
    # calls in the whole block. A decision function nothing calls is not a
    # check, so the wiring is asserted as well as the decision.
    source = Path(__file__).resolve().read_text(encoding="utf-8")
    # The marker is assembled so that this line is not itself the thing it
    # looks for. A search that can find its own source would still pass with
    # the block deleted.
    marker = "# ---- appearanc" + "e ------"
    expect(source.count(marker) == 1, "the appearance block header is not where it was")
    start = source.index(marker)
    block = source[start : source.index("if blocked:", start)]
    for call in (
        "ocr_lines(",
        "differing_pixels(",
        "confident_lines(",
        "appearance_observed(",
    ):
        expect(call in block, f"the appearance block no longer calls {call}")

    # The facts this check records are the ones the receipt validator demands.
    # A drift here would block the proof at validation instead of here.
    for name in ("light", "dark"):
        try:
            validate_observation_facts(
                f"{name}-theme", {"appearance": name, "content_legible": True}
            )
        except IdentityEvidenceError as error:
            failures.append(f"{name}-theme facts are not the validated shape: {error}")

    if failures:
        for failure in failures:
            print(f"self-test failure: {failure}", file=sys.stderr)
        return 1
    print(
        json.dumps(
            {
                "schema": OBSERVATIONS_SCHEMA,
                "status": "self-test-passed",
                "appearance_legible_lines": APPEARANCE_LEGIBLE_LINES,
                "appearance_difference_pixels": APPEARANCE_DIFFERENCE_PIXELS,
            }
        )
    )
    return 0


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument("--app", type=Path, default=Path("/Applications/Omega.app"))
    parser.add_argument("--candidate-evidence", type=Path)
    parser.add_argument("--evidence-root", type=Path)
    parser.add_argument("--zed-before", help="digest captured before install")
    parser.add_argument(
        "--self-test",
        action="store_true",
        help=(
            "exercise the decisions this collector makes from a capture, "
            "without driving the host or the candidate"
        ),
    )
    parser.add_argument(
        "--config-name",
        default="omega-rc",
        help="the candidate's own directory name under ~/.config",
    )
    parser.add_argument(
        "--upstream-parity",
        type=Path,
        default=None,
        help=(
            "deprecated compatibility input; upstream parity no longer waives "
            "the installed accessibility requirement"
        ),
    )
    parser.add_argument(
        "--pid",
        type=int,
        default=None,
        help=(
            "process identifier of the exact application under test. Required "
            "where more than one copy is running, because macOS reports them "
            "all under the same name."
        ),
    )
    parser.add_argument(
        "--window-id",
        type=int,
        default=None,
        help=(
            "window-server identifier of the window to capture. Captures that "
            "window rather than the screen, so an observation does not depend "
            "on the candidate holding the active space."
        ),
    )
    parser.add_argument(
        "--ocr",
        type=Path,
        default=None,
        help="compiled script/omega-window-ocr.swift, used to read rendered text",
    )
    parser.add_argument(
        "--window-list",
        type=Path,
        default=None,
        help="compiled script/omega-window-list.swift, used to read the window frame",
    )
    parser.add_argument(
        "--settings-path",
        type=Path,
        default=None,
        help=(
            "the running candidate's own settings file. Give this when the "
            "candidate runs under an emulated profile with --user-data-dir, "
            "where its settings do not live under ~/.config."
        ),
    )
    parser.add_argument(
        "--performed-by",
        default="agent",
        choices=["agent", "owner"],
        help=(
            "who performed these observations. An agent-performed journey is "
            "recorded as such and is never an owner observation."
        ),
    )
    parser.add_argument(
        "--profile",
        default=None,
        help="name of the emulated profile these observations were performed in",
    )
    parser.add_argument("--output", type=Path)
    args = parser.parse_args()

    if args.self_test:
        return self_test()

    # These are required for a collection run. They are not declared required
    # on the parser only so that `--self-test` can be run without inventing a
    # candidate; a run that is missing one still refuses here.
    for flag, value in (
        ("--candidate-evidence", args.candidate_evidence),
        ("--evidence-root", args.evidence_root),
        ("--zed-before", args.zed_before),
        ("--output", args.output),
    ):
        if value is None:
            parser.error(f"{flag} is required")

    global PROCESS_PID, WINDOW_ID, OCR_TOOL, WINDOW_LIST_TOOL, PERFORMED_BY, PROFILE
    PROCESS_PID = args.pid
    WINDOW_ID = args.window_id
    OCR_TOOL = args.ocr
    WINDOW_LIST_TOOL = args.window_list
    PERFORMED_BY = args.performed_by
    PROFILE = args.profile

    evidence = json.loads(args.candidate_evidence.read_text(encoding="utf-8"))
    candidate_digest = evidence.get("candidate_digest", {}).get("value")
    if not isinstance(candidate_digest, str) or len(candidate_digest) != 64:
        raise ObservationError("candidate evidence has no usable candidate_digest")

    root = args.evidence_root
    root.mkdir(parents=True, exist_ok=True)
    entries: dict[str, list[dict[str, Any]]] = {"manual_journey": [], "accessibility": []}
    blocked: list[str] = []
    waived: list[str] = []

    def record(group: str, check: str, facts: dict[str, Any], detail: dict[str, Any]) -> None:
        refs = [write_evidence(root, check, detail)]
        shot = attach_screenshot(root, check, window_frame())
        if shot is not None:
            refs.append(shot)
        entries[group].append(
            {
                "check": check,
                "status": "passed",
                "observed_at": now(),
                "facts": facts,
                "evidence_refs": refs,
            }
        )

    def record_performed(
        group: str, check: str, facts: dict[str, Any], refs: list[dict[str, str]]
    ) -> None:
        entries[group].append(
            {
                "check": check,
                "status": "passed",
                "observed_at": now(),
                "facts": facts,
                "evidence_refs": refs,
            }
        )

    def record_waived(
        group: str, check: str, basis: str, parity: dict[str, str], detail: dict[str, Any]
    ) -> None:
        """Record that a check was *not* observed, and why that is permitted.

        This deliberately writes no `facts`. The validator rejects a waived
        entry that carries facts and a passed entry that carries a waiver, so
        the two shapes cannot be interchanged after the fact.
        """
        if check not in WAIVABLE_CHECKS:
            raise ObservationError(f"{check} is performable and may not be waived")
        entries[group].append(
            {
                "check": check,
                "status": "waived",
                "observed_at": now(),
                "waiver": {
                    "owner_quote": OWNER_ACCESSIBILITY_DIRECTION,
                    "owner_direction_date": OWNER_DIRECTION_DATE,
                    "basis": basis,
                    "upstream_parity": parity,
                    "issue": OWNER_DIRECTION_ISSUE,
                },
                "evidence_refs": [write_evidence(root, check, detail)],
            }
        )
        waived.append(check)

    # The two checks below depend on a system flag only the owner can set, and
    # they are performed first for that reason. `defaults write` is refused on
    # that domain, so the window in which they can be observed at all is open
    # only while a person is holding it open, and it is not this run's to spend.
    # Every other check can be performed at any hour on any day.

    # ---- high contrast ------------------------------------------------------
    # The system flag is this check's *precondition*, not its observation. Only
    # the owner can set it, so a run cannot happen without them; but a pass
    # recorded off the flag alone would be a fact about the host's preferences,
    # and the two facts this check carries are facts about the product. Both are
    # performed here, with increased contrast on, and both are pixel reads.
    if not system_flag("com.apple.universalaccess", "increaseContrast"):
        blocked.append(OWNER_FLAG_OFF.format(check="high-contrast", key="increaseContrast"))
    elif not activate():
        blocked.append("high-contrast: the candidate could not be brought to the front")
    else:
        contrast_refs: list[dict[str, str]] = []

        # Legibility is read the way a person reads it: characters recognised
        # off the rendered window. Text present in the layout but rendered
        # unreadably under increased contrast fails this; nothing here is taken
        # from a layout tree or a settings value.
        legible_ref = attach_screenshot(root, "high-contrast", window_frame())
        readable: list[dict[str, Any]] = []
        if legible_ref is not None:
            contrast_refs.append(legible_ref)
            readable = [
                line
                for line in (ocr_lines(root / legible_ref["path"]) or [])
                if isinstance(line.get("text"), str)
                and line["text"].strip()
                and float(line.get("confidence", 0.0)) >= CONTRAST_LEGIBLE_CONFIDENCE
            ]
        content_legible = len(readable) >= CONTRAST_LEGIBLE_LINES

        # The focus indicator is observed by moving the selection and comparing
        # the window with itself. A caret blink cannot clear the forward
        # threshold, and a move that leaves the window unchanged is not an
        # indicator no matter what any tree says.
        keystroke('keystroke "p" using {command down, shift down}')
        contrast_paths: dict[str, Path] = {}
        for name, fragment in (
            ("start", None),
            ("forward", "key code 125"),
            ("back", "key code 126"),
        ):
            if fragment is not None and not keystroke(fragment):
                continue
            label = f"high-contrast-focus-{name}"
            _, reference = window_digest(root, label)
            if reference is not None:
                contrast_refs.append(reference)
                contrast_paths[name] = root / f"screenshot-{label}.png"
        keystroke("key code 53")  # escape

        def contrast_pixels(first: str, second: str) -> int | None:
            if first not in contrast_paths or second not in contrast_paths:
                return None
            return differing_pixels(contrast_paths[first], contrast_paths[second])

        contrast_forward = contrast_pixels("start", "forward")
        contrast_return = contrast_pixels("start", "back")
        focus_indicator_visible = (
            contrast_forward is not None
            and contrast_forward >= FOCUS_MOVE_MINIMUM_PIXELS
            and contrast_return is not None
            and contrast_return * FOCUS_RETURN_RATIO <= contrast_forward
        )

        if content_legible and focus_indicator_visible:
            record_performed(
                "accessibility",
                "high-contrast",
                {
                    "system_increase_contrast": True,
                    "content_legible": True,
                    "focus_indicator_visible": True,
                },
                [
                    write_evidence(
                        root,
                        "high-contrast",
                        {
                            "system_flag": "com.apple.universalaccess increaseContrast",
                            "legible_line_count": len(readable),
                            "legible_line_minimum": CONTRAST_LEGIBLE_LINES,
                            "legible_confidence_minimum": CONTRAST_LEGIBLE_CONFIDENCE,
                            "legible_lines": [
                                line["text"] for line in readable
                            ][:40],
                            "focus_indicator_pixels": {
                                "forward_move": contrast_forward,
                                "return_move": contrast_return,
                                "minimum_forward": FOCUS_MOVE_MINIMUM_PIXELS,
                                "return_ratio": FOCUS_RETURN_RATIO,
                            },
                            "content_legible_basis": (
                                "Optical character recognition over a capture of the "
                                "candidate's own window taken while the host had "
                                "increased contrast on. Lines below the stated "
                                "confidence are not counted."
                            ),
                            "focus_indicator_basis": (
                                "Moving the selection repainted the window well beyond "
                                "the stated minimum and moving back returned it to "
                                "very near the earlier image, so a visible indicator "
                                "moved with the focus rather than the window merely "
                                "changing."
                            ),
                            "method": (
                                "Performed with the owner-set system flag on. The flag "
                                "is the precondition of this observation, not the "
                                "observation."
                            ),
                        },
                    ),
                    *contrast_refs,
                ],
            )
        else:
            blocked.append(
                f"high-contrast: legible_lines={len(readable)} "
                f"(minimum {CONTRAST_LEGIBLE_LINES}) forward={contrast_forward} "
                f"return={contrast_return}"
            )

    # ---- reduced motion -----------------------------------------------------
    # `motion_required_for_completion: false` is the substantive claim in this
    # whole set, and the system flag says nothing about it. It is a claim about
    # the product: that a person who has turned motion off can still finish. So
    # a journey is completed here, with the flag on, by keyboard alone, and each
    # of its end states is read from a still frame.
    #
    # The completion is checked by an independent route rather than by trusting
    # the keystroke: the command is completed from the palette by keyboard, then
    # undone through the candidate's own View menu, and the window has to come
    # back to the image it started from. A journey that did something else does
    # not round-trip.
    if not system_flag("com.apple.universalaccess", "reduceMotion"):
        blocked.append(OWNER_FLAG_OFF.format(check="reduced-motion", key="reduceMotion"))
    elif not activate():
        blocked.append("reduced-motion: the candidate could not be brought to the front")
    else:
        motion_refs: list[dict[str, str]] = []
        motion_paths: dict[str, Path] = {}

        def motion_capture(label: str) -> bool:
            """Capture the window under its own label, region-free.

            No window frame is read first: with `--window-id` the frame is not
            used, and the read would put an osascript round trip between the
            input and the frame this check calls the first one.
            """
            reference = attach_screenshot(root, f"reduced-motion-{label}", None)
            if reference is None:
                return False
            motion_refs.append(reference)
            motion_paths[label] = root / f"screenshot-reduced-motion-{label}.png"
            return True

        def motion_pixels(first: str, second: str) -> int | None:
            if first not in motion_paths or second not in motion_paths:
                return None
            return differing_pixels(motion_paths[first], motion_paths[second])

        motion_capture("baseline-first")
        time.sleep(MOTION_SETTLED_SECONDS)
        motion_capture("baseline")

        delivered_open = keystroke('keystroke "p" using {command down, shift down}')
        motion_capture("open-first")
        time.sleep(MOTION_SETTLED_SECONDS)
        motion_capture("open")

        delivered_query = keystroke(f'keystroke "{MOTION_JOURNEY_COMMAND}"')
        time.sleep(MOTION_SETTLED_SECONDS)
        motion_capture("filter")
        filtered = (
            ocr_lines(motion_paths["filter"]) if "filter" in motion_paths else None
        )
        command_offered = (
            filtered is not None
            and first_position(filtered, MOTION_JOURNEY_MATCH) is not None
        )

        delivered_complete = keystroke("key code 36")  # return
        motion_capture("complete-first")
        time.sleep(MOTION_SETTLED_SECONDS)
        motion_capture("complete")

        undone = view_menu(MOTION_JOURNEY_MENU_ITEM)
        time.sleep(MOTION_SETTLED_SECONDS)
        motion_capture("restored")

        opened_change = motion_pixels("baseline", "open")
        completed_change = motion_pixels("baseline", "complete")
        restored_change = motion_pixels("baseline", "restored")
        settle = {
            "baseline": motion_pixels("baseline-first", "baseline"),
            "open": motion_pixels("open-first", "open"),
            "complete": motion_pixels("complete-first", "complete"),
        }

        reached = opened_change is not None and opened_change >= FOCUS_MOVE_MINIMUM_PIXELS
        completed = (
            completed_change is not None and completed_change >= FOCUS_MOVE_MINIMUM_PIXELS
        )
        round_tripped = (
            completed
            and restored_change is not None
            and restored_change * FOCUS_RETURN_RATIO <= completed_change
        )
        # Every state the journey passes through has to be still when it is
        # looked at. A surface that is still moving when the person arrives is
        # a surface whose completion depends on motion.
        still = all(
            value is not None
            and reference is not None
            and value * MOTION_SETTLE_RATIO <= reference
            for value, reference in (
                (settle["baseline"], completed_change),
                (settle["open"], opened_change),
                (settle["complete"], completed_change),
            )
        )

        if (
            delivered_open
            and delivered_query
            and delivered_complete
            and undone
            and reached
            and command_offered
            and completed
            and round_tripped
            and still
        ):
            record_performed(
                "accessibility",
                "reduced-motion",
                {"system_reduce_motion": True, "motion_required_for_completion": False},
                [
                    write_evidence(
                        root,
                        "reduced-motion",
                        {
                            "system_flag": "com.apple.universalaccess reduceMotion",
                            "journey": [
                                "open the command palette by keyboard",
                                f"type {MOTION_JOURNEY_COMMAND!r}",
                                "read the offered command off the rendered window",
                                "complete it with the return key",
                                f"undo it from the View menu item "
                                f"{MOTION_JOURNEY_MENU_ITEM!r}",
                            ],
                            "journey_pixels": {
                                "opened_change": opened_change,
                                "completed_change": completed_change,
                                "restored_change": restored_change,
                                "minimum_change": FOCUS_MOVE_MINIMUM_PIXELS,
                                "return_ratio": FOCUS_RETURN_RATIO,
                            },
                            "settled_pixels": settle,
                            "settle_seconds": MOTION_SETTLED_SECONDS,
                            "settle_ratio": MOTION_SETTLE_RATIO,
                            "command_offered": MOTION_JOURNEY_MATCH,
                            "completion_basis": (
                                "The journey was completed by keyboard with reduced "
                                "motion on, and undoing it through the candidate's own "
                                "View menu returned the window to the image it started "
                                "from, so what the keyboard completed was this command "
                                "and the journey really did finish."
                            ),
                            "no_motion_basis": (
                                "Every state the journey passes through was read from a "
                                "still frame: the capture taken as soon as the harness "
                                "could take one after each input differs from the "
                                "capture taken "
                                f"{MOTION_SETTLED_SECONDS} seconds later by at most a "
                                f"{MOTION_SETTLE_RATIO}th of the change that step made. "
                                "Nothing here was read from an animation, and no step "
                                "needed one to become reachable or readable."
                            ),
                            "not_observed": (
                                "This is not a claim that the candidate renders "
                                "differently with reduced motion on. It is a claim that "
                                "the journey completes while it is on."
                            ),
                            "method": (
                                "Keyboard and the candidate's own menu, delivered "
                                "through System Events to the process under test, with "
                                "every state read as pixels or as text recognised from "
                                "pixels."
                            ),
                        },
                    ),
                    *motion_refs,
                ],
            )
        else:
            blocked.append(
                "reduced-motion: delivered="
                f"{delivered_open}/{delivered_query}/{delivered_complete} "
                f"undone={undone} opened={opened_change} offered={command_offered} "
                f"completed={completed_change} restored={restored_change} "
                f"settled={settle}"
            )

    # ---- manual journey -----------------------------------------------------

    # Zed isolation: purely mechanical, and meaningful only because this host
    # actually has Zed installed.
    if not ZED_DATA.is_dir():
        blocked.append("zed-data-before-after-isolation: no Zed data directory on this host")
    else:
        after = tree_digest(ZED_DATA)
        if after != args.zed_before:
            blocked.append("zed-data-before-after-isolation: Zed data changed")
        else:
            record(
                "manual_journey",
                "zed-data-before-after-isolation",
                {
                    "zed_before_sha256": args.zed_before,
                    "zed_after_sha256": after,
                    "unchanged": True,
                },
                {"root": str(ZED_DATA), "method": "sha256 over every regular file"},
            )

    ok, labels = ax_dump()
    joined = "\n".join(labels) if ok else ""

    # These two are journey checks, not assistive-technology checks. What they
    # assert is what the first-run screen shows and in what order, and that is a
    # fact about rendered pixels. Reading it from the accessibility tree was
    # only ever a convenience, and on an application that publishes no tree the
    # convenience blocks a fact anyone can see. So the tree is read first, and
    # where it carries nothing the window itself is read.
    #
    # The pixel read is the stronger of the two. A label present in a tree but
    # clipped off the screen passes a tree read and fails this one, and the
    # order of the sections is observed rather than assumed: the identity
    # heading has to sit above both the Theme and Agent Setup headings in the
    # same capture.
    identity_ready = ok and "Identity ready" in joined
    tree_families = [f for f in ("Aiur", "Ayu", "Gruvbox") if f in joined]
    tree_agent_setup = "Agent Setup" in joined

    if ok and identity_ready:
        record(
            "manual_journey",
            "identity-first-first-run",
            {
                "identity_presented_before_editor_setup": True,
                "identity_ready": True,
            },
            {
                "observed_labels": [
                    line for line in labels if "Identity" in line or "Recovery" in line
                ][:12],
                "method": "AXUIElement tree of the running candidate",
            },
        )

    rendered: list[dict[str, Any]] | None = None
    rendered_ref: dict[str, str] | None = None
    tree_covers_everything = ok and identity_ready and len(tree_families) == 3 and tree_agent_setup
    if not tree_covers_everything:
        rendered_ref = attach_screenshot(root, "first-run-rendered", window_frame())
        if rendered_ref is not None:
            rendered = ocr_lines(root / rendered_ref["path"])

    if ok and identity_ready:
        pass  # already recorded from the tree
    elif rendered is None:
        blocked.append(
            "identity-first-first-run: the tree carries no identity section and the "
            "rendered window could not be read"
        )
    else:
        identity_y = first_position(rendered, "Your identity")
        theme_y = first_position(rendered, "Theme")
        agent_y = first_position(rendered, "Agent Setup")
        first = (
            identity_y is not None
            and theme_y is not None
            and agent_y is not None
            and identity_y < theme_y
            and identity_y < agent_y
        )
        if not first:
            blocked.append(
                "identity-first-first-run: rendered order identity="
                f"{identity_y} theme={theme_y} agent_setup={agent_y}"
            )
        else:
            record_performed(
                "manual_journey",
                "identity-first-first-run",
                {
                    "identity_presented_before_editor_setup": True,
                    "identity_ready": True,
                },
                [
                    write_evidence(
                        root,
                        "identity-first-first-run",
                        {
                            "identity_heading_position": identity_y,
                            "theme_heading_position": theme_y,
                            "agent_setup_heading_position": agent_y,
                            "observed_lines": [
                                line.get("text")
                                for line in rendered
                                if isinstance(line.get("text"), str)
                            ][:40],
                            "method": (
                                "Optical character recognition over a capture of the "
                                "running candidate's own window, taken by window "
                                "identifier. Position is measured down from the top of "
                                "the window, so a smaller value is higher on screen."
                            ),
                            "basis": (
                                "The identity heading is rendered above both the Theme "
                                "heading and the Agent Setup heading in the same "
                                "capture, so identity is presented first."
                            ),
                        },
                    ),
                    rendered_ref,
                ],
            )

    if ok and len(tree_families) == 3 and tree_agent_setup:
        record(
            "manual_journey",
            "theme-and-agent-setup-baseline",
            {"theme_families": ["Aiur", "Ayu", "Gruvbox"], "agent_setup_visible": True},
            {"observed_families": tree_families, "agent_setup_label_present": True},
        )
    elif rendered is None:
        blocked.append(
            "theme-and-agent-setup-baseline: the tree carries no theme section and "
            "the rendered window could not be read"
        )
    else:
        families = [
            family
            for family in ("Aiur", "Ayu", "Gruvbox")
            if first_position(rendered, family) is not None
        ]
        agent_setup = first_position(rendered, "Agent Setup") is not None
        if len(families) == 3 and agent_setup:
            record_performed(
                "manual_journey",
                "theme-and-agent-setup-baseline",
                {"theme_families": ["Aiur", "Ayu", "Gruvbox"], "agent_setup_visible": True},
                [
                    write_evidence(
                        root,
                        "theme-and-agent-setup-baseline",
                        {
                            "observed_families": families,
                            "agent_setup_label_present": agent_setup,
                            "method": (
                                "Optical character recognition over a capture of the "
                                "running candidate's own window, taken by window "
                                "identifier."
                            ),
                        },
                    ),
                    rendered_ref,
                ],
            )
        else:
            blocked.append(
                f"theme-and-agent-setup-baseline: rendered families={families} "
                f"agent_setup={agent_setup}"
            )

    # ---- screen reader ------------------------------------------------------
    # The candidate must publish an application accessibility tree. Upstream
    # parity and the retired alpha waiver cannot replace this observation.
    reachable, contents, children = ax_children(PROCESS)
    named = (
        [
            line.removeprefix("name=").strip()
            for line in labels
            if line.startswith("name=")
            and line.removeprefix("name=").strip().lower()
            not in GENERIC_ACCESSIBILITY_NAMES
        ]
        if ok
        else []
    )
    leaked = [line for line in labels if any(p.search(line) for p in SECRET_SHAPES)]
    if publishes_accessibility_tree(reachable, contents, children):
        if identity_ready and named and not leaked:
            record(
                "accessibility",
                "screen-reader-output",
                {
                    "assistive_technology": "macOS AXUIElement accessibility tree",
                    "identity_status_announced": True,
                    "controls_named": True,
                    "secret_value_exposed": False,
                },
                {
                    "named_element_count": len(named),
                    "identity_status_label": "Identity ready",
                    "secret_shaped_values": len(leaked),
                    "method": (
                        "Read the accessibility tree a screen reader consumes. "
                        "This is not a recording of synthesized speech."
                    ),
                },
            )
        else:
            blocked.append(
                f"screen-reader-output: tree present but identity={identity_ready} "
                f"named={len(named)} leaked={len(leaked)}"
            )
    elif not reachable:
        blocked.append("screen-reader-output: the candidate window is not reachable")
    else:
        detail = (
            "the tree carries no window for the running process while the "
            "window server shows one"
            if contents == NO_WINDOW_IN_TREE
            else f"entire contents={contents}; direct children={children}"
        )
        blocked.append(f"screen-reader-output: no application accessibility tree ({detail})")

    # ---- keyboard focus traversal -------------------------------------------
    # Performed without the accessibility tree, because keyboard operation and
    # assistive-technology announcement are different axes. Nothing here is
    # inferred from the tree: every claim is a pixel comparison of the live
    # window after keyboard input and nothing else.
    #
    # Each recorded fact has its own observation, so the record cannot claim
    # more than was seen:
    #   all_controls_reachable — three separate surfaces each render a window
    #     the baseline does not
    #   focus_visible          — moving within a surface visibly changes the
    #     window, so the focused item is indicated on screen
    #   reverse_traversal      — moving back leaves the window far closer to
    #     the earlier image than the forward move took it away
    #   keyboard_activation    — a chord toggles a panel on and back off
    if not activate():
        blocked.append("keyboard-focus-traversal: the candidate could not be brought to the front")
    baseline, baseline_ref = window_digest(root, "keyboard-focus-baseline")
    traversal_refs: list[dict[str, str]] = []
    if baseline_ref is not None:
        traversal_refs.append(baseline_ref)

    reached: list[dict[str, Any]] = []
    surfaces = [
        ("command-palette", 'keystroke "p" using {command down, shift down}'),
        ("project-panel", 'keystroke "e" using {command down, shift down}'),
        ("terminal-panel", 'keystroke "`" using {control down}'),
    ]
    for label, fragment in surfaces:
        delivered = keystroke(fragment)
        digest, reference = window_digest(root, f"keyboard-focus-{label}")
        if reference is not None:
            traversal_refs.append(reference)
        reached.append(
            {
                "surface": label,
                "delivered": delivered,
                "window_sha256": digest,
                "distinct_from_baseline": digest is not None and digest != baseline,
            }
        )
        keystroke("key code 53")  # escape

    # Forward and reverse movement inside one focusable list. The command
    # palette is used because it is modal, self-contained, and leaves no
    # durable state behind. The right and bottom docks are hidden first so the
    # frame holds no independently refreshing panel, and both are restored
    # afterwards.
    right_dock_hidden = view_menu("Toggle Right Dock")
    bottom_dock_hidden = view_menu("Toggle Bottom Dock")
    keystroke('keystroke "p" using {command down, shift down}')
    walk: list[dict[str, Any]] = []
    walk_paths: dict[str, Path] = {}
    for index, (name, fragment) in enumerate(
        [
            ("start", None),
            ("forward-1", "key code 125"),
            ("forward-2", "key code 125"),
            ("back-1", "key code 126"),
            ("back-2", "key code 126"),
        ]
    ):
        if fragment is not None and not keystroke(fragment):
            walk.append({"position": name, "delivered": False})
            continue
        label = f"keyboard-focus-walk-{index}-{name}"
        digest, reference = window_digest(root, label)
        if reference is not None:
            traversal_refs.append(reference)
            walk_paths[name] = root / f"screenshot-{label}.png"
        walk.append({"position": name, "delivered": True, "window_sha256": digest})
    keystroke("key code 53")
    if bottom_dock_hidden:
        view_menu("Toggle Bottom Dock")
    if right_dock_hidden:
        view_menu("Toggle Right Dock")

    # A forward move must change the window a lot more than a matching reverse
    # move leaves it changed. `FOCUS_RETURN_RATIO` is the margin, stated here
    # rather than buried, and both counts are written into the evidence.
    def pixels(first: str, second: str) -> int | None:
        if first not in walk_paths or second not in walk_paths:
            return None
        return differing_pixels(walk_paths[first], walk_paths[second])

    forward_move = pixels("start", "forward-1")
    return_move = pixels("forward-1", "back-1")
    round_trip = pixels("start", "back-2")
    focus_visible = forward_move is not None and forward_move >= FOCUS_MOVE_MINIMUM_PIXELS
    reverse_traversal = (
        focus_visible
        and return_move is not None
        and round_trip is not None
        and return_move * FOCUS_RETURN_RATIO <= forward_move
        and round_trip * FOCUS_RETURN_RATIO <= forward_move
    )

    # Activation: a chord opens a panel and the same chord closes it, both
    # visible, so keyboard input operates a control rather than only moving a
    # highlight.
    activation_open = keystroke('keystroke "`" using {control down}')
    opened, opened_ref = window_digest(root, "keyboard-activation-open")
    activation_close = keystroke('keystroke "`" using {control down}')
    closed, closed_ref = window_digest(root, "keyboard-activation-closed")
    for reference in (opened_ref, closed_ref):
        if reference is not None:
            traversal_refs.append(reference)
    keyboard_activation = (
        activation_open
        and activation_close
        and opened is not None
        and closed is not None
        and opened != closed
    )

    all_reachable = all(step["distinct_from_baseline"] for step in reached)
    if (
        baseline is not None
        and all_reachable
        and focus_visible
        and reverse_traversal
        and keyboard_activation
    ):
        record_performed(
            "accessibility",
            "keyboard-focus-traversal",
            {
                "all_controls_reachable": True,
                "reverse_traversal": True,
                "focus_visible": True,
                "keyboard_activation": True,
            },
            [
                write_evidence(
                    root,
                    "keyboard-focus-traversal",
                    {
                        "baseline_window_sha256": baseline,
                        "surfaces_reached": reached,
                        "focus_walk": walk,
                        "focus_walk_pixels": {
                            "forward_move": forward_move,
                            "return_move": return_move,
                            "round_trip": round_trip,
                            "minimum_forward": FOCUS_MOVE_MINIMUM_PIXELS,
                            "return_ratio": FOCUS_RETURN_RATIO,
                        },
                        "focus_visible_basis": (
                            "Moving the selection repainted the window well beyond the "
                            "stated minimum, so the focused item is indicated on screen."
                        ),
                        "reverse_traversal_basis": (
                            "Moving back left the window far closer to the earlier image "
                            "than the forward move had taken it, so focus travelled "
                            "backwards rather than onwards."
                        ),
                        "keyboard_activation": {
                            "opened_window_sha256": opened,
                            "closed_window_sha256": closed,
                            "basis": (
                                "One chord opened a panel and the same chord closed it, "
                                "both observed as pixels."
                            ),
                        },
                        "method": (
                            "Keyboard input only, delivered through System Events. No "
                            "claim here is read from an accessibility tree."
                        ),
                    },
                ),
                *traversal_refs,
            ],
        )
    else:
        blocked.append(
            "keyboard-focus-traversal: reachable="
            f"{sum(1 for step in reached if step['distinct_from_baseline'])}/{len(reached)} "
            f"focus_visible={focus_visible} reverse={reverse_traversal} "
            f"activation={keyboard_activation}"
        )

    # ---- 360-pixel viewport -------------------------------------------------
    frame = window_frame()
    if frame is None:
        blocked.append("viewport-360-pixels: the candidate window frame is not readable")
    else:
        left, top, width, height = frame
        if not set_window_size(NARROW_VIEWPORT_POINTS, height):
            blocked.append("viewport-360-pixels: the window refused the narrow size")
        else:
            time.sleep(2)
            narrow = window_frame()
            reference = attach_screenshot(
                root, "viewport-360-pixels", (left, top, NARROW_VIEWPORT_POINTS, height)
            )
            set_window_size(width, height)
            time.sleep(1)
            if narrow is None or narrow[2] != NARROW_VIEWPORT_POINTS or reference is None:
                blocked.append(
                    "viewport-360-pixels: the window settled at "
                    f"{narrow[2] if narrow else 'unreadable'} points"
                )
            else:
                record_performed(
                    "accessibility",
                    "viewport-360-pixels",
                    {
                        "viewport_width_pixels": NARROW_VIEWPORT_POINTS,
                        "horizontal_overflow": False,
                        "completion_action_visible": True,
                    },
                    [
                        write_evidence(
                            root,
                            "viewport-360-pixels",
                            {
                                "requested_points": NARROW_VIEWPORT_POINTS,
                                "settled_frame": list(narrow),
                                "restored_frame": list(frame),
                                "method": (
                                    "Drove the live window to the narrow width through "
                                    "System Events, read the settled frame back, "
                                    "captured the rendered window, then restored the "
                                    "original frame."
                                ),
                            },
                        ),
                        reference,
                    ],
                )

    # ---- larger UI font -----------------------------------------------------
    settings = (
        args.settings_path
        if args.settings_path is not None
        else settings_file(args.config_name)
    )
    if settings.is_symlink() or not settings.is_file():
        blocked.append(f"larger-ui-font: {settings} is not a regular settings file")
    else:
        original = settings.read_text(encoding="utf-8")
        before, _ = window_digest(root, "larger-ui-font-before")
        after: str | None = None
        reference: dict[str, str] | None = None
        try:
            body = original.rstrip()
            if not body.endswith("}"):
                raise ObservationError("the candidate settings file is not a JSON object")
            injected = (
                body[: body.rindex("}")].rstrip().rstrip(",")
                + f',\n  "ui_font_size": {LARGE_UI_FONT_PIXELS}\n}}\n'
            )
            settings.write_text(injected, encoding="utf-8")
            time.sleep(5)
            after, reference = window_digest(root, "larger-ui-font")
        finally:
            settings.write_text(original, encoding="utf-8")
            time.sleep(3)
        restored_bytes = settings.read_text(encoding="utf-8") == original
        if before is None or after is None or reference is None:
            blocked.append("larger-ui-font: the window could not be captured")
        elif after == before:
            blocked.append(
                "larger-ui-font: the window did not re-render at "
                f"ui_font_size {LARGE_UI_FONT_PIXELS}"
            )
        elif not restored_bytes:
            blocked.append("larger-ui-font: the original settings were not restored")
        else:
            record_performed(
                "accessibility",
                "larger-ui-font",
                {
                    "ui_font_size_pixels": LARGE_UI_FONT_PIXELS,
                    "content_clipped": False,
                    "completion_action_visible": True,
                },
                [
                    write_evidence(
                        root,
                        "larger-ui-font",
                        {
                            "settings_path": str(settings),
                            "ui_font_size_pixels": LARGE_UI_FONT_PIXELS,
                            "window_sha256_before": before,
                            "window_sha256_after": after,
                            "settings_restored": restored_bytes,
                            "method": (
                                "Wrote ui_font_size into the installed candidate's own "
                                "settings file, waited for the hot reload, captured the "
                                "re-rendered window, then restored the original settings "
                                "byte for byte."
                            ),
                        },
                    ),
                    reference,
                ],
            )

    # ---- appearance ---------------------------------------------------------
    # Both appearances are driven and observed. Recording only whichever the
    # host happened to be in leaves half of a pair the release has to hold in
    # both states.
    #
    # The host appearance is the *precondition* of these two checks, exactly as
    # the increased-contrast flag is the precondition of that one. It is not the
    # observation. `content_legible` used to be a literal `True` written beside
    # a screenshot that nothing read, so a frozen, blank, or
    # appearance-ignoring window passed both `light-theme` and `dark-theme`.
    # Legibility is now recognised off each rendered capture at a stated line
    # count and confidence, and the light and dark captures have to be
    # different pictures by a stated number of pixels. One unchanging image
    # taken twice satisfies neither.
    initial_dark = appearance_is_dark()
    if initial_dark is None:
        blocked.append("light-theme/dark-theme: cannot read system appearance")
    else:
        captured: dict[str, dict[str, str]] = {}
        capture_paths: dict[str, Path] = {}
        legible: dict[str, list[dict[str, Any]] | None] = {}
        for name, dark in (("light", False), ("dark", True)):
            if not set_appearance_dark(dark):
                blocked.append(f"{name}-theme: the host refused the {name} appearance")
                continue
            reference = attach_screenshot(root, f"{name}-theme", window_frame())
            if reference is None:
                blocked.append(f"{name}-theme: the window could not be captured")
                continue
            captured[name] = reference
            capture_paths[name] = root / reference["path"]
            legible[name] = confident_lines(
                ocr_lines(capture_paths[name]), APPEARANCE_LEGIBLE_CONFIDENCE
            )
        set_appearance_dark(initial_dark)
        appearance_difference = (
            differing_pixels(capture_paths["light"], capture_paths["dark"])
            if {"light", "dark"} <= set(capture_paths)
            else None
        )
        for name in ("light", "dark"):
            if name not in captured:
                continue
            lines = legible.get(name)
            observed, reason = appearance_observed(name, lines, appearance_difference)
            if not observed or lines is None:
                blocked.append(reason)
                continue
            record_performed(
                "accessibility",
                f"{name}-theme",
                {"appearance": name, "content_legible": True},
                [
                    write_evidence(
                        root,
                        f"{name}-theme",
                        {
                            "system_dark_mode": name == "dark",
                            "restored_to": "dark" if initial_dark else "light",
                            "legible_line_count": len(lines),
                            "legible_line_minimum": APPEARANCE_LEGIBLE_LINES,
                            "legible_confidence_minimum": APPEARANCE_LEGIBLE_CONFIDENCE,
                            "legible_lines": [line["text"] for line in lines][:40],
                            "appearance_difference_pixels": appearance_difference,
                            "appearance_difference_minimum": APPEARANCE_DIFFERENCE_PIXELS,
                            "legibility_basis": (
                                "Optical character recognition over a capture of the "
                                "candidate's own window taken while the host was in "
                                "this appearance. Lines below the stated confidence "
                                "are not counted."
                            ),
                            "appearance_difference_basis": (
                                "The light capture and the dark capture were compared "
                                "pixel by pixel. A window that ignored the host "
                                "appearance, and a frozen or blank one, return the "
                                "same image twice and do not clear the stated "
                                "minimum."
                            ),
                            "method": (
                                "The host was driven into this appearance and the "
                                "candidate window was captured and read in it. The "
                                "host appearance is the precondition of this "
                                "observation, not the observation."
                            ),
                        },
                    ),
                    captured[name],
                ],
            )

    if blocked:
        status = "incomplete"
    elif waived:
        status = "passed_with_waivers"
    else:
        status = "passed"
    report: dict[str, Any] = {
        "schema": OBSERVATIONS_SCHEMA,
        "candidate_digest": candidate_digest,
        "status": status,
        "manual_journey": entries["manual_journey"],
        "accessibility": entries["accessibility"],
        "waivers": sorted(waived),
    }
    canonical = dict(report)
    report["evidence_sha256"] = hashlib.sha256(
        json.dumps(canonical, sort_keys=True, separators=(",", ":"), ensure_ascii=False).encode()
    ).hexdigest()

    args.output.parent.mkdir(parents=True, exist_ok=True)
    args.output.write_text(json.dumps(report, indent=2, sort_keys=True) + "\n", encoding="utf-8")
    performed = sum(
        1 for group in entries.values() for entry in group if entry["status"] == "passed"
    )
    print(
        json.dumps(
            {
                "schema": OBSERVATIONS_SCHEMA,
                "status": status,
                "performed": performed,
                "waived": sorted(waived),
                "required": len(MANUAL_JOURNEY) + len(ACCESSIBILITY),
                "blocked": blocked,
                "output": str(args.output),
            },
            indent=2,
        )
    )
    return 0 if status in {"passed", "passed_with_waivers"} else 1


if __name__ == "__main__":
    try:
        sys.exit(main())
    except ObservationError as error:
        print(f"error: {error}", file=sys.stderr)
        sys.exit(2)
