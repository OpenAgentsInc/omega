#!/usr/bin/env bash
# Install the git hooks that run `script/omega-preflight`.
#
# omega#113. Hooks are not tracked by git, so a hook that only exists on one
# machine enforces nothing anywhere else. This installs it, and is itself
# tracked, so the enforcement travels with the repository even though the hook
# cannot.
#
# One install covers every worktree. Worktrees share the `.git` directory of
# the repository they were created from, so `core.hooksPath` set here applies to
# every lane working out of it — which is the point, since the lanes are where
# the skipped checks kept coming from.
#
# Idempotent: running it twice is the same as running it once.

set -euo pipefail

root="$(git rev-parse --show-toplevel)"
cd "$root"

hooks="$root/.githooks"
mkdir -p "$hooks"

cat > "$hooks/pre-push" <<'HOOK'
#!/usr/bin/env bash
# Generated by script/omega-install-hooks. Edit script/omega-preflight instead.
set -euo pipefail
exec "$(git rev-parse --show-toplevel)/script/omega-preflight"
HOOK

chmod +x "$hooks/pre-push"
chmod +x "$root/script/omega-preflight"

# `core.hooksPath` rather than writing into `.git/hooks`, so the hook is a
# tracked, readable file rather than something that only exists as a side
# effect. A person can see what runs before their push.
git config core.hooksPath .githooks

printf 'installed: %s\n' "$hooks/pre-push"
printf 'core.hooksPath = %s\n' "$(git config core.hooksPath)"
printf '\nEvery worktree sharing this .git is now gated.\n'
