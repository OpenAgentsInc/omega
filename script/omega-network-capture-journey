#!/usr/bin/env python3
"""Collect and validate candidate-bound Omega process/network evidence."""

from __future__ import annotations

import argparse
import ctypes
import hashlib
import ipaddress
import json
import os
import re
import socket
import subprocess
import sys
import time
from datetime import datetime, timezone
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parent.parent
ALLOWLIST_PATH = ROOT / "crates/app_identity/fixtures/endpoint_allowlist.json"
SCHEMA = "openagents.omega.network-capture.v1"
COLLECTOR_VERSION = 2
EXPECTED_ROOT_EXECUTABLE = Path("/Applications/Omega.app/Contents/MacOS/omega")
EXPECTED_SIGNING_AUTHORITY = (
    "Developer ID Application: OpenAgents, Inc. (HQWSG26L43)"
)
EXPECTED_TEAM_ID = "HQWSG26L43"
LOCAL_HOSTS = {"localhost", "localhost.localdomain"}


class CaptureError(RuntimeError):
    pass


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def load_json(path: Path, description: str) -> dict[str, Any]:
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise CaptureError(f"cannot read {description} {path}: {error}") from error
    if not isinstance(value, dict):
        raise CaptureError(f"{description} must be a JSON object")
    return value


def validate_digest(value: str) -> str:
    if re.fullmatch(r"[0-9a-f]{64}", value) is None:
        raise CaptureError("candidate digest must be 64 lowercase hexadecimal characters")
    return value


def run(command: list[str]) -> subprocess.CompletedProcess[str]:
    return subprocess.run(command, capture_output=True, text=True, check=False)


def collector_binding() -> dict[str, Any]:
    collector = Path(__file__).resolve()
    return {
        "path": "script/omega-network-capture-journey",
        "version": COLLECTOR_VERSION,
        "sha256": sha256_file(collector),
    }


def process_executable_path(process_id: int) -> Path:
    try:
        libproc = ctypes.CDLL("/usr/lib/libproc.dylib", use_errno=True)
    except OSError as error:
        raise CaptureError("cannot load macOS process inspection authority") from error
    buffer = ctypes.create_string_buffer(4096)
    libproc.proc_pidpath.argtypes = [ctypes.c_int, ctypes.c_void_p, ctypes.c_uint32]
    libproc.proc_pidpath.restype = ctypes.c_int
    length = libproc.proc_pidpath(process_id, buffer, len(buffer))
    if length <= 0:
        raise CaptureError(f"cannot resolve executable path for PID {process_id}")
    try:
        raw_path = buffer.raw[:length].split(b"\0", 1)[0]
        return Path(os.fsdecode(raw_path)).resolve(strict=True)
    except OSError as error:
        raise CaptureError(f"cannot canonicalize executable path for PID {process_id}") from error


def process_start_identity(process_id: int) -> str:
    result = run(["ps", "-p", str(process_id), "-o", "lstart="])
    value = result.stdout.strip()
    if result.returncode != 0 or not value:
        raise CaptureError(f"cannot resolve start identity for PID {process_id}")
    return value


def codesign_binding(path: Path) -> dict[str, Any]:
    verification = run(
        ["/usr/bin/codesign", "--verify", "--deep", "--strict", "--verbose=4", str(path)]
    )
    if verification.returncode != 0:
        raise CaptureError("installed Omega root executable failed strict codesign verification")
    metadata = run(["/usr/bin/codesign", "-dv", "--verbose=4", str(path)])
    if metadata.returncode != 0:
        raise CaptureError("cannot read installed Omega root executable codesign metadata")
    detail = "\n".join((metadata.stdout, metadata.stderr))
    authorities = re.findall(r"(?m)^Authority=(.+)$", detail)
    team_match = re.search(r"(?m)^TeamIdentifier=(.+)$", detail)
    team_identifier = team_match.group(1) if team_match else None
    if not authorities or authorities[0] != EXPECTED_SIGNING_AUTHORITY:
        raise CaptureError("installed Omega root executable has unexpected signing authority")
    if team_identifier != EXPECTED_TEAM_ID:
        raise CaptureError("installed Omega root executable has unexpected signing team")
    return {
        "strict_verification": "passed",
        "verification_arguments": ["--verify", "--deep", "--strict", "--verbose=4"],
        "authorities": authorities,
        "team_identifier": team_identifier,
    }


def installed_binary_binding(path: Path = EXPECTED_ROOT_EXECUTABLE) -> dict[str, Any]:
    if path.is_symlink() or not path.is_file():
        raise CaptureError(f"installed Omega root executable is missing or unsafe: {path}")
    canonical = path.resolve(strict=True)
    if canonical != EXPECTED_ROOT_EXECUTABLE:
        raise CaptureError("installed Omega root executable canonical path is not exact")
    metadata = canonical.stat()
    binary_sha256 = sha256_file(canonical)
    signing = codesign_binding(canonical)
    confirmed_metadata = canonical.stat()
    identity_fields = ("st_dev", "st_ino", "st_size", "st_mtime_ns", "st_ctime_ns")
    if any(
        getattr(metadata, field) != getattr(confirmed_metadata, field)
        for field in identity_fields
    ):
        raise CaptureError("installed Omega root executable changed during inspection")
    return {
        "canonical_path": str(canonical),
        "sha256": binary_sha256,
        "device": metadata.st_dev,
        "inode": metadata.st_ino,
        "size": metadata.st_size,
        "mtime_ns": metadata.st_mtime_ns,
        "ctime_ns": metadata.st_ctime_ns,
        "codesign": signing,
    }


def root_process_observation(
    process_id: int, binary: dict[str, Any]
) -> dict[str, Any]:
    process_start = process_start_identity(process_id)
    executable = process_executable_path(process_id)
    metadata = executable.stat()
    stable_file_identity = (
        str(executable) == binary["canonical_path"]
        and metadata.st_dev == binary["device"]
        and metadata.st_ino == binary["inode"]
        and metadata.st_size == binary["size"]
        and metadata.st_mtime_ns == binary["mtime_ns"]
        and metadata.st_ctime_ns == binary["ctime_ns"]
    )
    executable_sha256 = (
        binary["sha256"] if stable_file_identity else sha256_file(executable)
    )
    if process_start_identity(process_id) != process_start:
        raise CaptureError(f"PID {process_id} was reused during identity inspection")
    return {
        "pid": process_id,
        "process_start": process_start,
        "executable_path": str(executable),
        "binary_sha256": executable_sha256,
        "device": metadata.st_dev,
        "inode": metadata.st_ino,
        "size": metadata.st_size,
        "mtime_ns": metadata.st_mtime_ns,
        "ctime_ns": metadata.st_ctime_ns,
        "matches_installed_binary": stable_file_identity
        and executable_sha256 == binary["sha256"],
    }


def process_table() -> dict[int, tuple[int, str]]:
    result = run(["ps", "-axo", "pid=,ppid=,comm="])
    if result.returncode != 0:
        raise CaptureError("cannot inspect the process table")
    processes: dict[int, tuple[int, str]] = {}
    for line in result.stdout.splitlines():
        fields = line.strip().split(maxsplit=2)
        if len(fields) != 3:
            continue
        try:
            process_id = int(fields[0])
            parent_id = int(fields[1])
        except ValueError:
            continue
        processes[process_id] = (parent_id, Path(fields[2]).name)
    return processes


def descendants(root_pid: int, table: dict[int, tuple[int, str]]) -> set[int]:
    selected = {root_pid}
    changed = True
    while changed:
        changed = False
        for process_id, (parent_id, _command) in table.items():
            if parent_id in selected and process_id not in selected:
                selected.add(process_id)
                changed = True
    return selected


def parse_remote_endpoint(value: str) -> tuple[str, int] | None:
    if "->" not in value:
        return None
    remote = value.split("->", 1)[1].split(" (", 1)[0]
    host, separator, port_text = remote.rpartition(":")
    if not separator or not port_text.isdigit():
        return None
    host = host.strip("[]").rstrip(".").lower()
    if not host:
        return None
    return host, int(port_text)


def collect_connections(process_id: int) -> tuple[list[tuple[str, int, str]], str | None]:
    result = run(
        ["/usr/sbin/lsof", "-a", "-p", str(process_id), "-i", "-P", "-F", "pPnT"]
    )
    if result.returncode not in (0, 1):
        return [], f"lsof_exit_{result.returncode}"
    protocol = "unknown"
    connections: list[tuple[str, int, str]] = []
    for line in result.stdout.splitlines():
        if line.startswith("P"):
            protocol = line[1:].lower()
        elif line.startswith("n"):
            endpoint = parse_remote_endpoint(line[1:])
            if endpoint is not None:
                connections.append((endpoint[0], endpoint[1], protocol))
    return connections, None


def host_matches(host: str, expected: str) -> bool:
    return host == expected or host.endswith(f".{expected}")


def resolve_approved_hosts(allowlist: dict[str, Any]) -> dict[str, list[str]]:
    resolutions: dict[str, list[str]] = {}
    for entry in allowlist.get("entries", []):
        host = entry.get("host")
        if entry.get("disposition") != "approved" or not isinstance(host, str):
            continue
        try:
            addresses = {
                result[4][0]
                for result in socket.getaddrinfo(host, None, type=socket.SOCK_STREAM)
            }
        except socket.gaierror:
            addresses = set()
        resolutions[host] = sorted(addresses)
    return resolutions


def classify_hosts(
    destinations: list[dict[str, Any]],
    allowlist: dict[str, Any],
    approved_host_resolutions: dict[str, list[str]],
) -> tuple[list[str], list[str], list[str]]:
    forbidden_hosts = allowlist.get("normal_start_forbidden_hosts", [])
    approved_hosts = {
        entry.get("host")
        for entry in allowlist.get("entries", [])
        if entry.get("disposition") == "approved"
    }
    forbidden: set[str] = set()
    unreviewed: set[str] = set()
    unresolved: set[str] = set()
    approved_addresses = {
        address
        for addresses in approved_host_resolutions.values()
        for address in addresses
    }
    for destination in destinations:
        host = destination["host"]
        if host in LOCAL_HOSTS:
            continue
        try:
            address = ipaddress.ip_address(host)
        except ValueError:
            pass
        else:
            if address.is_loopback or host in approved_addresses:
                continue
            unresolved.add(host)
            continue
        if any(host_matches(host, expected) for expected in forbidden_hosts):
            forbidden.add(host)
        elif not any(host_matches(host, expected) for expected in approved_hosts):
            unreviewed.add(host)
    return sorted(forbidden), sorted(unreviewed), sorted(unresolved)


def collect(arguments: argparse.Namespace) -> int:
    candidate_digest = validate_digest(arguments.candidate_digest)
    binary = installed_binary_binding()
    initial_root = root_process_observation(arguments.pid, binary)
    if not initial_root["matches_installed_binary"]:
        raise CaptureError(
            "root PID does not execute the exact installed Omega root executable"
        )
    allowlist = load_json(ALLOWLIST_PATH, "endpoint allowlist")
    approved_host_resolutions = resolve_approved_hosts(allowlist)
    started_at = datetime.now(timezone.utc)
    deadline = time.monotonic() + arguments.duration
    observed_processes: dict[int, dict[str, Any]] = {}
    observed_destinations: dict[tuple[int, str, int, str], dict[str, Any]] = {}
    root_identity_observations: list[dict[str, Any]] = []
    errors: set[str] = set()
    sample_index = 0

    while True:
        table = process_table()
        if arguments.pid not in table:
            errors.add("root_process_not_running")
        else:
            try:
                observation = root_process_observation(arguments.pid, binary)
            except CaptureError:
                errors.add("root_process_identity_unreadable")
            else:
                observation["sample_index"] = sample_index
                root_identity_observations.append(observation)
                if observation["process_start"] != initial_root["process_start"]:
                    errors.add("root_pid_reused")
                if observation["executable_path"] != initial_root["executable_path"]:
                    errors.add("root_executable_path_changed")
                if not observation["matches_installed_binary"]:
                    errors.add("root_executable_binding_changed")
        for process_id in descendants(arguments.pid, table):
            process = table.get(process_id)
            if process is None:
                continue
            parent_id, command = process
            observed_processes[process_id] = {
                "pid": process_id,
                "ppid": parent_id,
                "command_basename": command,
            }
            if process_id == arguments.pid and root_identity_observations:
                observed_processes[process_id].update(
                    {
                        "executable_path": root_identity_observations[-1][
                            "executable_path"
                        ],
                        "process_start": root_identity_observations[-1]["process_start"],
                    }
                )
            connections, error = collect_connections(process_id)
            if error is not None:
                errors.add(error)
            for host, port, protocol in connections:
                key = (process_id, host, port, protocol)
                observed_destinations[key] = {
                    "pid": process_id,
                    "host": host,
                    "port": port,
                    "protocol": protocol,
                }
        if time.monotonic() >= deadline:
            break
        sample_index += 1
        time.sleep(min(arguments.interval, max(0.0, deadline - time.monotonic())))

    processes = sorted(observed_processes.values(), key=lambda item: item["pid"])
    destinations = sorted(
        observed_destinations.values(),
        key=lambda item: (item["host"], item["port"], item["pid"]),
    )
    forbidden, unreviewed, unresolved = classify_hosts(
        destinations, allowlist, approved_host_resolutions
    )
    blocked_reasons = sorted(errors)
    if not processes:
        blocked_reasons.append("no_candidate_process_ancestry_captured")
    if arguments.journey == "online_first_codex" and not destinations:
        blocked_reasons.append("no_online_destination_captured")
    if forbidden:
        blocked_reasons.append("forbidden_host_observed")
    if unreviewed:
        blocked_reasons.append("unreviewed_host_observed")
    if unresolved:
        blocked_reasons.append("destination_hostname_unresolved")
    blocked_reasons = sorted(set(blocked_reasons))
    report = {
        "schema": SCHEMA,
        "candidate_digest": candidate_digest,
        "allowlist": {
            "path": "crates/app_identity/fixtures/endpoint_allowlist.json",
            "sha256": sha256_file(ALLOWLIST_PATH),
            "enforcement": allowlist.get("enforcement"),
        },
        "approved_host_resolutions": approved_host_resolutions,
        "journey": arguments.journey,
        "started_at": started_at.isoformat(),
        "completed_at": datetime.now(timezone.utc).isoformat(),
        "root_pid": arguments.pid,
        "root_process": initial_root,
        "root_identity_observations": root_identity_observations,
        "installed_binary": binary,
        "collector": {
            **collector_binding(),
            "duration_seconds": arguments.duration,
            "interval_seconds": arguments.interval,
            "process_source": "ps",
            "destination_source": "lsof_with_reverse_dns",
            "packet_payload_recorded": False,
        },
        "status": "passed" if not blocked_reasons else "blocked",
        "blocked_reasons": blocked_reasons,
        "processes": processes,
        "destinations": destinations,
        "forbidden_hosts_detected": forbidden,
        "unreviewed_hosts": unreviewed,
        "unresolved_destinations": unresolved,
    }
    arguments.output.parent.mkdir(parents=True, exist_ok=True)
    with arguments.output.open("x", encoding="utf-8") as handle:
        json.dump(report, handle, indent=2, sort_keys=True)
        handle.write("\n")
    print(f"wrote network capture: {arguments.output} ({report['status']})")
    return 0 if report["status"] == "passed" else 3


def validate_collector(report: dict[str, Any]) -> None:
    collector = report.get("collector")
    expected = collector_binding()
    if not isinstance(collector, dict):
        raise CaptureError("network capture has no collector binding")
    for field in ("path", "version", "sha256"):
        if collector.get(field) != expected[field]:
            raise CaptureError("network capture collector binding differs")


def validate_root_binding(
    report: dict[str, Any], *, verify_live_binary: bool
) -> None:
    binary = report.get("installed_binary")
    root = report.get("root_process")
    observations = report.get("root_identity_observations")
    if not isinstance(binary, dict) or not isinstance(root, dict):
        raise CaptureError("network capture has no installed root binary binding")
    if not isinstance(observations, list) or not observations:
        raise CaptureError("network capture has no root PID identity observations")
    if binary.get("canonical_path") != str(EXPECTED_ROOT_EXECUTABLE):
        raise CaptureError("network capture root executable canonical path differs")
    if re.fullmatch(r"[0-9a-f]{64}", str(binary.get("sha256", ""))) is None:
        raise CaptureError("network capture installed binary digest is invalid")
    for field in ("device", "inode", "size", "mtime_ns", "ctime_ns"):
        if not isinstance(binary.get(field), int) or binary[field] < 0:
            raise CaptureError("network capture installed binary identity is invalid")
    signing = binary.get("codesign")
    if not isinstance(signing, dict):
        raise CaptureError("network capture has no strict codesign binding")
    authorities = signing.get("authorities")
    if (
        signing.get("strict_verification") != "passed"
        or signing.get("verification_arguments")
        != ["--verify", "--deep", "--strict", "--verbose=4"]
        or not isinstance(authorities, list)
        or not authorities
        or authorities[0] != EXPECTED_SIGNING_AUTHORITY
        or signing.get("team_identifier") != EXPECTED_TEAM_ID
    ):
        raise CaptureError("network capture strict codesign binding is invalid")
    if verify_live_binary and installed_binary_binding() != binary:
        raise CaptureError("network capture no longer matches the installed root binary")

    root_pid = report.get("root_pid")
    if not isinstance(root_pid, int) or root_pid <= 0 or root.get("pid") != root_pid:
        raise CaptureError("network capture root PID binding is invalid")
    expected_identity = {
        "executable_path": binary["canonical_path"],
        "binary_sha256": binary["sha256"],
        "device": binary["device"],
        "inode": binary["inode"],
        "size": binary["size"],
        "mtime_ns": binary["mtime_ns"],
        "ctime_ns": binary["ctime_ns"],
    }
    process_start = root.get("process_start")
    if not isinstance(process_start, str) or not process_start:
        raise CaptureError("network capture root process start identity is invalid")
    for field, expected in expected_identity.items():
        if root.get(field) != expected:
            raise CaptureError("network capture root process path or binary differs")

    for index, observation in enumerate(observations):
        if not isinstance(observation, dict):
            raise CaptureError("network capture root PID observation is invalid")
        if observation.get("sample_index") != index:
            raise CaptureError("network capture root PID observations are incomplete")
        if observation.get("pid") != root_pid:
            raise CaptureError("network capture root PID changed")
        if observation.get("process_start") != process_start:
            raise CaptureError("network capture detected PID reuse")
        for field, expected in expected_identity.items():
            if observation.get(field) != expected:
                raise CaptureError("network capture detected root executable path mismatch")
        if observation.get("matches_installed_binary") is not True:
            raise CaptureError("network capture root executable did not match installation")

    processes = report.get("processes")
    if not isinstance(processes, list):
        raise CaptureError("network capture process ancestry is invalid")
    root_rows = [
        item
        for item in processes
        if isinstance(item, dict) and item.get("pid") == root_pid
    ]
    if len(root_rows) != 1:
        raise CaptureError("network capture process ancestry has no unique root PID")
    if (
        root_rows[0].get("executable_path") != binary["canonical_path"]
        or root_rows[0].get("process_start") != process_start
    ):
        raise CaptureError("network capture process ancestry root path differs")


def validate_report(path: Path, candidate_digest: str) -> dict[str, Any]:
    report = load_json(path, "network capture")
    if report.get("schema") != SCHEMA:
        raise CaptureError("network capture schema is not supported")
    if report.get("candidate_digest") != validate_digest(candidate_digest):
        raise CaptureError("network capture binds a different candidate")
    validate_collector(report)
    validate_root_binding(report, verify_live_binary=True)
    allowlist = load_json(ALLOWLIST_PATH, "endpoint allowlist")
    binding = report.get("allowlist", {})
    if binding.get("sha256") != sha256_file(ALLOWLIST_PATH):
        raise CaptureError("network capture binds a different endpoint allowlist")
    if binding.get("enforcement") != allowlist.get("enforcement"):
        raise CaptureError("network capture allowlist enforcement mode differs")
    approved_hosts = {
        entry.get("host")
        for entry in allowlist.get("entries", [])
        if entry.get("disposition") == "approved"
    }
    approved_host_resolutions = report.get("approved_host_resolutions")
    if not isinstance(approved_host_resolutions, dict):
        raise CaptureError("network capture has no approved-host DNS evidence")
    for host, addresses in approved_host_resolutions.items():
        if host not in approved_hosts or not isinstance(addresses, list):
            raise CaptureError("network capture has invalid approved-host DNS evidence")
        for address in addresses:
            try:
                parsed_address = ipaddress.ip_address(address)
            except ValueError as error:
                raise CaptureError(
                    "network capture has invalid approved-host DNS evidence"
                ) from error
            if not parsed_address.is_global:
                raise CaptureError(
                    "network capture approved-host DNS evidence is not global"
                )
    if report.get("journey") != "online_first_codex":
        raise CaptureError("installed proof requires the online first-Codex journey")
    if report.get("status") != "passed" or report.get("blocked_reasons") != []:
        raise CaptureError("network capture is blocked")
    if not isinstance(report.get("processes"), list) or not report["processes"]:
        raise CaptureError("network capture has no process ancestry")
    if not isinstance(report.get("destinations"), list) or not report["destinations"]:
        raise CaptureError("network capture has no observed destinations")
    forbidden, unreviewed, unresolved = classify_hosts(
        report["destinations"], allowlist, approved_host_resolutions
    )
    if (
        report.get("forbidden_hosts_detected") != forbidden
        or report.get("unreviewed_hosts") != unreviewed
        or report.get("unresolved_destinations") != unresolved
    ):
        raise CaptureError("network capture destination classification is inconsistent")
    for field in ("forbidden_hosts_detected", "unreviewed_hosts", "unresolved_destinations"):
        if report.get(field) != []:
            raise CaptureError(f"network capture {field} is not empty")
    return report


def validate_command(arguments: argparse.Namespace) -> int:
    validate_report(arguments.input, arguments.candidate_digest)
    print(f"network capture valid: {arguments.input}")
    return 0


def self_test(_arguments: argparse.Namespace) -> int:
    allowlist = load_json(ALLOWLIST_PATH, "endpoint allowlist")
    destinations = [
        {"host": "registry.npmjs.org"},
        {"host": "api.zed.dev"},
        {"host": "203.0.113.1"},
        {"host": "127.0.0.1"},
        {"host": "localhost"},
        {"host": "2001:db8::2"},
        {"host": "unexpected.example"},
    ]
    forbidden, unreviewed, unresolved = classify_hosts(
        destinations,
        allowlist,
        {"cdn.agentclientprotocol.com": ["2001:db8::2"]},
    )
    if forbidden != ["api.zed.dev"]:
        raise CaptureError("self-test did not identify the forbidden Zed host")
    if unreviewed != ["unexpected.example"]:
        raise CaptureError("self-test did not identify the unreviewed host")
    if unresolved != ["203.0.113.1"]:
        raise CaptureError("self-test did not block an unresolved IP destination")
    if parse_remote_endpoint("localhost:123->registry.npmjs.org:443 (ESTABLISHED)") != (
        "registry.npmjs.org",
        443,
    ):
        raise CaptureError("self-test endpoint parsing failed")

    binary = {
        "canonical_path": str(EXPECTED_ROOT_EXECUTABLE),
        "sha256": "a" * 64,
        "device": 1,
        "inode": 2,
        "size": 3,
        "mtime_ns": 4,
        "ctime_ns": 5,
        "codesign": {
            "strict_verification": "passed",
            "verification_arguments": [
                "--verify",
                "--deep",
                "--strict",
                "--verbose=4",
            ],
            "authorities": [EXPECTED_SIGNING_AUTHORITY],
            "team_identifier": EXPECTED_TEAM_ID,
        },
    }
    identity = {
        "pid": 42,
        "process_start": "Fri Jul 24 12:00:00 2026",
        "executable_path": str(EXPECTED_ROOT_EXECUTABLE),
        "binary_sha256": "a" * 64,
        "device": 1,
        "inode": 2,
        "size": 3,
        "mtime_ns": 4,
        "ctime_ns": 5,
        "matches_installed_binary": True,
    }
    report = {
        "root_pid": 42,
        "installed_binary": binary,
        "root_process": identity,
        "root_identity_observations": [{**identity, "sample_index": 0}],
        "processes": [
            {
                "pid": 42,
                "ppid": 1,
                "command_basename": "omega",
                "executable_path": str(EXPECTED_ROOT_EXECUTABLE),
                "process_start": identity["process_start"],
            }
        ],
        "collector": collector_binding(),
    }
    validate_collector(report)
    validate_root_binding(report, verify_live_binary=False)
    for field, tampered in (
        ("process_start", "Fri Jul 24 12:00:01 2026"),
        ("executable_path", "/tmp/fake-omega"),
    ):
        forged = json.loads(json.dumps(report))
        forged["root_identity_observations"][0][field] = tampered
        try:
            validate_root_binding(forged, verify_live_binary=False)
        except CaptureError:
            pass
        else:
            raise CaptureError(f"self-test accepted tampered root {field}")
    forged = json.loads(json.dumps(report))
    forged["installed_binary"]["codesign"]["team_identifier"] = "FAKE"
    try:
        validate_root_binding(forged, verify_live_binary=False)
    except CaptureError:
        pass
    else:
        raise CaptureError("self-test accepted tampered codesign team")
    forged = json.loads(json.dumps(report))
    forged["collector"]["sha256"] = "b" * 64
    try:
        validate_collector(forged)
    except CaptureError:
        pass
    else:
        raise CaptureError("self-test accepted tampered collector digest")
    print("Omega network capture self-test passed")
    return 0


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)
    capture = subparsers.add_parser("capture")
    capture.add_argument("--candidate-digest", required=True)
    capture.add_argument("--pid", type=int, required=True)
    capture.add_argument(
        "--journey", choices=("offline_first_start", "online_first_codex"), required=True
    )
    capture.add_argument("--duration", type=float, default=30.0)
    capture.add_argument("--interval", type=float, default=0.5)
    capture.add_argument("--output", type=Path, required=True)
    capture.set_defaults(handler=collect)
    validate = subparsers.add_parser("validate")
    validate.add_argument("--candidate-digest", required=True)
    validate.add_argument("--input", type=Path, required=True)
    validate.set_defaults(handler=validate_command)
    self_test_parser = subparsers.add_parser("self-test")
    self_test_parser.set_defaults(handler=self_test)
    return parser.parse_args()


def main() -> int:
    arguments = parse_arguments()
    if getattr(arguments, "duration", 1) <= 0 or getattr(arguments, "interval", 1) <= 0:
        print("error: duration and interval must be positive", file=sys.stderr)
        return 2
    try:
        return arguments.handler(arguments)
    except CaptureError as error:
        print(f"error: {error}", file=sys.stderr)
        return 2


if __name__ == "__main__":
    raise SystemExit(main())
