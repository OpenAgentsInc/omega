#!/usr/bin/env python3
"""Run the installed-candidate release gate against a packaged Omega RC.

OMEGA-DELTA-0185. The Episode 263 gap analysis (section 7, "Installed-candidate
release gate") defines the release matrix: source tests are necessary and
insufficient, so every release row must be observed on a PACKAGED candidate
launched from a CLEAN profile, and every row must leave preserved evidence.
This harness scripts that matrix. It never fabricates a row: a row it can
observe end-to-end is `automated-pass` or `automated-fail`, a row that needs a
human account, interactive provider auth, a second person, or a judgment call
is `owner-assisted-pending` with the exact instruction the owner must follow,
and a row the host refuses (missing screen-recording permission, missing
artifact) is `blocked` with the reason. "Nothing was found" and "nobody
looked" must never read the same.

The candidate is the DMG produced by `script/bundle-omega-rc` together with
its release record. Every receipt this harness writes is bound to the
package digest from that record so evidence cannot be re-attributed to a
different build.

The zero-refusal sweep is anchored to `omega_zero_base::refusal` in
`crates/omega_zero_base/src/omega_zero_base.rs`: every refused action logs one
sentence ("... is not part of Omega, which shows one agent thread and the
controls that operate it.") via `report_refusal` in
`crates/zed/src/omega_zero_base_ui.rs`. A flag-free launch that reaches the
composer without dispatching a single refused action must leave a log with
zero such sentences.

Usage:
    script/omega-release-gate [--dmg PATH] [--release-record PATH]
                              [--output-dir DIR] [--skip-launch]
                              [--launch-settle SECONDS] [--report PATH]
                              [--receipt-copy PATH] [--self-test]

Exit codes: 0 = no automated row failed (owner-assisted rows may remain
pending), 1 = at least one automated row failed, 2 = harness error,
3 = self-test failure.
"""

from __future__ import annotations

import argparse
import datetime
import hashlib
import json
import os
import plistlib
import re
import shutil
import signal
import subprocess
import sys
import tempfile
import time
from pathlib import Path

SCHEMA = "openagents.omega.release-gate.v1"

ROOT = Path(__file__).resolve().parent.parent

#: The one sentence a refused action logs, from `omega_zero_base::refusal`.
#: Pinned here as two fragments so the sweep survives reflowed whitespace in
#: the log line but still fails closed if the sentence shape changes: the
#: OMEGA-DELTA-0185 check in `crates/omega_deltas` holds this file and the
#: refusal source in agreement.
#: omega#161 removed the mode split, so the shipped refusal names the action
#: and the product with no mode vocabulary and no flag to point at.
REFUSAL_MARKERS = ("is not part of Omega", "controls that operate it")

#: OCR phrases that prove the flag-free launch reached the shipped composer
#: front door (OMEGA-DELTA-0184: the composer executor dropdown is the
#: new-conversation front door; its trigger face reads the active executor).
FRONT_DOOR_POSITIVE = ("Omega Agent",)

#: OCR phrases that prove the launch did NOT land on a chooser or onboarding
#: page (OMEGA-DELTA-0184 removed the interstitial chooser; onboarding renders
#: "Welcome to Omega").
FRONT_DOOR_NEGATIVE = ("Welcome to Omega",)

#: The tester-channel sidebar section label (omega#156).
TESTER_CHANNEL_LABEL = "Tester channels"

#: The version the footer Settings row renders (`v{AppVersion}` in
#: `crates/agent_ui/src/agent_panel.rs`); AppVersion for a preview-channel
#: bundle is `0.2.0+preview.<sha>`.
VERSION_FOOTER_PREFIX = "v0.2.0"

#: Neighbouring-app data roots the candidate must never touch
#: (gap analysis section 7, "Update safety").
NEIGHBOUR_DATA_ROOTS = (
    "~/Library/Application Support/Zed",
    "~/.config/zed",
    "~/Library/Application Support/OpenAgents",
    "~/Library/Application Support/OpenAgents Desktop",
)

