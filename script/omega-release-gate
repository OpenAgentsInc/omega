SCHEMA = "openagents.omega.release-gate.v2"
SARAH_LIVEKIT_EVIDENCE_SCHEMA = "openagents.omega.sarah-livekit-evidence.v1"

ROOT = Path(__file__).resolve().parent.parent

#: The one sentence a refused action logs, from `omega_zero_base::refusal`.
#: Pinned here as two fragments so the sweep survives reflowed whitespace in
#: the log line but still fails closed if the sentence shape changes: the
#: OMEGA-DELTA-0185 check in `crates/omega_deltas` holds this file and the
#: refusal source in agreement.
#: omega#161 removed the mode split, so the shipped refusal names the action
#: and the product with no mode vocabulary and no flag to point at.
REFUSAL_MARKERS = ("is not part of Omega", "controls that operate it")

#: OCR phrases that prove the flag-free launch reached the shipped composer
#: front door (OMEGA-DELTA-0184: the composer executor dropdown is the
#: new-conversation front door; its trigger face reads the active executor).
FRONT_DOOR_POSITIVE = ("Omega Agent",)

#: OCR phrases that prove the launch did NOT land on a chooser or onboarding
#: page (OMEGA-DELTA-0184 removed the interstitial chooser; onboarding renders
#: "Welcome to Omega").
FRONT_DOOR_NEGATIVE = ("Welcome to Omega",)

#: The tester-channel sidebar section label (omega#156).
TESTER_CHANNEL_LABEL = "Tester channels"

#: The version the footer Settings row renders (`footer_version_label` in
#: `crates/agent_ui/src/agent_panel.rs`). A release-candidate bundle renders
#: the version plus the stamped per-version build number — `v0.2.0 b28` for
#: rc28 — with no commit sha; the sha stays in the release record, About, and
#: `omega: copy system specs`. The build number is the RC number from
#: `script/bundle-omega-rc`, so the footer binds to the release record's
#: `version` field (`0.2.0-rc28`), which in turn binds to the source commit.
VERSION_FOOTER_PREFIX = "v0.2.0"

#: Neighbouring-app data roots the candidate must never touch
#: (gap analysis section 7, "Update safety").
NEIGHBOUR_DATA_ROOTS = (
    "~/Library/Application Support/Zed",
    "~/.config/zed",
    "~/Library/Application Support/OpenAgents",
    "~/Library/Application Support/OpenAgents Desktop",
)

