def validate_sarah_livekit_pass_facts(row_id: str, facts: dict) -> None:
    expected = SARAH_LIVEKIT_PASS_FACTS[row_id]
    missing = [name for name, value in expected.items() if facts.get(name) is not value]
    if row_id == "sarah-livekit-room":
        desktop_count = facts.get("authenticated_desktop_count")
        if (
            not isinstance(desktop_count, int)
            or isinstance(desktop_count, bool)
            or desktop_count < 3
        ):
            missing.append("authenticated_desktop_count>=3")
    if row_id == "sarah-livekit-failure":
        privacy_scope_count = facts.get("privacy_scope_count")
        if (
            not isinstance(privacy_scope_count, int)
            or isinstance(privacy_scope_count, bool)
            or privacy_scope_count < 8
        ):
            missing.append("privacy_scope_count>=8")
    if missing:
        raise ValueError(
            f"passing row {row_id} is missing observed facts: " + ", ".join(missing)
        )


def portable_path(path: Path) -> str:
    """Repo-relative rendering so a preserved receipt never leaks the
    invoking user's home directory."""
    try:
        return str(path.resolve().relative_to(ROOT))
    except ValueError:
        return str(path)


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1 << 20), b""):
            digest.update(chunk)
    return digest.hexdigest()


def canonical_digest(payload: dict) -> str:
    encoded = json.dumps(payload, sort_keys=True, separators=(",", ":")).encode()
    return hashlib.sha256(encoded).hexdigest()


def validate_sarah_livekit_evidence(
    payload: dict,
    package_sha256: str,
    source_revision: str,
    *,
    allow_unresolved_refs: bool = False,
) -> tuple[dict, dict[str, dict]]:
    if payload.get("schema") != SARAH_LIVEKIT_EVIDENCE_SCHEMA:
        raise ValueError(
            f"expected schema {SARAH_LIVEKIT_EVIDENCE_SCHEMA!r}, "
            f"got {payload.get('schema')!r}"
        )

    binding = payload.get("binding")
    if not isinstance(binding, dict):
        raise ValueError("binding must be an object")
    missing = [
        field
        for field in SARAH_LIVEKIT_BINDING_FIELDS
        if not isinstance(binding.get(field), str) or not binding[field].strip()
    ]
    if missing:
        raise ValueError("binding is missing: " + ", ".join(missing))
    if binding["omega_package_sha256"] != package_sha256:
        raise ValueError("binding omega_package_sha256 does not match the candidate")
    if binding["omega_source_revision"] != source_revision:
        raise ValueError("binding omega_source_revision does not match the candidate")
    for field in ("livekit_image_digest", "sarah_worker_image_digest"):
        if re.fullmatch(r"sha256:[0-9a-f]{64}", binding[field]) is None:
            raise ValueError(f"binding {field} must be an immutable sha256 digest")

    raw_rows = payload.get("rows")
    if not isinstance(raw_rows, list):
        raise ValueError("rows must be an array")
    rows: dict[str, dict] = {}
    allowed_statuses = {
        "automated-pass",
        "automated-fail",
        "owner-assisted-pass",
        "blocked",
        "inconclusive",
    }
    expected_ids = {spec["id"] for spec in SARAH_LIVEKIT_ROWS}
    for row in raw_rows:
        if not isinstance(row, dict) or not isinstance(row.get("id"), str):
            raise ValueError("every row must be an object with an id")
        row_id = row["id"]
        if row_id in rows:
            raise ValueError(f"duplicate row {row_id}")
        if row_id not in expected_ids:
            raise ValueError(f"unexpected row {row_id}")
        if row.get("status") not in allowed_statuses:
            raise ValueError(f"row {row_id} has unsupported status {row.get('status')!r}")
        facts = row.get("facts")
        if not isinstance(facts, dict):
            raise ValueError(f"row {row_id} facts must be an object")
        if row["status"] in {"automated-pass", "owner-assisted-pass"}:
            validate_sarah_livekit_pass_facts(row_id, facts)
        refs = row.get("evidence_refs")
        if not isinstance(refs, list) or not refs:
            raise ValueError(f"row {row_id} must preserve at least one evidence ref")
        for ref in refs:
            if not isinstance(ref, dict):
                raise ValueError(f"row {row_id} evidence refs must be objects")
            path = ref.get("path")
            if (
                not isinstance(path, str)
                or not path
                or Path(path).is_absolute()
                or ".." in Path(path).parts
            ):
                raise ValueError(f"row {row_id} evidence path must be repository-relative")
            if re.fullmatch(r"[0-9a-f]{64}", str(ref.get("sha256", ""))) is None:
                raise ValueError(f"row {row_id} evidence ref must carry a sha256")
            if ref.get("public_safe") is not True:
                raise ValueError(f"row {row_id} evidence ref is not marked public_safe")
            evidence_path = ROOT / path
            if not allow_unresolved_refs:
                if not evidence_path.is_file():
                    raise ValueError(
                        f"row {row_id} evidence does not exist in this repository"
                    )
                if sha256_file(evidence_path) != ref["sha256"]:
                    raise ValueError(f"row {row_id} evidence sha256 does not match")
                if evidence_path.stat().st_size > 1024 * 1024:
                    raise ValueError(f"row {row_id} evidence exceeds the public-safe size limit")
                try:
                    evidence_payload = json.loads(evidence_path.read_text())
                except (OSError, UnicodeDecodeError, json.JSONDecodeError) as error:
                    raise ValueError(
                        f"row {row_id} evidence must be a public-safe JSON receipt"
                    ) from error
                if (
                    not isinstance(evidence_payload, dict)
                    or evidence_payload.get("public_safe") is not True
                    or evidence_payload.get("row_id") != row_id
                    or evidence_payload.get("status") != row["status"]
                    or evidence_payload.get("binding") != binding
                ):
                    raise ValueError(
                        f"row {row_id} evidence receipt does not repeat its row and binding"
                    )
                evidence_serialized = json.dumps(evidence_payload, sort_keys=True)
                if re.search(
                    r"(?i)(bearer\s+[a-z0-9._-]+|sk-[a-z0-9_-]{12,}|"
                    r'"(?:access_token|participant_grant|ticket|raw_media|audio_bytes|'
                    r'private_transcript|private_context)"\s*:)',
                    evidence_serialized,
                ):
                    raise ValueError(f"row {row_id} evidence contains private material")
        rows[row_id] = row

    absent = sorted(expected_ids - rows.keys())
    if absent:
        raise ValueError("evidence is missing rows: " + ", ".join(absent))

    serialized = json.dumps(payload, sort_keys=True)
    if re.search(r"(?i)(bearer\s+[a-z0-9._-]+|sk-[a-z0-9_-]{12,})", serialized):
        raise ValueError("evidence contains a secret-shaped value")
    return binding, rows


def now_utc() -> str:
    return (
        datetime.datetime.now(datetime.timezone.utc)
        .replace(microsecond=0)
        .isoformat()
    )


def tree_digest(root: Path) -> str:
    """Order-stable digest of every path, size, and mtime under `root`.

    The same purpose as the installed-observation collector's untouched
    check: a rename is as loud as an edit. Size + nanosecond mtime stand in
    for content so a multi-gigabyte neighbouring profile (Zed extensions,
    language servers) does not take minutes to hash twice; any write updates
    the mtime and flips the digest. Unreadable entries feed a marker instead
    of aborting the whole row.
    """
    digest = hashlib.sha256()
    if not root.exists():
        digest.update(b"absent")
        return digest.hexdigest()
    entries = sorted(
        p for p in root.rglob("*") if p.is_file() and not p.is_symlink()
    )
    for entry in entries:
        digest.update(str(entry.relative_to(root)).encode())
        try:
            stat = entry.stat()
            digest.update(f"{stat.st_size}:{stat.st_mtime_ns}".encode())
        except OSError:
            digest.update(b"unreadable")
    return digest.hexdigest()


class Evidence:
    def __init__(self, root: Path) -> None:
        self.root = root
        root.mkdir(parents=True, exist_ok=True)

    def ref(self, path: Path) -> dict:
        return {"path": portable_path(path), "sha256": sha256_file(path)}

    def write_json(self, name: str, payload: dict) -> dict:
        path = self.root / name
        path.write_text(json.dumps(payload, indent=2, sort_keys=True) + "\n")
        return self.ref(path)

    def write_text(self, name: str, text: str) -> dict:
        path = self.root / name
        path.write_text(text)
        return self.ref(path)


def run(command: list[str], **kwargs) -> subprocess.CompletedProcess:
    return subprocess.run(command, capture_output=True, text=True, **kwargs)


def compile_swift_tool(source: Path, output_dir: Path) -> Path | None:
    binary = output_dir / source.stem
    if binary.exists():
        return binary
    result = run(["swiftc", "-O", "-o", str(binary), str(source)])
    if result.returncode != 0:
        return None
    return binary


def window_for_pid(window_list_tool: Path, pid: int) -> dict | None:
    result = run([str(window_list_tool)])
    if result.returncode != 0:
        return None
    try:
        windows = json.loads(result.stdout)
    except json.JSONDecodeError:
        return None
    def area(window: dict) -> float:
        bounds = window.get("bounds") or {}
        return float(bounds.get("Width", 0)) * float(bounds.get("Height", 0))

    candidates = [
        w
        for w in windows
        if w.get("pid") == pid and w.get("layer") == 0 and area(w) >= 10_000
    ]
    named = [w for w in candidates if w.get("name")]
    pool = named or candidates
    return max(pool, key=area) if pool else None


def ocr_lines(ocr_tool: Path, image: Path) -> list[dict] | None:
    result = run([str(ocr_tool), str(image)])
    if result.returncode != 0:
        return None
    try:
        return json.loads(result.stdout)["lines"]
    except (json.JSONDecodeError, KeyError):
        return None


def ocr_contains(lines: list[dict], phrase: str) -> bool:
    lowered = phrase.lower()
    return any(lowered in line.get("text", "").lower() for line in lines)


def sweep_refusals(log_text: str) -> int:
    return sum(
        1
        for line in log_text.splitlines()
        if all(marker in line for marker in REFUSAL_MARKERS)
    )


def self_test() -> int:
    """Prove the sweep can fire and the receipt binding refuses tampering."""
    fired = sweep_refusals(
        "2026-07-30T00:00:00Z INFO some::module: workspace::NewFile is not "
        "part of Omega, which shows one agent thread and the controls that "
        "operate it.\n"
    )
    if fired != 1:
        print("self-test: the refusal sweep cannot fire", file=sys.stderr)
        return 3
    if sweep_refusals("ordinary log line about the editor\n") != 0:
        print("self-test: the refusal sweep fires on ordinary text", file=sys.stderr)
        return 3
    receipt = {"schema": SCHEMA, "rows": [{"id": "x", "status": "automated-pass"}]}
    bound = dict(receipt, evidence_sha256=canonical_digest(receipt))
    tampered = json.loads(json.dumps(bound))
    tampered["rows"][0]["status"] = "automated-fail"
    unbound = {k: v for k, v in tampered.items() if k != "evidence_sha256"}
    if canonical_digest(unbound) == tampered["evidence_sha256"]:
        print("self-test: tampering was not detected", file=sys.stderr)
        return 3

    fixture_path = (
        ROOT / "script/fixtures/omega-release-gate/sarah-livekit-evidence-valid.json"
    )
    schema_path = (
        ROOT
        / "script/fixtures/omega-release-gate/sarah-livekit-evidence.schema.json"
    )
    try:
        schema = json.loads(schema_path.read_text())
        fixture = json.loads(fixture_path.read_text())
        binding, livekit_rows = validate_sarah_livekit_evidence(
            fixture, "a" * 64, "b" * 40, allow_unresolved_refs=True
        )
    except (OSError, json.JSONDecodeError, ValueError) as error:
        print(f"self-test: valid LiveKit evidence fixture failed: {error}", file=sys.stderr)
        return 3
    if schema.get("title") != "Omega Sarah LiveKit installed-candidate evidence":
        print("self-test: LiveKit evidence schema title changed", file=sys.stderr)
        return 3
    if len(livekit_rows) != len(SARAH_LIVEKIT_ROWS):
        print("self-test: valid LiveKit fixture did not cover every row", file=sys.stderr)
        return 3
    (ROOT / "target").mkdir(exist_ok=True)
    with tempfile.TemporaryDirectory(
        prefix="omega-livekit-evidence-self-test-", dir=ROOT / "target"
    ) as temporary_directory:
        resolved_fixture = json.loads(json.dumps(fixture))
        receipt_paths = []
        for row in resolved_fixture["rows"]:
            receipt_path = Path(temporary_directory) / f"{row['id']}.json"
            receipt_path.write_text(
                json.dumps(
                    {
                        "schema": "openagents.omega.sarah-livekit-row-evidence.v1",
                        "public_safe": True,
                        "row_id": row["id"],
                        "status": row["status"],
                        "binding": resolved_fixture["binding"],
                        "facts": row["facts"],
                    },
                    sort_keys=True,
                )
                + "\n"
            )
            receipt_paths.append(receipt_path)
            row["evidence_refs"] = [
                {
                    "path": portable_path(receipt_path),
                    "sha256": sha256_file(receipt_path),
                    "public_safe": True,
                }
            ]
        try:
            validate_sarah_livekit_evidence(
                resolved_fixture, "a" * 64, "b" * 40
            )
        except ValueError as error:
            print(
                f"self-test: bound public-safe LiveKit receipts failed: {error}",
                file=sys.stderr,
            )
            return 3
        private_receipt = json.loads(receipt_paths[0].read_text())
        private_receipt["access_token"] = "secret-value"
        receipt_paths[0].write_text(json.dumps(private_receipt) + "\n")
        resolved_fixture["rows"][0]["evidence_refs"][0]["sha256"] = sha256_file(
            receipt_paths[0]
        )
        try:
            validate_sarah_livekit_evidence(
                resolved_fixture, "a" * 64, "b" * 40
            )
        except ValueError:
            pass
        else:
            print(
                "self-test: private material in a bound LiveKit receipt was accepted",
                file=sys.stderr,
            )
            return 3
    tampered_fixture = json.loads(json.dumps(fixture))
    tampered_fixture["binding"]["omega_package_sha256"] = "c" * 64
    try:
        validate_sarah_livekit_evidence(tampered_fixture, "a" * 64, "b" * 40)
    except ValueError:
        pass
    else:
        print("self-test: candidate-mismatched LiveKit evidence was accepted", file=sys.stderr)
        return 3
    incomplete_fixture = json.loads(json.dumps(fixture))
    incomplete_fixture["rows"][0]["facts"].pop("voice_turn_completed")
    try:
        validate_sarah_livekit_evidence(
            incomplete_fixture, "a" * 64, "b" * 40, allow_unresolved_refs=True
        )
    except ValueError:
        pass
    else:
        print(
            "self-test: passing LiveKit evidence without required facts was accepted",
            file=sys.stderr,
        )
        return 3
    if canonical_digest(binding) == "":
        print("self-test: LiveKit binding digest is empty", file=sys.stderr)
        return 3
    print(
        "release-gate self-test passed: sweep fires, tampering and "
        "candidate-mismatched and incomplete passing LiveKit evidence are refused."
    )
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    parser.add_argument(
        "--dmg",
        type=Path,
        default=ROOT / "target/omega-rc/Omega-v0.2.0-rc28-macos-arm64.dmg",
    )
    parser.add_argument(
        "--release-record",
        type=Path,
        default=ROOT / "target/omega-rc/omega-v0.2.0-rc28-macos-arm64.release.json",
    )
    parser.add_argument(
        "--output-dir", type=Path, default=ROOT / "target/omega-release-gate"
    )
    parser.add_argument("--skip-launch", action="store_true")
    parser.add_argument("--launch-settle", type=float, default=20.0)
    parser.add_argument("--report", type=Path, default=None)
    parser.add_argument("--receipt-copy", type=Path, default=None)
    parser.add_argument(
        "--sarah-livekit-evidence",
        type=Path,
        default=None,
        help=(
            "public-safe evidence manifest binding all six Sarah LiveKit rows "
            "to this exact package and infrastructure"
        ),
    )
    parser.add_argument("--self-test", action="store_true")
    args = parser.parse_args()

    if args.self_test:
        return self_test()

    output_dir: Path = args.output_dir
    output_dir.mkdir(parents=True, exist_ok=True)
    evidence = Evidence(output_dir / "evidence")
    rows: list[dict] = []

    def add_row(
        row_id: str,
        title: str,
        status: str,
        facts: dict,
        refs: list[dict],
        issues: list[str] | None = None,
        owner_instruction: str | None = None,
    ) -> None:
        record = {
            "id": row_id,
            "title": title,
            "status": status,
            "observed_at": now_utc(),
            "facts": facts,
            "evidence_refs": refs,
            "issues": issues or [],
        }
        if owner_instruction:
            record["owner_instruction"] = owner_instruction
        rows.append(record)

    # --- Row: package integrity -------------------------------------------
    if not args.dmg.is_file() or not args.release_record.is_file():
        print(
            f"error: candidate artifacts missing: {args.dmg} / {args.release_record}",
            file=sys.stderr,
        )
        return 2
    record = json.loads(args.release_record.read_text())
    package_digest = sha256_file(args.dmg)
    recorded_digest = record.get("digests", {}).get("package_sha256")
    commit = record.get("source", {}).get("commit", "")
    livekit_binding: dict | None = None
    livekit_evidence_rows: dict[str, dict] | None = None
    livekit_evidence_error: str | None = None
    livekit_evidence_ref: dict | None = None
    if args.sarah_livekit_evidence is None:
        livekit_evidence_error = (
            "no --sarah-livekit-evidence manifest was supplied for this candidate"
        )
    else:
        try:
            livekit_payload = json.loads(args.sarah_livekit_evidence.read_text())
            livekit_binding, livekit_evidence_rows = validate_sarah_livekit_evidence(
                livekit_payload, package_digest, commit
            )
            livekit_evidence_ref = {
                "path": portable_path(args.sarah_livekit_evidence),
                "sha256": sha256_file(args.sarah_livekit_evidence),
                "public_safe": True,
            }
        except (OSError, json.JSONDecodeError, ValueError) as error:
            livekit_evidence_error = str(error)
    integrity_facts = {
        "artifact": args.dmg.name,
        "package_sha256": package_digest,
        "release_record_package_sha256": recorded_digest,
        "digest_match": package_digest == recorded_digest,
        "release_record_version": record.get("version"),
        "release_record_channel": record.get("channel"),
        "source_commit": commit,
        "notarization": record.get("notarization"),
    }

    staged_root = output_dir / "installed"
    if staged_root.exists():
        shutil.rmtree(staged_root)
    staged_root.mkdir(parents=True)
    mount_point = Path(tempfile.mkdtemp(prefix="omega-gate-mnt-"))
    attach = run(
        [
            "hdiutil",
            "attach",
            str(args.dmg),
            "-readonly",
            "-nobrowse",
            "-noautoopen",
            "-mountpoint",
            str(mount_point),
        ]
    )
    if attach.returncode != 0:
        print(f"error: cannot mount the DMG: {attach.stderr}", file=sys.stderr)
        return 2
    app_path = staged_root / "Omega.app"
    try:
        source_app = mount_point / "Omega.app"
        if not source_app.exists():
            print("error: the DMG does not contain Omega.app", file=sys.stderr)
            return 2
        copy = run(["ditto", str(source_app), str(app_path)])
        if copy.returncode != 0:
            print(f"error: cannot stage Omega.app: {copy.stderr}", file=sys.stderr)
            return 2
    finally:
        run(["hdiutil", "detach", str(mount_point), "-force"])
        shutil.rmtree(mount_point, ignore_errors=True)

    codesign = run(
        ["codesign", "--verify", "--deep", "--strict", "--verbose=2", str(app_path)]
    )
    integrity_facts["codesign_verify"] = codesign.returncode == 0
    integrity_facts["codesign_output"] = (
        (codesign.stderr or codesign.stdout).strip().replace(str(ROOT) + "/", "")
    )
    binary_path = app_path / "Contents/MacOS/omega"
    binary_digest = sha256_file(binary_path)
    recorded_binary = record.get("digests", {}).get("omega_binary_sha256")
    integrity_facts["omega_binary_sha256"] = binary_digest
    integrity_facts["binary_digest_match"] = binary_digest == recorded_binary
    integrity_ok = (
        integrity_facts["digest_match"]
        and integrity_facts["codesign_verify"]
        and integrity_facts["binary_digest_match"]
    )
    refs = [evidence.write_json("package-integrity.json", integrity_facts)]
    add_row(
        "package-integrity",
        "Packaged candidate matches its release record and signature verifies",
        "automated-pass" if integrity_ok else "automated-fail",
        integrity_facts,
        refs,
    )

    # --- Row: control-crawl (source hermetic crawl, OMEGA-DELTA-0187) ------
    # Drawn-implies-working protocol + synthetic proving scene + mutation
    # proof. Full GPUI semantic-tree expansion is registered as
    # pending-expansion in docs/omega/control-crawl-registry.json; this row
    # already fails a broken protocol without needing a window.
    crawl_env = os.environ.copy()
    crawl = run(
        [
            "cargo",
            "test",
            "-p",
            "omega_control_crawl",
            "--lib",
        ],
        cwd=str(ROOT),
        env=crawl_env,
    )
    crawl_output = ((crawl.stdout or "") + (crawl.stderr or "")).strip()
    crawl_facts = {
        "command": "cargo test -p omega_control_crawl --lib",
        "exit_code": crawl.returncode,
        "output_tail": "\n".join(crawl_output.splitlines()[-80:]),
        "protocol": "OMEGA-DELTA-0187",
        "coverage_note": (
            "Synthetic proving scene + registry + copy lint + mutation proof. "
            "Hermetic GPUI scene expansion is pending-expansion in the crawl registry."
        ),
    }
    crawl_refs = [evidence.write_text("control-crawl.log", crawl_output + "\n")]
    add_row(
        "control-crawl",
        "Control-crawl: hermetic drawn-implies-working crawl (pointer+keyboard, "
        "menu entries, Escape dismissal, mutation proof)",
        "automated-pass" if crawl.returncode == 0 else "automated-fail",
        crawl_facts,
        crawl_refs,
        issues=["omega#160"],
    )

    # --- Row: tester-channel two-account simulation (omega#156) -----------
    # Two isolated custody roots exercise the production signing boundary,
    # exact signed-event publication, two relay readers, reporting,
    # moderation, forced disconnect, and retained history. The rendered
    # relay-fallback GPUI test remains a separate visual assertion.
    channel_proof = run(
        [str(ROOT / "script/omega-tester-channel-proof")],
        cwd=str(ROOT),
    )
    channel_proof_output = (
        (channel_proof.stdout or "") + (channel_proof.stderr or "")
    ).strip()
    channel_proof_facts = {
        "command": "script/omega-tester-channel-proof",
        "exit_code": channel_proof.returncode,
        "output_tail": "\n".join(channel_proof_output.splitlines()[-80:]),
        "mode": "hermetic-two-account-simulation",
        "coverage": [
            "two isolated Omega identity custody roots",
            "signed kind-9 publication and second-account reception",
            "signed kind-1984 report with exact event and author targets",
            "signed moderation event admission",
            "forced relay disconnect and verified-history retention",
        ],
    }
    channel_proof_refs = [
        evidence.write_text(
            "tester-channel-two-account.log",
            channel_proof_output + "\n",
        )
    ]
    add_row(
        "channels-send-receive",
        "Tester channel two-account send, receive, report, moderation, and outage simulation",
        (
            "automated-pass"
            if channel_proof.returncode == 0
            else "automated-fail"
        ),
        channel_proof_facts,
        channel_proof_refs,
        issues=["omega#156"],
    )

    # --- Row: version truth ------------------------------------------------
    with (app_path / "Contents/Info.plist").open("rb") as handle:
        info = plistlib.load(handle)
    short_sha = commit[:7] if commit else ""
    # The footer renders version + per-version build number (`v0.2.0 b28`).
    # The build number is the RC number inside the release record's `version`
    # field, so matching it binds the rendered footer to the record, and the
    # record's `source.commit` binds the pair to the exact source commit.
    rc_match = re.search(r"-rc(\d+)$", str(record.get("version") or ""))
    expected_footer = (
        f"{VERSION_FOOTER_PREFIX} b{rc_match.group(1)}" if rc_match else None
    )
    version_facts = {
        "expected_footer": expected_footer,
        "bundle_identifier": info.get("CFBundleIdentifier"),
        "bundle_short_version": info.get("CFBundleShortVersionString"),
        "expected_bundle_identifier": record.get("bundle_identifier"),
        "expected_bundle_version": record.get("bundle_version"),
        "source_commit_short": short_sha,
    }
    version_ok = version_facts["bundle_identifier"] == record.get(
        "bundle_identifier"
    ) and version_facts["bundle_short_version"] == record.get("bundle_version")
    version_facts["static_agreement"] = version_ok
    version_refs = [evidence.write_json("version-truth.json", version_facts)]

    # --- Launch rows --------------------------------------------------------
    launch_status = "blocked"
    launch_facts: dict = {}
    launch_refs: list[dict] = []
    sweep_status = "blocked"
    sweep_facts: dict = {}
    sweep_refs: list[dict] = []
    tester_status = "blocked"
    tester_facts: dict = {}
    tester_refs: list[dict] = []
    footer_seen = None
    menu_facts: dict = {}
    menu_refs: list[dict] = []
    safety_status = "blocked"
    safety_facts: dict = {}
    safety_refs: list[dict] = []

    if args.skip_launch:
        reason = "launch rows skipped by --skip-launch"
        launch_facts = sweep_facts = tester_facts = safety_facts = {
            "blocked_reason": reason
        }
        menu_facts = {"blocked_reason": reason}
    else:
        neighbour_before = {
            root: tree_digest(Path(root).expanduser()) for root in NEIGHBOUR_DATA_ROOTS
        }
        profile = output_dir / "profile"
        if profile.exists():
            shutil.rmtree(profile)
        profile.mkdir(parents=True)
        window_tool = compile_swift_tool(
            ROOT / "script/omega-window-list.swift", output_dir
        )
        ocr_tool = compile_swift_tool(ROOT / "script/omega-window-ocr.swift", output_dir)

        # Launch from a neutral empty working directory OUTSIDE the
        # repository: a fresh install's first window must not inherit the
        # harness's repository (or any parent git repo) as its thread folder.
        launch_cwd = Path(tempfile.mkdtemp(prefix="omega-gate-cwd-"))
        process = subprocess.Popen(
            [str(binary_path), "--user-data-dir", str(profile)],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
            cwd=str(launch_cwd),
        )
        window = None
        deadline = time.monotonic() + args.launch_settle + 40.0
        try:
            while time.monotonic() < deadline:
                if process.poll() is not None:
                    break
                if window_tool is not None:
                    window = window_for_pid(window_tool, process.pid)
                    if window is not None:
                        break
                time.sleep(1.0)
            if process.poll() is not None:
                launch_facts = {
                    "blocked_reason": (
                        f"the candidate exited during launch (code {process.returncode})"
                    )
                }
                launch_status = "automated-fail"
            else:
                time.sleep(args.launch_settle)
                launch_facts = {
                    "pid": process.pid,
                    "window": window,
                    "window_tool_available": window_tool is not None,
                }
                screenshot = evidence.root / "flag-free-launch.png"
                captured = False
                if window is not None:
                    capture = run(
                        [
                            "screencapture",
                            "-x",
                            "-o",
                            "-l",
                            str(window["id"]),
                            str(screenshot),
                        ]
                    )
                    captured = capture.returncode == 0 and screenshot.is_file()
                launch_facts["screenshot_captured"] = captured
                lines = None
                if captured and ocr_tool is not None:
                    lines = ocr_lines(ocr_tool, screenshot)
                if captured:
                    launch_refs.append(evidence.ref(screenshot))
                if lines is not None:
                    launch_refs.append(
                        evidence.write_json("flag-free-launch-ocr.json", {"lines": lines})
                    )
                    positives = {
                        phrase: ocr_contains(lines, phrase)
                        for phrase in FRONT_DOOR_POSITIVE
                    }
                    negatives = {
                        phrase: ocr_contains(lines, phrase)
                        for phrase in FRONT_DOOR_NEGATIVE
                    }
                    launch_facts["front_door_markers_seen"] = positives
                    launch_facts["forbidden_markers_seen"] = negatives
                    front_door_ok = all(positives.values()) and not any(
                        negatives.values()
                    )
                    launch_status = (
                        "automated-pass" if front_door_ok else "automated-fail"
                    )
                    tester_seen = ocr_contains(lines, TESTER_CHANNEL_LABEL)
                    tester_facts = {"tester_channel_label_seen": tester_seen}
                    tester_status = "automated-pass" if tester_seen else "automated-fail"
                    tester_refs = list(launch_refs)
                    # Vision reads the digit 0 as the letter O in this font;
                    # normalise before matching so the footer version row does
                    # not fail on an OCR confusion. The build number must match
                    # too, so the footer proves WHICH cut of the version
                    # rendered; the release record binds that build number to
                    # the exact source commit. OCR is also unreliable about
                    # spaces, so the comparison is space-insensitive.
                    normalised = [
                        line.get("text", "").replace("O", "0").replace(" ", "")
                        for line in lines
                    ]
                    footer_needle = (expected_footer or VERSION_FOOTER_PREFIX).replace(
                        " ", ""
                    )
                    footer_seen = any(footer_needle in text for text in normalised)
                elif captured:
                    launch_facts["blocked_reason"] = (
                        "the window was captured but OCR is unavailable "
                        "(swiftc or Vision failed)"
                    )
                    tester_facts = dict(launch_facts)
                else:
                    launch_facts["blocked_reason"] = (
                        "no window could be captured; grant the invoking "
                        "terminal Screen Recording permission and rerun"
                    )
                    tester_facts = dict(launch_facts)

                # Menu capture is evidence-only; the judgment stays with the
                # owner row. GPUI publishes no accessibility tree, so a
                # failure here is expected on hosts without the permission.
                menu_dump = run(
                    [
                        "osascript",
                        "-e",
                        'tell application "System Events" to get name of every '
                        f"menu bar item of menu bar 1 of (first process whose "
                        f"unix id is {process.pid})",
                    ]
                )
                if menu_dump.returncode == 0:
                    menu_facts = {"menu_bar_items": menu_dump.stdout.strip()}
                    menu_refs = [
                        evidence.write_text("menu-bar-items.txt", menu_dump.stdout)
                    ]
                else:
                    menu_facts = {
                        "blocked_reason": (
                            "the menu bar could not be read: "
                            + (menu_dump.stderr or "").strip()
                        )
                    }
        finally:
            if process.poll() is None:
                process.send_signal(signal.SIGTERM)
                try:
                    process.wait(timeout=15)
                except subprocess.TimeoutExpired:
                    process.kill()
                    process.wait(timeout=15)

        # Zero-refusal sweep over the drawn surface.
        log_path = profile / "logs/omega-rc.log"
        if log_path.is_file():
            log_text = log_path.read_text(errors="replace")
            refusals = sweep_refusals(log_text)
            sweep_facts = {
                "log_path": portable_path(log_path),
                "log_bytes": log_path.stat().st_size,
                "refusal_sentences": refusals,
                "markers": list(REFUSAL_MARKERS),
            }
            sweep_refs = [evidence.write_text("launch-log.log", log_text)]
            sweep_status = "automated-pass" if refusals == 0 else "automated-fail"
        else:
            sweep_facts = {
                "blocked_reason": f"the candidate wrote no log at {portable_path(log_path)}"
            }
            sweep_status = "automated-fail" if launch_status != "blocked" else "blocked"

        neighbour_after = {
            root: tree_digest(Path(root).expanduser()) for root in NEIGHBOUR_DATA_ROOTS
        }
        untouched = {
            root: neighbour_before[root] == neighbour_after[root]
            for root in NEIGHBOUR_DATA_ROOTS
        }
        safety_facts = {
            "neighbour_roots_untouched": untouched,
            "before": neighbour_before,
            "after": neighbour_after,
            "profile_dir": portable_path(profile),
        }
        safety_refs = [evidence.write_json("update-safety.json", safety_facts)]
        safety_status = (
            "automated-pass" if all(untouched.values()) else "automated-fail"
        )

    add_row(
        "flag-free-launch",
        "Flag-free clean-profile launch reaches the composer front door",
        launch_status,
        launch_facts,
        launch_refs,
        issues=["omega#151"],
    )
    version_facts["footer_version_seen_in_ocr"] = footer_seen
    version_status = (
        "automated-pass"
        if version_ok and footer_seen
        else ("automated-fail" if not version_ok else "owner-assisted-pending")
    )
    add_row(
        "version-truth",
        "Installed identity and rendered footer agree with the release record",
        version_status,
        version_facts,
        version_refs,
        owner_instruction=(
            None
            if version_status != "owner-assisted-pending"
            else (
                "Static identity agrees but the footer version was not "
                "OCR-visible; open Settings in the sidebar footer and confirm "
                f"it reads {expected_footer or VERSION_FOOTER_PREFIX + ' b<N>'}."
            )
        ),
    )
    add_row(
        "zero-refusal-log-sweep",
        "The flag-free journey logs zero zero-base refusal sentences",
        sweep_status,
        sweep_facts,
        sweep_refs,
    )
    add_row(
        "tester-channel-destination",
        "The tester-channel destination is visible on first launch",
        tester_status,
        tester_facts,
        tester_refs,
        issues=["omega#156"],
    )
    add_row(
        "update-safety-staged",
        "A staged clean-profile run leaves Zed and OpenAgents Desktop data untouched",
        safety_status,
        safety_facts,
        safety_refs,
    )
    menu_owner = next(r for r in OWNER_ASSISTED_ROWS if r["id"] == "menu-honesty")
    add_row(
        "menu-honesty",
        menu_owner["title"],
        "owner-assisted-pending",
        menu_facts,
        menu_refs,
        issues=menu_owner["issues"],
        owner_instruction=menu_owner["owner_instruction"],
    )

    for spec in OWNER_ASSISTED_ROWS:
        if spec["id"] == "menu-honesty":
            continue
        add_row(
            spec["id"],
            spec["title"],
            "owner-assisted-pending",
            {},
            [],
            issues=spec["issues"],
            owner_instruction=spec["owner_instruction"],
        )

    for spec in SARAH_LIVEKIT_ROWS:
        evidence_row = (
            livekit_evidence_rows.get(spec["id"])
            if livekit_evidence_rows is not None
            else None
        )
        if evidence_row is None or livekit_binding is None:
            add_row(
                spec["id"],
                spec["title"],
                "blocked",
                {
                    "blocked_reason": livekit_evidence_error
                    or "the Sarah LiveKit evidence row is absent",
                },
                [],
                issues=spec["issues"],
                owner_instruction=spec["owner_instruction"],
            )
            continue
        facts = dict(evidence_row["facts"])
        facts["candidate_and_infrastructure_binding"] = livekit_binding
        facts["binding_sha256"] = canonical_digest(livekit_binding)
        refs = list(evidence_row["evidence_refs"])
        if livekit_evidence_ref is not None:
            refs.append(livekit_evidence_ref)
        add_row(
            spec["id"],
            spec["title"],
            evidence_row["status"],
            facts,
            refs,
            issues=spec["issues"],
            owner_instruction=(
                spec["owner_instruction"]
                if evidence_row["status"] in {"blocked", "inconclusive"}
                else None
            ),
        )

    automated_failures = [r["id"] for r in rows if r["status"] == "automated-fail"]
    pending = [r["id"] for r in rows if r["status"] == "owner-assisted-pending"]
    blocked = [
        r["id"] for r in rows if r["status"] in {"blocked", "inconclusive"}
    ]
    status = (
        "failed"
        if automated_failures
        else ("automated_green_pending_owner" if pending or blocked else "passed")
    )
    receipt = {
        "schema": SCHEMA,
        "generated_at": now_utc(),
        "candidate": {
            "artifact_name": args.dmg.name,
            "package_sha256": package_digest,
            "source_commit": commit,
            "version": record.get("version"),
            "channel": record.get("channel"),
        },
        "sarah_livekit_binding": livekit_binding,
        "harness_commit": run(
            ["git", "-C", str(ROOT), "rev-parse", "HEAD"]
        ).stdout.strip(),
        "status": status,
        "automated_failures": automated_failures,
        "owner_assisted_pending": pending,
        "blocked": blocked,
        "rows": rows,
    }
    receipt["evidence_sha256"] = canonical_digest(receipt)
    receipt_path = output_dir / "release-gate.json"
    receipt_path.write_text(json.dumps(receipt, indent=2, sort_keys=True) + "\n")
    if args.receipt_copy is not None:
        args.receipt_copy.parent.mkdir(parents=True, exist_ok=True)
        shutil.copyfile(receipt_path, args.receipt_copy)

    if args.report is not None:
        write_report(args.report, receipt)

    print(f"release gate: {status}")
    for row in rows:
        print(f"  {row['status']:<24} {row['id']}")
    print(f"receipt: {receipt_path}")
    return 1 if automated_failures else 0


def write_report(path: Path, receipt: dict) -> None:
    lines = [
        "# Omega installed-candidate release gate",
        "",
        "This report is generated by `script/omega-release-gate` "
        "(OMEGA-DELTA-0185) from a packaged candidate produced by "
        "`script/bundle-omega-rc` and launched from a clean profile. Row "
        "meanings: `automated-pass`/`automated-fail` were observed end-to-end "
        "by the harness; `owner-assisted-pass` records a preserved human "
        "observation; `owner-assisted-pending` rows require a human "
        "account, interactive provider auth, a second person, or a judgment "
        "call, and carry the exact instruction; `blocked` and `inconclusive` "
        "rows name what prevented a verdict. No row is ever fabricated.",
        "",
        f"- Generated: {receipt['generated_at']}",
        f"- Candidate: `{receipt['candidate']['artifact_name']}` "
        f"(version {receipt['candidate']['version']}, "
        f"channel {receipt['candidate']['channel']})",
        f"- Package SHA-256: `{receipt['candidate']['package_sha256']}`",
        f"- Source commit: `{receipt['candidate']['source_commit']}`",
        f"- Harness commit: `{receipt['harness_commit']}`",
        f"- Overall status: **{receipt['status']}**",
        f"- Receipt digest: `{receipt['evidence_sha256']}`",
    ]
    if receipt.get("sarah_livekit_binding") is not None:
        lines.extend(
            [
                "- Sarah LiveKit binding SHA-256: "
                f"`{canonical_digest(receipt['sarah_livekit_binding'])}`",
                "",
            ]
        )
    else:
        lines.append("")
    lines.extend(
        [
        "Regenerate: build the candidate with `script/bundle-omega-rc`, then "
        "run `script/omega-release-gate --report docs/omega/release-gate.md "
        "--receipt-copy docs/omega/release-gate/<date>-<candidate>.gate.json "
        "--sarah-livekit-evidence <public-safe-manifest.json>`.",
        "",
        "| Row | Status | Issues | Evidence / owner instruction |",
        "| --- | --- | --- | --- |",
        ]
    )
    for row in receipt["rows"]:
        issues = ", ".join(row.get("issues", [])) or "—"
        if row["status"] == "owner-assisted-pending":
            detail = row.get("owner_instruction", "")
        elif row["status"] in {"blocked", "inconclusive"}:
            detail = row["facts"].get(
                "blocked_reason", row.get("owner_instruction", "")
            )
        else:
            detail = "; ".join(
                Path(ref["path"]).name for ref in row.get("evidence_refs", [])
            )
        detail = detail.replace("|", "\\|")
        lines.append(f"| `{row['id']}` | {row['status']} | {issues} | {detail} |")
    lines.append("")
    path.parent.mkdir(parents=True, exist_ok=True)
    path.write_text("\n".join(lines) + "\n")


if __name__ == "__main__":
    sys.exit(main())
