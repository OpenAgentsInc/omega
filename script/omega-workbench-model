#!/bin/sh

set -eu

repository_root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
tla2tools_version=1.7.4
tla2tools_sha256=936a262061c914694dfd669a543be24573c45d5aa0ff20a8b96b23d01e050e88
tla2tools_url="https://github.com/tlaplus/tlaplus/releases/download/v${tla2tools_version}/tla2tools.jar"
tools_directory="$repository_root/target/omega-workbench-model/tools"
tla2tools_jar=${TLA2TOOLS_JAR:-"$tools_directory/tla2tools-${tla2tools_version}.jar"}

sha256() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        echo "A SHA-256 utility (sha256sum or shasum) is required." >&2
        exit 127
    fi
}

verify_jar() {
    observed_sha256=$(sha256 "$1")
    if [ "$observed_sha256" != "$tla2tools_sha256" ]; then
        echo "tla2tools.jar checksum mismatch" >&2
        echo "expected: $tla2tools_sha256" >&2
        echo "observed: $observed_sha256" >&2
        exit 1
    fi
}

if [ ! -f "$tla2tools_jar" ]; then
    if [ -n "${TLA2TOOLS_JAR:-}" ]; then
        echo "TLA2TOOLS_JAR does not exist: $tla2tools_jar" >&2
        exit 127
    fi
    if ! command -v curl >/dev/null 2>&1; then
        echo "curl is required to download pinned tla2tools.jar." >&2
        exit 127
    fi

    mkdir -p "$tools_directory"
    download_directory=$(mktemp -d "$tools_directory/download.XXXXXX")
    cleanup() {
        find "$download_directory" -depth -delete
    }
    trap cleanup EXIT HUP INT TERM
    downloaded_jar="$download_directory/tla2tools.jar"
    curl --fail --location --retry 3 --silent --show-error \
        "$tla2tools_url" \
        --output "$downloaded_jar"
    verify_jar "$downloaded_jar"
    mv "$downloaded_jar" "$tla2tools_jar"
fi

verify_jar "$tla2tools_jar"

if [ -z "${JAVA:-}" ] && [ -x /opt/homebrew/opt/openjdk/bin/java ]; then
    JAVA=/opt/homebrew/opt/openjdk/bin/java
    export JAVA
fi

TLA2TOOLS_JAR="$tla2tools_jar" \
    exec "$repository_root/docs/spec/workbench_projection/run.sh"
