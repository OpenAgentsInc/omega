#!/usr/bin/env bash
set -euo pipefail

# omega#220 close criterion: "release builds prove complete omission".
# omega#221 close criterion: "Release and release-fast builds omit fixture
# destinations, counts, recents, routes, search results, and persisted
# restoration." This script proves the first link of that chain — a release
# build never obtains a fixture graph even when one is explicitly requested.
# The second link, "a panel holding no fixture graph exposes no destination,
# route, or persisted restoration", is proved by the paired agent_ui test
# `a_disabled_fixture_gate_omits_every_dogfood_route_and_restoration`.
#
# The runtime gate (DogfoodFixtureGate = debug_assertions && mocks_requested)
# already stops a release build from routing, counting, mutating, or restoring
# fixture Work. It does NOT keep the fixture payload out of the shipped binary:
# `include_bytes!` embeds the graph and `load` keeps it reachable, so before the
# cfg gate a release-fast binary still carried every dogfood issue title,
# project name, and public source URL. This script is the standing proof that it
# no longer does.
#
# Usage: script/prove-dogfood-release-omission

cd "$(dirname "$0")/.."

profile="release-fast"
example="omission_probe"
# Honour CARGO_TARGET_DIR. A worktree that shares the primary warm target
# directory otherwise builds the probe somewhere this script never looks, and
# the run aborts before it has asserted anything.
target_dir="${CARGO_TARGET_DIR:-target}"
binary="${target_dir}/${profile}/examples/${example}"

echo "building ${example} with the ${profile} profile..."
cargo build --profile "$profile" -p omega_work_index --example "$example" >/dev/null

if [[ ! -x "$binary" ]]; then
  echo "FAIL: expected release binary at ${binary}" >&2
  exit 1
fi

echo "--- runtime gate ---"
# Ask for the fixture. With OMEGA_UI_MOCKS unset the gate is disabled in EVERY
# profile, so an "enabled=false" reading would be true of a debug build too and
# would prove nothing about release. Requesting the gate makes the assertion
# below falsifiable: the same probe built with debug assertions reports
# enabled=true and loads the graph.
runtime_output="$(OMEGA_UI_MOCKS=1 "$binary")"
echo "$runtime_output"
case "$runtime_output" in
  *"mocks_requested=true"*) ;;
  *) echo "FAIL: the probe did not observe the requested development gate" >&2; exit 1 ;;
esac
case "$runtime_output" in
  *"debug_assertions=false"*) ;;
  *) echo "FAIL: probe was not built without debug assertions" >&2; exit 1 ;;
esac
case "$runtime_output" in
  *" enabled=false"*) ;;
  *) echo "FAIL: the fixture gate reported enabled in a release build" >&2; exit 1 ;;
esac
case "$runtime_output" in
  *"loaded_some=Ok(false)"*) ;;
  *) echo "FAIL: a release build loaded fixture Work" >&2; exit 1 ;;
esac

echo "--- embedded payload ---"
# Markers drawn from the fixture graph itself: project name, envelope field,
# and the public source URLs. Any one of these appearing in a release binary
# means the development-only graph shipped.
#
# Dump the strings ONCE to a file and grep the file. Do not pipe `strings` into
# `grep -q` here: under `set -o pipefail`, `grep -q` exits on the first match and
# `strings` then dies of SIGPIPE, so a MATCH makes the pipeline non-zero and the
# check silently inverts — reporting "omitted" for a marker that is present.
symbols="$(mktemp)"
trap 'rm -f "$symbols"' EXIT
strings -a "$binary" >"$symbols"

status=0
while IFS= read -r marker; do
  [[ -z "$marker" ]] && continue
  if grep -qF -- "$marker" "$symbols"; then
    echo "FAIL: release binary still contains fixture marker: ${marker}" >&2
    status=1
  else
    echo "omitted: ${marker}"
  fi
done <<'MARKERS'
Omega v0.2.0 dogfood
fixtureSha256
OpenAgentsInc/omega/issues
Security Work
MARKERS

if [[ "$status" -ne 0 ]]; then
  echo >&2
  echo "The development-only dogfood graph is present in a release build." >&2
  echo "Check that FIXTURE_BYTES and the decode arm in" >&2
  echo "crates/omega_work_index/src/dogfood_fixture.rs remain cfg-gated." >&2
  exit 1
fi

echo
echo "PASS: the omega_work_index release build omits the dogfood fixture payload."

# --- scope, stated honestly -------------------------------------------------
# Everything above proves ONE thing: the `omega_work_index` crate compiled at a
# release profile carries no fixture payload. It says NOTHING about the shipped
# application bundle, which links far more code and has its own literals.
#
# That gap was real. omega#235 found `OpenAgentsInc / Omega / Omega as the
# first-class All Work client` hardcoded in non-gated production UI and present
# in the shipped binary, while this script passed — because it only ever
# inspected the probe. `Security Work` is one of the markers above AND is in the
# shipped app as a button label, so the passing result was true of the probe and
# false of the product.
#
# Pass an app bundle or binary to check the real artifact:
#   script/prove-dogfood-release-omission /Applications/Omega.app
app="${1:-}"
if [[ -z "$app" ]]; then
  echo
  echo "NOTE: no application checked. This run proves the crate only."
  echo "      Pass an app bundle to check the shipped artifact:"
  echo "      $0 /Applications/Omega.app"
  exit 0
fi

app_binary="$app"
[[ -d "$app" ]] && app_binary="${app}/Contents/MacOS/omega"
if [[ ! -x "$app_binary" ]]; then
  echo "FAIL: no executable at ${app_binary}" >&2
  exit 1
fi

echo
# The application marker set is deliberately NARROWER than the crate set, and
# the difference is the point. Two crate markers are excluded here because in
# the app they are legitimate, and a gate that reports a legitimate string is a
# gate people learn to ignore:
#
#   fixtureSha256              a serde field name in a schema the app really
#                              ships; its presence says nothing about payload.
#   OpenAgentsInc/omega/issues generic bug-report copy. It was 22 occurrences in
#                              a contaminated build and 2 in a clean one, so the
#                              count is a signal but the string is not a defect.
#
# What IS listed is development-only CONTENT that has no business rendering to a
# user: fixture project names and internal issue titles. Add a marker here only
# if its presence in the shipped app is always wrong.
echo "--- shipped application: ${app_binary} ---"
app_symbols="$(mktemp)"
trap 'rm -f "$symbols" "$app_symbols"' EXIT
strings -a "$app_binary" >"$app_symbols"

app_status=0
while IFS= read -r marker; do
  [[ -z "$marker" ]] && continue
  hits="$(grep -cF -- "$marker" "$app_symbols" || true)"
  if [[ "$hits" != "0" ]]; then
    echo "FAIL: shipped application contains development marker (${hits}x): ${marker}" >&2
    app_status=1
  else
    echo "omitted: ${marker}"
  fi
done <<'APPMARKERS'
Omega v0.2.0 dogfood
Security Work
first-class All Work client
APPMARKERS

if [[ "$app_status" -ne 0 ]]; then
  echo >&2
  echo "Development-only language reached the shipped application." >&2
  echo "A literal in a normal render path is NOT removed by the cfg gate on" >&2
  echo "FIXTURE_BYTES -- derive it from real context or remove it." >&2
  exit 1
fi

echo
echo "PASS: the shipped application also omits development markers."
