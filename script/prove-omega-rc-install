            "schema_version": 1,
            "status": "verified",
            "candidate_verified": True,
            "candidate": {
                "candidate_digest": candidate_digest,
                "omega": {
                    "repository": "https://github.com/OpenAgentsInc/omega",
                    "commit": "a" * 40,
                    "dirty": False,
                },
                "artifact": {
                    "name": artifact.name,
                    "sha256": sha256_file(artifact),
                    "release_record_sha256": sha256_file(record_path),
                },
                "omega_effectd": {
                    key: record["components"]["omega_effectd"][key]
                    for key in effectd_binding_keys
                },
                "assurance_spec_admission": EXPECTED_FULL_AUTO_ASSURANCE_BINDING,
            },
            "obligations": {
                key: dict(full_auto_observation)
                for key in EXPECTED_FULL_AUTO_OBLIGATIONS
            },
            "issue_matrix": {
                key: dict(full_auto_observation) for key in EXPECTED_FULL_AUTO_GATES
            },
            "owner_observation": full_auto_attestation,
            "independent_verification": {
                **full_auto_attestation,
                "actor": "Euler",
                "role": "openagents.assurance_reviewer",
            },
        }
        if validate_full_auto_evidence(
            full_auto, record, record_path, artifact, candidate_digest, "Owner"
        ) != ("Owner", "Euler"):
            raise ProofError("self-test Full Auto binding returned unexpected actors")
        mismatched_full_auto = json.loads(json.dumps(full_auto))
        mismatched_full_auto["independent_verification"]["candidate_digest"] = "0" * 64
        try:
            validate_full_auto_evidence(
                mismatched_full_auto,
                record,
                record_path,
                artifact,
                candidate_digest,
                "Owner",
            )
        except ProofError:
            pass
        else:
            raise ProofError("self-test accepted mismatched Full Auto assurance")
        identity["candidate_admitted"] = False
        try:
            validate_identity_evidence(identity, record, record_path, artifact)
        except ProofError:
            pass
        else:
            raise ProofError("self-test accepted a non-admitted identity candidate")
        identity["candidate_admitted"] = True

        truncated = json.loads(json.dumps(identity))
        truncated["gates"].pop("custody_scenarios")
        try:
            validate_identity_evidence(truncated, record, record_path, artifact)
        except ProofError:
            pass
