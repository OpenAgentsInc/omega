        lifecycle_root = root / "lifecycle"
        lifecycle_root.mkdir()
        snapshots: dict[str, Path] = {}
        for name in (
            "before_snapshot",
            "after_removal_snapshot",
            "after_reinstall_snapshot",
        ):
            snapshot_path = lifecycle_root / f"{name}.json"
            snapshot_path.write_text(
                json.dumps(
                    {
                        "schema": "openagents.omega.rc-lifecycle-proof.v1",
