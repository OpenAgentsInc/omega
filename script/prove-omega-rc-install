class ProofError(RuntimeError):
    pass


def sha256_file(path: Path) -> str:
    digest = hashlib.sha256()
    with path.open("rb") as handle:
        for chunk in iter(lambda: handle.read(1024 * 1024), b""):
            digest.update(chunk)
    return digest.hexdigest()


def reject_duplicate_keys(pairs: list[tuple[str, Any]]) -> dict[str, Any]:
    value: dict[str, Any] = {}
    for key, item in pairs:
        if key in value:
            raise ProofError(f"duplicate JSON key: {key}")
        value[key] = item
    return value


def load_json(path: Path, description: str) -> dict[str, Any]:
    try:
        value = json.loads(
            path.read_text(encoding="utf-8"), object_pairs_hook=reject_duplicate_keys
        )
    except (OSError, json.JSONDecodeError, ProofError) as error:
        raise ProofError(f"cannot read {description} {path}: {error}") from error
    if not isinstance(value, dict):
        raise ProofError(f"{description} must contain a JSON object")
    return value


def schema_type_matches(value: Any, expected: str) -> bool:
    return {
        "object": isinstance(value, dict),
        "array": isinstance(value, list),
        "string": isinstance(value, str),
        "boolean": isinstance(value, bool),
        "null": value is None,
        "integer": isinstance(value, int) and not isinstance(value, bool),
        "number": isinstance(value, (int, float)) and not isinstance(value, bool),
    }.get(expected, False)


def resolve_schema_ref(root_schema: dict[str, Any], reference: str) -> dict[str, Any]:
    if not reference.startswith("#/"):
        raise ProofError(f"identity schema uses unsupported reference: {reference}")
    node: Any = root_schema
    for component in reference[2:].split("/"):
        component = component.replace("~1", "/").replace("~0", "~")
        if not isinstance(node, dict) or component not in node:
            raise ProofError(f"identity schema reference is unresolved: {reference}")
        node = node[component]
    if not isinstance(node, dict):
        raise ProofError(f"identity schema reference is not an object: {reference}")
    return node


def validate_json_schema(
    value: Any,
    schema: dict[str, Any],
    root_schema: dict[str, Any],
    location: str = "$",
) -> None:
    if "$ref" in schema:
        validate_json_schema(
            value, resolve_schema_ref(root_schema, schema["$ref"]), root_schema, location
        )
        return
    if "const" in schema and value != schema["const"]:
        raise ProofError(f"{location} differs from the identity evidence schema constant")
    if "enum" in schema and value not in schema["enum"]:
        raise ProofError(f"{location} is not an allowed identity evidence schema value")
    expected_type = schema.get("type")
    if isinstance(expected_type, str) and not schema_type_matches(value, expected_type):
        raise ProofError(f"{location} must have JSON type {expected_type}")
    if isinstance(value, str):
        if len(value) < schema.get("minLength", 0):
            raise ProofError(f"{location} is shorter than the identity evidence schema permits")
        pattern = schema.get("pattern")
        if isinstance(pattern, str) and re.fullmatch(pattern, value) is None:
            raise ProofError(f"{location} does not match the identity evidence schema")
        if schema.get("format") == "date-time":
            try:
                parsed = datetime.fromisoformat(value.replace("Z", "+00:00"))
            except ValueError as error:
                raise ProofError(f"{location} is not an ISO-8601 date-time") from error
            if parsed.tzinfo is None:
                raise ProofError(f"{location} date-time must include a timezone")
    if isinstance(value, list):
        if len(value) < schema.get("minItems", 0) or len(value) > schema.get(
            "maxItems", len(value)
        ):
            raise ProofError(f"{location} has an invalid item count")
        item_schema = schema.get("items")
        if isinstance(item_schema, dict):
            for index, item in enumerate(value):
                validate_json_schema(item, item_schema, root_schema, f"{location}[{index}]")
    if isinstance(value, dict):
        if len(value) < schema.get("minProperties", 0) or len(value) > schema.get(
            "maxProperties", len(value)
        ):
            raise ProofError(f"{location} has an invalid property count")
        required = schema.get("required", [])
        missing = [name for name in required if name not in value]
        if missing:
            raise ProofError(f"{location} is missing schema properties: {', '.join(missing)}")
        properties = schema.get("properties", {})
        additional = schema.get("additionalProperties", True)
        for name, item in value.items():
            if name in properties:
                validate_json_schema(item, properties[name], root_schema, f"{location}.{name}")
            elif additional is False:
                raise ProofError(f"{location} contains unknown schema property: {name}")
            elif isinstance(additional, dict):
                validate_json_schema(item, additional, root_schema, f"{location}.{name}")
        property_names = schema.get("propertyNames")
        if isinstance(property_names, dict):
            for name in value:
                validate_json_schema(name, property_names, root_schema, f"{location}.<name>")
    if "oneOf" in schema:
        matches = 0
        for candidate_schema in schema["oneOf"]:
            try:
                validate_json_schema(value, candidate_schema, root_schema, location)
                matches += 1
            except ProofError:
                pass
        if matches != 1:
            raise ProofError(f"{location} must match exactly one identity schema branch")
    for nested_schema in schema.get("allOf", []):
        condition = nested_schema.get("if")
        if condition is None:
            validate_json_schema(value, nested_schema, root_schema, location)
            continue
        branch = "then"
        try:
            validate_json_schema(value, condition, root_schema, location)
        except ProofError:
            branch = "else"
        selected = nested_schema.get(branch)
        if isinstance(selected, dict):
            validate_json_schema(value, selected, root_schema, location)


def validate_identity_evidence_schema(evidence: dict[str, Any]) -> None:
    schema = load_json(IDENTITY_EVIDENCE_SCHEMA, "identity evidence schema")
    validate_json_schema(evidence, schema, schema)


def validate_full_auto_evidence_schema(evidence: dict[str, Any]) -> None:
    schema = load_json(FULL_AUTO_EVIDENCE_SCHEMA, "Full Auto evidence schema")
    validate_json_schema(evidence, schema, schema)


def run(command: list[str], *, description: str) -> str:
    result = subprocess.run(command, capture_output=True, text=True, check=False)
    output = "\n".join(part for part in (result.stdout, result.stderr) if part).strip()
    if result.returncode != 0:
        detail = f": {output}" if output else ""
        raise ProofError(f"{description} failed{detail}")
    return output


def validate_release_record(record: dict[str, Any], record_path: Path, artifact: Path) -> None:
    required = {
        "schema_version",
        "product",
        "channel",
        "version",
        "bundle_version",
        "artifact_name",
        "bundle_identifier",
        "team_id",
        "signing_identity",
        "source",
        "digests",
        "components",
        "notarization",
        "legal",
        "publication",
    }
    missing = sorted(required.difference(record))
    if missing:
        raise ProofError(f"release record missing keys: {', '.join(missing)}")
    expected = {
        "schema_version": 1,
        "product": EXPECTED_PRODUCT,
        "channel": "rc",
        "version": EXPECTED_VERSION,
        "artifact_name": artifact.name,
        "bundle_identifier": EXPECTED_BUNDLE_ID,
        "team_id": EXPECTED_TEAM_ID,
        "signing_identity": EXPECTED_SIGNER,
        "bundle_version": "0.2.0",
    }
    for key, expected_value in expected.items():
        if record.get(key) != expected_value:
            raise ProofError(
                f"release record {key}={record.get(key)!r}, expected {expected_value!r}"
            )
    if record.get("source", {}).get("dirty") is not False:
        raise ProofError("release record must bind a clean source commit")
    if record.get("legal", {}).get("commercial_terms_attached") is not False:
        raise ProofError("release record must exclude commercial terms")
    notices = record.get("legal", {}).get("notices")
    if not isinstance(notices, dict) or set(notices) != {
        "LICENSE-GPL",
        "LICENSE-APACHE",
        "licenses.md",
    }:
        raise ProofError("release record legal notice digest inventory is incomplete")
    packaged_icons = record.get("digests", {}).get("packaged_icon_outputs")
    if not isinstance(packaged_icons, dict) or set(packaged_icons) != {
        "Contents/Resources/openagents-icon.icns",
        "Contents/Resources/Document.icns",
    }:
        raise ProofError("release record packaged icon digest inventory is incomplete")
    for label, bindings in (("legal notice", notices), ("packaged icon", packaged_icons)):
        if not all(
            isinstance(value, str)
            and re.fullmatch(r"[0-9a-f]{64}", value) is not None
            for value in bindings.values()
        ):
            raise ProofError(f"release record {label} digest is invalid")
    publication = record.get("publication", {})
    if publication.get("repository") != "OpenAgentsInc/omega":
        raise ProofError("release publication repository must be OpenAgentsInc/omega")
    if publication.get("tag") != f"v{EXPECTED_VERSION}":
        raise ProofError(f"release publication tag must be v{EXPECTED_VERSION}")
    if publication.get("prerelease") is not True or publication.get("latest") is not False:
        raise ProofError("release publication must be prerelease=true and latest=false")
    notarization = record.get("notarization", {})
    if notarization.get("attempted") is not True or notarization.get("stapled") is not True:
        raise ProofError("release record notarization must be attempted and stapled")
    expected_digest = record.get("digests", {}).get("package_sha256")
    if expected_digest != sha256_file(artifact):
        raise ProofError("artifact SHA-256 does not match release record")
    effectd = record.get("components", {}).get("omega_effectd", {})
    expected_effectd = {
        "package": "@openagentsinc/omega-effectd",
        "service_version": "0.1.0",
        "protocol": "openagents.omega.effectd.v1",
        "platform": "darwin-arm64",
        "release_tag": "omega-effectd-v0.1.0-rc.6",
        "asset_name": "omega-effectd-v0.1.0-macos-arm64.tar.gz",
        "archive_sha256": EXPECTED_EFFECTD_ARCHIVE_SHA256,
        "manifest_sha256": EXPECTED_EFFECTD_MANIFEST_SHA256,
        "source_commit": EXPECTED_EFFECTD_SOURCE_COMMIT,
        "source_tree": EXPECTED_EFFECTD_SOURCE_TREE,
    }
    for key, expected_value in expected_effectd.items():
        if effectd.get(key) != expected_value:
            raise ProofError(f"omega-effectd release record {key} differs from the pin")
    for key in (
        "wrapper_sha256",
        "bundle_sha256",
        "source_node_sha256",
        "packaged_node_sha256",
    ):
        value = effectd.get(key)
        if (
            not isinstance(value, str)
            or len(value) != 64
            or any(character not in "0123456789abcdef" for character in value)
        ):
            raise ProofError(f"omega-effectd release record {key} is not a SHA-256 digest")
    identity_proof = record.get("components", {}).get("identity_proof_driver", {})
    expected_identity_proof = {
        "path": "Contents/MacOS/omega-identity-proof",
        "protocol": "openagents.omega.identity-proof.v1",
        "keyring_service": "com.openagents.omega.identity-proof.v1",
        "keyring_account": "disposable-proof-only",
    }
    for key, expected_value in expected_identity_proof.items():
        if identity_proof.get(key) != expected_value:
            raise ProofError(f"identity proof driver release record {key} differs from the pin")
    identity_proof_digest = identity_proof.get("binary_sha256")
    if not isinstance(identity_proof_digest, str) or re.fullmatch(
        r"[0-9a-f]{64}", identity_proof_digest
    ) is None:
        raise ProofError("identity proof driver release record digest is invalid")
    if record_path.resolve() == artifact.resolve():
        raise ProofError("release record and artifact must be distinct files")


def validate_identity_evidence_binding(
    evidence: dict[str, Any], record: dict[str, Any], record_path: Path, artifact: Path
) -> str:
    validate_identity_evidence_schema(evidence)
    digest = evidence.get("candidate_digest", {}).get("value")
    if (
        not isinstance(digest, str)
        or len(digest) != 64
        or any(character not in "0123456789abcdef" for character in digest)
    ):
        raise ProofError("identity evidence candidate digest is invalid")
    candidate = evidence.get("candidate", {})
    observed_digest = hashlib.sha256(
        json.dumps(candidate, sort_keys=True, separators=(",", ":")).encode("utf-8")
    ).hexdigest()
    if digest != observed_digest:
        raise ProofError("identity candidate digest does not match canonical candidate JSON")
    candidate_artifact = candidate.get("artifact", {})
    if candidate_artifact.get("name") != artifact.name:
        raise ProofError("identity evidence names a different artifact")
    if candidate_artifact.get("sha256") != sha256_file(artifact):
        raise ProofError("identity evidence artifact digest does not match explicit artifact")
    if candidate_artifact.get("release_record_sha256") != sha256_file(record_path):
        raise ProofError("identity evidence release-record digest does not match")
    if candidate.get("omega", {}).get("commit") != record.get("source", {}).get("commit"):
        raise ProofError("identity evidence and release record bind different source commits")
    if candidate.get("assurance_spec_admission") != EXPECTED_ASSURANCE_BINDING:
        raise ProofError(
            "identity evidence does not bind the admitted AssuranceSpec proposal and receipt"
        )
    return digest


def validate_identity_evidence(
    evidence: dict[str, Any], record: dict[str, Any], record_path: Path, artifact: Path
) -> tuple[str, str, str]:
    digest = validate_identity_evidence_binding(evidence, record, record_path, artifact)
    if evidence.get("status") != "admitted" or evidence.get("candidate_admitted") is not True:
        raise ProofError("identity candidate is not admitted")
    if evidence.get("attestation_errors") not in ({}, None):
        raise ProofError("identity candidate evidence contains attestation errors")
    gates = evidence.get("gates")
    if not isinstance(gates, dict) or set(gates) != set(EXPECTED_IDENTITY_GATES):
        observed = set(gates) if isinstance(gates, dict) else set()
        missing = sorted(set(EXPECTED_IDENTITY_GATES).difference(observed))
        unknown = sorted(observed.difference(EXPECTED_IDENTITY_GATES))
        detail = []
        if missing:
            detail.append(f"missing={','.join(missing)}")
        if unknown:
            detail.append(f"unknown={','.join(unknown)}")
        raise ProofError(
            "identity evidence gate inventory is not exact"
            + (f": {'; '.join(detail)}" if detail else "")
        )
    pending = sorted(
        name
        for name, gate in gates.items()
        if not isinstance(gate, dict) or gate.get("status") != "passed"
    )
    if pending:
        raise ProofError(f"identity evidence has gates not passed: {', '.join(pending)}")
    for required_gate in ("manual_journey", "owner_observation", "independent_verification"):
        if gates.get(required_gate, {}).get("status") != "passed":
            raise ProofError(f"identity evidence gate {required_gate} is not passed")
    owner = gates["owner_observation"].get("attestor")
    independent = gates["independent_verification"].get("attestor")
    if (
        not isinstance(owner, str)
        or not owner.strip()
        or not isinstance(independent, str)
        or not independent.strip()
        or owner == independent
    ):
        raise ProofError("identity owner and independent verifier must be distinct named attestors")
    return digest, owner, independent


def validate_manual_evidence(
    evidence: dict[str, Any],
    candidate_digest: str,
    identity_owner: str,
    identity_independent: str,
) -> None:
    if evidence.get("schema") != "openagents.omega.installed-brand-evidence.v1":
        raise ProofError("installed brand evidence schema is not supported")
    if evidence.get("candidate_digest") != candidate_digest:
        raise ProofError("installed brand evidence binds a different candidate digest")
    checks = evidence.get("checks")
    if not isinstance(checks, dict) or set(checks) != set(MANUAL_CHECKS):
        raise ProofError("installed brand evidence check inventory is incomplete or unexpected")
    for name in MANUAL_CHECKS:
        check = checks[name]
        if (
            not isinstance(check, dict)
            or check.get("status") != "passed"
            or not isinstance(check.get("evidence"), str)
            or not check["evidence"].strip()
        ):
            raise ProofError(f"installed brand evidence check {name} is not passed with evidence")
    owner = evidence.get("owner_observation")
    independent = evidence.get("independent_verification")
    for name, attestation in (
        ("owner_observation", owner),
        ("independent_verification", independent),
    ):
        if (
            not isinstance(attestation, dict)
            or attestation.get("status") != "passed"
            or not isinstance(attestation.get("attestor"), str)
            or not attestation["attestor"].strip()
            or not isinstance(attestation.get("observed_at"), str)
            or not attestation["observed_at"].strip()
            or not isinstance(attestation.get("evidence"), str)
            or not attestation["evidence"].strip()
        ):
            raise ProofError(f"installed brand evidence {name} is incomplete")
    if owner["attestor"] == independent["attestor"]:
        raise ProofError("installed brand owner and independent verifier must be distinct")
    if owner["attestor"] != identity_owner:
        raise ProofError("installed brand owner differs from identity candidate owner")
    if independent["attestor"] != identity_independent:
        raise ProofError(
            "installed brand independent verifier differs from identity candidate verifier"
        )


def validate_network_evidence(path: Path, candidate_digest: str) -> None:
    evidence = load_json(path, "network capture evidence")
    if evidence.get("schema") != "openagents.omega.network-capture.v1":
        raise ProofError("network capture evidence schema is not supported")
    if evidence.get("candidate_digest") != candidate_digest:
        raise ProofError("network capture evidence binds a different candidate")
    if evidence.get("status") != "passed" or evidence.get("blocked_reasons") != []:
        raise ProofError("network capture evidence is blocked")
    if evidence.get("journey") != "online_first_codex":
        raise ProofError("network capture did not exercise online first-Codex setup")
    allowlist = load_json(ENDPOINT_ALLOWLIST, "endpoint allowlist")
    binding = evidence.get("allowlist", {})
    if binding.get("sha256") != sha256_file(ENDPOINT_ALLOWLIST):
        raise ProofError("network capture evidence binds a different endpoint allowlist")
    if binding.get("enforcement") != allowlist.get("enforcement"):
        raise ProofError("network capture enforcement mode differs from the allowlist")
    processes = evidence.get("processes")
    if not isinstance(processes, list) or not any(
        isinstance(process, dict) and process.get("command_basename") == "omega"
        for process in processes
    ):
        raise ProofError("network capture has no Omega process ancestry")
    destinations = evidence.get("destinations")
    if not isinstance(destinations, list) or not destinations:
        raise ProofError("network capture has no observed destinations")
    approved_hosts = {
        entry.get("host")
        for entry in allowlist.get("entries", [])
        if entry.get("disposition") == "approved"
    }
    forbidden_hosts = allowlist.get("normal_start_forbidden_hosts", [])
    for destination in destinations:
        host = destination.get("host") if isinstance(destination, dict) else None
        if not isinstance(host, str) or not host:
            raise ProofError("network capture contains an invalid destination")
        try:
            ipaddress.ip_address(host)
        except ValueError:
            pass
        else:
            raise ProofError("network capture contains an unresolved IP destination")
        if any(host == item or host.endswith(f".{item}") for item in forbidden_hosts):
            raise ProofError(f"network capture reached forbidden host: {host}")
        if not any(host == item or host.endswith(f".{item}") for item in approved_hosts):
            raise ProofError(f"network capture reached an unreviewed host: {host}")
    for field in ("forbidden_hosts_detected", "unreviewed_hosts", "unresolved_destinations"):
        if evidence.get(field) != []:
            raise ProofError(f"network capture {field} must be empty")


def validate_full_auto_evidence(
    evidence: dict[str, Any],
    record: dict[str, Any],
    record_path: Path,
    artifact: Path,
    candidate_digest: str,
    identity_owner: str,
) -> tuple[str, str]:
    validate_full_auto_evidence_schema(evidence)
    if evidence.get("status") != "verified" or evidence.get("candidate_verified") is not True:
        raise ProofError("Full Auto candidate evidence is not verified")
    candidate = evidence.get("candidate", {})
    if candidate.get("candidate_digest") != candidate_digest:
        raise ProofError("Full Auto evidence binds a different candidate digest")
    omega = candidate.get("omega", {})
    if (
        omega.get("commit") != record.get("source", {}).get("commit")
        or omega.get("dirty") is not False
    ):
        raise ProofError("Full Auto evidence binds a different Omega source")
    candidate_artifact = candidate.get("artifact", {})
    if (
        candidate_artifact.get("name") != artifact.name
        or candidate_artifact.get("sha256") != sha256_file(artifact)
        or candidate_artifact.get("release_record_sha256") != sha256_file(record_path)
    ):
        raise ProofError("Full Auto evidence binds a different artifact or release record")
    if candidate.get("assurance_spec_admission") != EXPECTED_FULL_AUTO_ASSURANCE_BINDING:
        raise ProofError("Full Auto evidence does not bind the admitted revision 5 design")
    effectd = candidate.get("omega_effectd", {})
    release_effectd = record.get("components", {}).get("omega_effectd", {})
    expected_effectd_keys = {
        "release_tag",
        "archive_sha256",
        "manifest_sha256",
        "source_commit",
        "source_tree",
        "wrapper_sha256",
        "bundle_sha256",
        "source_node_sha256",
        "packaged_node_sha256",
    }
    if set(effectd) != expected_effectd_keys or any(
        effectd.get(key) != release_effectd.get(key) for key in expected_effectd_keys
    ):
        raise ProofError("Full Auto evidence binds a different omega-effectd component")
    obligations = evidence.get("obligations")
    if not isinstance(obligations, dict) or set(obligations) != set(
        EXPECTED_FULL_AUTO_OBLIGATIONS
    ):
        raise ProofError("Full Auto evidence obligation inventory is not exact")
    gates = evidence.get("issue_matrix")
    if not isinstance(gates, dict) or set(gates) != set(EXPECTED_FULL_AUTO_GATES):
        raise ProofError("Full Auto evidence issue-matrix inventory is not exact")
    for name, observation in {**obligations, **gates}.items():
        if (
            not isinstance(observation, dict)
            or observation.get("status") != "passed"
            or not isinstance(observation.get("evidence_refs"), list)
            or not observation["evidence_refs"]
        ):
            raise ProofError(f"Full Auto evidence {name} is not passed with evidence")
    owner = evidence.get("owner_observation", {})
    independent = evidence.get("independent_verification", {})
    bindings = {
        "candidate_digest": candidate_digest,
        "artifact_sha256": sha256_file(artifact),
        "release_record_sha256": sha256_file(record_path),
        "omega_commit": record.get("source", {}).get("commit"),
    }
    for label, attestation, role in (
        ("owner observation", owner, "openagents.owner"),
        ("independent verification", independent, "openagents.assurance_reviewer"),
    ):
        if (
            not isinstance(attestation, dict)
            or attestation.get("status") != "passed"
            or attestation.get("role") != role
            or not isinstance(attestation.get("actor"), str)
            or not attestation["actor"].strip()
            or any(attestation.get(key) != value for key, value in bindings.items())
        ):
            raise ProofError(f"Full Auto {label} is incomplete or candidate-mismatched")
    if owner["actor"] != identity_owner:
        raise ProofError("Full Auto owner differs from the admitted identity candidate owner")
    if owner["actor"] == independent["actor"]:
        raise ProofError("Full Auto owner and independent verifier must be distinct")
    return owner["actor"], independent["actor"]


def load_bound_lifecycle_receipt(
    manifest_path: Path,
    reference: Any,
    label: str,
    candidate_digest: str,
) -> tuple[dict[str, Any], str]:
    if not isinstance(reference, dict) or set(reference) != {"path", "sha256"}:
        raise ProofError(f"lifecycle receipt reference {label} is not exact")
    relative = reference.get("path")
    expected_digest = reference.get("sha256")
    if (
        not isinstance(relative, str)
        or not relative
        or Path(relative).is_absolute()
        or ".." in Path(relative).parts
        or not isinstance(expected_digest, str)
        or re.fullmatch(r"[0-9a-f]{64}", expected_digest) is None
    ):
        raise ProofError(f"lifecycle receipt reference {label} is invalid")
    receipt_path = manifest_path.parent / relative
    if receipt_path.is_symlink() or not receipt_path.is_file():
        raise ProofError(f"lifecycle receipt {label} is missing or unsafe")
    observed_digest = sha256_file(receipt_path)
    if observed_digest != expected_digest:
        raise ProofError(f"lifecycle receipt {label} digest differs from its manifest")
    receipt = load_json(receipt_path, f"lifecycle receipt {label}")
    if (
        receipt.get("schema") != "openagents.omega.rc-lifecycle-proof.v1"
        or receipt.get("candidate_digest") != candidate_digest
    ):
        raise ProofError(f"lifecycle receipt {label} binds a different candidate")
    return receipt, observed_digest


def validate_lifecycle_evidence(
    path: Path,
    candidate_digest: str,
    record_path: Path,
    artifact: Path,
) -> None:
    evidence = load_json(path, "installed lifecycle evidence")
    if set(evidence) != {
        "schema",
        "status",
        "candidate_digest",
        "artifact_sha256",
        "release_record_sha256",
        "receipts",
    }:
        raise ProofError("installed lifecycle evidence keys are not exact")
    if (
        evidence.get("schema") != "openagents.omega.installed-lifecycle-evidence.v1"
        or evidence.get("status") != "passed"
        or evidence.get("candidate_digest") != candidate_digest
        or evidence.get("artifact_sha256") != sha256_file(artifact)
        or evidence.get("release_record_sha256") != sha256_file(record_path)
    ):
        raise ProofError("installed lifecycle evidence is incomplete or candidate-mismatched")
    references = evidence.get("receipts")
    if not isinstance(references, dict) or set(references) != set(
        EXPECTED_LIFECYCLE_RECEIPTS
    ):
        raise ProofError("installed lifecycle receipt inventory is not exact")
    loaded = {
        name: load_bound_lifecycle_receipt(path, reference, name, candidate_digest)
        for name, reference in references.items()
    }
    for name in ("before_snapshot", "after_removal_snapshot", "after_reinstall_snapshot"):
        if loaded[name][0].get("kind") != "snapshot":
            raise ProofError(f"lifecycle {name} is not a snapshot")
    comparisons = {
        "zed_after_removal_comparison": ("zed", "before_snapshot", "after_removal_snapshot"),
        "zed_after_reinstall_comparison": ("zed", "before_snapshot", "after_reinstall_snapshot"),
        "omega_after_reinstall_comparison": (
            "omega",
            "before_snapshot",
            "after_reinstall_snapshot",
        ),
    }
    for name, (scope, before_name, after_name) in comparisons.items():
        receipt = loaded[name][0]
        if (
            receipt.get("kind") != "comparison"
            or receipt.get("scope") != scope
            or receipt.get("status") != "passed"
            or receipt.get("changed_roots") != []
            or receipt.get("before_snapshot_sha256") != loaded[before_name][1]
            or receipt.get("after_snapshot_sha256") != loaded[after_name][1]
        ):
            raise ProofError(f"lifecycle comparison {name} is not a passing bound comparison")
    removal = loaded["app_removal"][0]
    if (
        removal.get("kind") != "app_removal"
        or removal.get("source_path") != str(DEFAULT_APP)
        or removal.get("recoverable") is not True
        or removal.get("zed_targets_touched") is not False
    ):
        raise ProofError("lifecycle app removal receipt is not safe and recoverable")
    reinstall = loaded["app_reinstall"][0]
    if (
        reinstall.get("kind") != "app_reinstall"
        or reinstall.get("installed_path") != str(DEFAULT_APP)
        or reinstall.get("artifact_sha256") != sha256_file(artifact)
        or reinstall.get("release_record_sha256") != sha256_file(record_path)
        or reinstall.get("zed_targets_touched") is not False
    ):
        raise ProofError("lifecycle app reinstall receipt binds a different candidate")


def bundle_manifest(app: Path) -> dict[str, str]:
    if not app.is_dir():
        raise ProofError(f"application bundle is missing: {app}")
    manifest: dict[str, str] = {}
    for path in sorted(app.rglob("*")):
        relative = path.relative_to(app).as_posix()
        if path.is_symlink():
            manifest[relative] = f"symlink:{os.readlink(path)}"
        elif path.is_file():
            manifest[relative] = f"sha256:{sha256_file(path)}"
    if not manifest:
        raise ProofError(f"application bundle is empty: {app}")
    return manifest


def validate_app_metadata(app: Path, record: dict[str, Any]) -> None:
    info_path = app / "Contents/Info.plist"
    try:
        info = plistlib.loads(info_path.read_bytes())
    except (OSError, plistlib.InvalidFileException) as error:
        raise ProofError(f"cannot read application Info.plist: {error}") from error
    if info.get("CFBundleName") != EXPECTED_PRODUCT:
        raise ProofError("application CFBundleName is not Omega")
    if info.get("CFBundleIdentifier") != EXPECTED_BUNDLE_ID:
        raise ProofError("application bundle identifier is not the Omega RC identifier")
    version = info.get("CFBundleShortVersionString")
    if version != record.get("bundle_version"):
        raise ProofError(f"application version {version!r} differs from release record")


def validate_binary_digests(app: Path, record: dict[str, Any]) -> None:
    digests = record.get("digests", {})
    paths = (
        ("omega_binary_sha256", app / "Contents/MacOS/omega", digests),
        ("cli_binary_sha256", app / "Contents/MacOS/cli", digests),
        (
            "binary_sha256",
            app / "Contents/MacOS/omega-identity-proof",
            record.get("components", {}).get("identity_proof_driver", {}),
        ),
    )
    for key, path, bindings in paths:
        if not path.is_file():
            raise ProofError(f"packaged executable is missing: {path}")
        if bindings.get(key) != sha256_file(path):
            raise ProofError(f"{path.name} digest differs from release record")


def validate_packaged_legal_and_icons(
    packaged_app: Path, installed_app: Path, record: dict[str, Any]
) -> None:
    for relative, expected_digest in record["legal"]["notices"].items():
        notice = packaged_app.parent / relative
        if not notice.is_file() or sha256_file(notice) != expected_digest:
            raise ProofError(f"packaged legal notice differs from release record: {relative}")
    for relative, expected_digest in record["digests"]["packaged_icon_outputs"].items():
        packaged_icon = packaged_app / relative
        installed_icon = installed_app / relative
        if not packaged_icon.is_file() or sha256_file(packaged_icon) != expected_digest:
            raise ProofError(f"packaged icon differs from release record: {relative}")
        if not installed_icon.is_file() or sha256_file(installed_icon) != expected_digest:
            raise ProofError(f"installed icon differs from release record: {relative}")


def validate_effectd_component(
    app: Path, record: dict[str, Any], output_dir: Path, label: str
) -> None:
    component = app / "Contents/Resources/omega-effectd"
    manifest_path = component / "component-manifest.json"
    wrapper_path = component / "bin/omega-effectd"
    bundle_path = component / "dist/omega-effectd.mjs"
    node_path = component / "runtime/bin/node"
    for path in (manifest_path, wrapper_path, bundle_path, node_path):
        if not path.is_file():
            raise ProofError(f"{label} omega-effectd file is missing: {path}")
    if not os.access(wrapper_path, os.X_OK) or not os.access(node_path, os.X_OK):
        raise ProofError(f"{label} omega-effectd executables are not executable")

    manifest = load_json(manifest_path, f"{label} omega-effectd manifest")
    expected_manifest = {
        "schema": "openagents.omega.effectd.component.v1",
        "package": "@openagentsinc/omega-effectd",
        "serviceVersion": "0.1.0",
        "protocol": "openagents.omega.effectd.v1",
        "platform": "darwin-arm64",
    }
    for key, expected_value in expected_manifest.items():
        if manifest.get(key) != expected_value:
            raise ProofError(f"{label} omega-effectd manifest {key} differs from the pin")
    if manifest.get("source", {}).get("commit") != EXPECTED_EFFECTD_SOURCE_COMMIT:
        raise ProofError(f"{label} omega-effectd source commit differs from the pin")
    if manifest.get("source", {}).get("tree") != EXPECTED_EFFECTD_SOURCE_TREE:
        raise ProofError(f"{label} omega-effectd source tree differs from the pin")

    effectd = record["components"]["omega_effectd"]
    observed = {
        "manifest_sha256": sha256_file(manifest_path),
        "wrapper_sha256": sha256_file(wrapper_path),
        "bundle_sha256": sha256_file(bundle_path),
        "packaged_node_sha256": sha256_file(node_path),
    }
    for key, digest in observed.items():
        if effectd.get(key) != digest:
            raise ProofError(f"{label} omega-effectd {key} differs from the release record")
    validate_effectd_file_digests(component, manifest, effectd, label)

    verify_signature(node_path, output_dir, f"{label}-effectd-node")
    validate_effectd_node_entitlements(node_path, output_dir, label)
    health_receipt = probe_effectd_initialize_health(wrapper_path)
    (output_dir / f"omega-effectd-health-{label}.json").write_text(
        json.dumps(health_receipt, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )


def validate_effectd_file_digests(
    component: Path, manifest: dict[str, Any], effectd: dict[str, Any], label: str
) -> None:
    source_node_digest = manifest.get("node", {}).get("binarySha256")
    if source_node_digest != effectd.get("source_node_sha256"):
        raise ProofError(f"{label} omega-effectd source Node digest differs from the pin")
    for relative, expected_digest in manifest.get("files", {}).items():
        if relative == "runtime/bin/node":
            if expected_digest != source_node_digest:
                raise ProofError(f"{label} omega-effectd manifest Node digests disagree")
            continue
        path = component / relative
        if not path.is_file() or sha256_file(path) != expected_digest:
            raise ProofError(f"{label} omega-effectd manifest file differs: {relative}")


def validate_effectd_node_entitlements(
    node_path: Path, output_dir: Path, label: str
) -> None:
    details = run(
        ["codesign", "-d", "--entitlements", "-", "--xml", str(node_path)],
        description=f"{label} omega-effectd Node entitlement inspection",
    )
    entitlements = parse_codesign_entitlements(details, label)
    expected = {
        "com.apple.security.cs.allow-jit": True,
        "com.apple.security.cs.allow-unsigned-executable-memory": True,
    }
    if entitlements != expected:
        raise ProofError(f"{label} omega-effectd Node entitlements differ from the minimal set")
    (output_dir / f"entitlements-{label}-effectd-node.plist").write_bytes(
        plistlib.dumps(entitlements, sort_keys=True)
    )


def parse_codesign_entitlements(details: str, label: str) -> dict[str, Any]:
    xml_start = details.find("<?xml")
    xml_end_marker = "</plist>"
    xml_end = details.find(xml_end_marker, xml_start)
    if xml_start < 0 or xml_end < 0:
        raise ProofError(f"{label} omega-effectd Node entitlements are unreadable")
    xml_end += len(xml_end_marker)
    try:
        entitlements = plistlib.loads(details[xml_start:xml_end].encode("utf-8"))
    except (plistlib.InvalidFileException, ExpatError) as error:
        raise ProofError(f"{label} omega-effectd Node entitlements are invalid") from error
    if not isinstance(entitlements, dict):
        raise ProofError(f"{label} omega-effectd Node entitlements are not a dictionary")
    return entitlements


def probe_effectd_initialize_health(program: Path) -> dict[str, Any]:
    with tempfile.TemporaryDirectory(prefix="omega-effectd-proof-data-") as data_root:
        environment = os.environ.copy()
        environment["OPENAGENTS_OMEGA_EFFECTD_DATA_ROOT"] = data_root
        process = subprocess.Popen(
            [str(program)],
            stdin=subprocess.PIPE,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
            text=True,
            env=environment,
        )
        if process.stdin is None or process.stdout is None:
            process.kill()
            raise ProofError("omega-effectd proof process did not expose stdio")
        selector = selectors.DefaultSelector()
        selector.register(process.stdout, selectors.EVENT_READ)

        def exchange(identifier: str, method: str, params: dict[str, Any] | None) -> dict[str, Any]:
            request = {
                "schema": "openagents.omega.effectd.v1",
                "kind": "request",
                "id": identifier,
                "generation": 1,
                "method": method,
            }
            if params is not None:
                request["params"] = params
            process.stdin.write(json.dumps(request, separators=(",", ":")) + "\n")
            process.stdin.flush()
            deadline = time.monotonic() + 30
            while True:
                remaining = deadline - time.monotonic()
                if remaining <= 0 or not selector.select(remaining):
                    raise ProofError(f"omega-effectd {method} response timed out")
                line = process.stdout.readline()
                if not line:
                    raise ProofError(f"omega-effectd closed stdout during {method}")
                response = json.loads(line)
                if response.get("kind") == "response" and response.get("id") == identifier:
                    break
            if (
                response.get("schema") != "openagents.omega.effectd.v1"
                or response.get("generation") != 1
                or response.get("ok") is not True
                or not isinstance(response.get("result"), dict)
            ):
                raise ProofError(f"omega-effectd {method} returned an invalid response")
            return response["result"]

        try:
            initialized = exchange("proof-initialize", "initialize", {"generation": 1})
            health = exchange("proof-health", "health", None)
        except (OSError, json.JSONDecodeError) as error:
            raise ProofError(f"omega-effectd initialize/health probe failed: {error}") from error
        finally:
            selector.close()
            process.terminate()
            try:
                process.wait(timeout=5)
            except subprocess.TimeoutExpired:
                process.kill()
                process.wait(timeout=5)

        if (
            initialized.get("schema") != "openagents.omega.effectd.v1"
            or initialized.get("protocolVersion") != 1
            or initialized.get("serviceVersion") != "0.1.0"
            or initialized.get("generation") != 1
            or "health" not in initialized.get("capabilities", [])
        ):
            raise ProofError("omega-effectd initialize result differs from the pinned contract")
        if (
            health.get("ok") is not True
            or health.get("status") != "running"
            or health.get("generation") != 1
            or not isinstance(health.get("activeRunCount"), int)
        ):
            raise ProofError("omega-effectd health result is not running")
        return {
            "schema": "openagents.omega.effectd.proof.v1",
            "initialize": {
                "protocolVersion": initialized["protocolVersion"],
                "serviceVersion": initialized["serviceVersion"],
                "generation": initialized["generation"],
                "capabilities": initialized["capabilities"],
            },
            "health": {
                "ok": health["ok"],
                "status": health["status"],
                "generation": health["generation"],
                "activeRunCount": health["activeRunCount"],
            },
        }


def verify_signature(app: Path, output_dir: Path, label: str) -> None:
    run(
        ["codesign", "--verify", "--deep", "--strict", "--verbose=2", str(app)],
        description=f"{label} code-signature verification",
    )
    details = run(
        ["codesign", "-dv", "--verbose=4", str(app)],
        description=f"{label} code-signature inspection",
    )
    (output_dir / f"codesign-{label}.txt").write_text(details + "\n", encoding="utf-8")
    if f"TeamIdentifier={EXPECTED_TEAM_ID}" not in details:
        raise ProofError(f"{label} TeamIdentifier is not {EXPECTED_TEAM_ID}")
    if app.suffix == ".app" and f"Identifier={EXPECTED_BUNDLE_ID}" not in details:
        raise ProofError(f"{label} Identifier is not {EXPECTED_BUNDLE_ID}")


def mounted_application(artifact: Path):
    class MountedApplication:
        def __init__(self) -> None:
            self.temp = tempfile.TemporaryDirectory(prefix="omega-installed-proof-")
            self.mount = Path(self.temp.name) / "mount"
            self.mount.mkdir()
            self.attached = False

        def __enter__(self) -> Path:
            run(
                [
                    "hdiutil",
                    "attach",
                    "-readonly",
                    "-nobrowse",
                    "-mountpoint",
                    str(self.mount),
                    str(artifact),
                ],
                description="read-only DMG mount",
            )
            self.attached = True
            try:
                applications = list(self.mount.glob("*.app"))
                if len(applications) != 1 or applications[0].name != "Omega.app":
                    raise ProofError("DMG must contain exactly one top-level Omega.app")
                return applications[0]
            except Exception:
                subprocess.run(
                    ["hdiutil", "detach", str(self.mount)],
                    capture_output=True,
                    text=True,
                    check=False,
                )
                self.attached = False
                self.temp.cleanup()
                raise

        def __exit__(self, exc_type, exc_value, traceback) -> None:
            if self.attached:
                result = subprocess.run(
                    ["hdiutil", "detach", str(self.mount)],
                    capture_output=True,
                    text=True,
                    check=False,
                )
                if result.returncode != 0 and exc_type is None:
                    raise ProofError("failed to detach proof DMG")
            self.temp.cleanup()

    return MountedApplication()


def pending_checks() -> dict[str, dict[str, str]]:
    checks = {
        "artifact_release_binding": {"status": "pending"},
        "notarization_and_gatekeeper": {"status": "pending"},
        "packaged_installed_bundle_match": {"status": "pending"},
        "packaged_legal_and_icon_binding": {"status": "pending"},
        "packaged_effectd_initialize_health": {"status": "pending"},
        "installed_effectd_initialize_health": {"status": "pending"},
        "identity_candidate_admission": {"status": "pending"},
        "full_auto_candidate_assurance": {"status": "pending"},
        "manual_evidence_binding": {"status": "pending"},
        "network_capture_binding": {"status": "pending"},
        "install_lifecycle_binding": {"status": "pending"},
        "owner_observation": {"status": "pending"},
        "independent_verification": {"status": "pending"},
    }
    checks.update({name: {"status": "pending"} for name in MANUAL_CHECKS})
    return checks


def write_proof(
    output_dir: Path,
    status: str,
    checks: dict[str, dict[str, str]],
    blockers: list[str],
    paths: dict[str, Path],
    candidate_digest: str | None,
) -> None:
    output_dir.mkdir(parents=True, exist_ok=True)
    proof = {
        "schema": "openagents.omega.installed-proof.v2",
        "schema_version": 2,
        "status": status,
        "product": EXPECTED_PRODUCT,
        "version": EXPECTED_VERSION,
        "candidate_digest": candidate_digest,
        "paths": {name: str(path.resolve()) for name, path in paths.items()},
        "checks": checks,
        "blockers": blockers,
    }
    (output_dir / "installed-proof.json").write_text(
        json.dumps(proof, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )
    notes = [
        "# Omega RC installed proof",
        "",
        f"- status: `{status}`",
        f"- candidate digest: `{candidate_digest or 'pending'}`",
        "",
    ]
    if blockers:
        notes.extend(["## Blockers", "", *(f"- {blocker}" for blocker in blockers), ""])
    notes.extend(["## Gate status", ""])
    notes.extend(f"- {name}: `{check['status']}`" for name, check in checks.items())
    notes.append("")
    (output_dir / "NOTES.md").write_text("\n".join(notes), encoding="utf-8")


def prove(arguments: argparse.Namespace) -> int:
    arguments.out.mkdir(parents=True, exist_ok=True)
    paths = {
        "release_record": arguments.release_record,
        "artifact": arguments.artifact,
        "installed_app": arguments.app,
        "identity_evidence": arguments.identity_evidence,
        "full_auto_evidence": arguments.full_auto_evidence,
        "manual_evidence": arguments.manual_evidence,
        "network_evidence": arguments.network_evidence,
        "lifecycle_evidence": arguments.lifecycle_evidence,
    }
    checks = pending_checks()
    blockers: list[str] = []
    candidate_digest: str | None = None
    for name, path in paths.items():
        expected = path.is_dir() if name == "installed_app" else path.is_file()
        if not expected:
            blockers.append(f"missing {name.replace('_', ' ')}: {path}")
            if name in ("release_record", "artifact"):
                checks["artifact_release_binding"] = {"status": "blocked"}
            elif name == "installed_app":
                checks["packaged_installed_bundle_match"] = {"status": "blocked"}
            elif name == "identity_evidence":
                checks["identity_candidate_admission"] = {"status": "blocked"}
            elif name == "full_auto_evidence":
                checks["full_auto_candidate_assurance"] = {"status": "blocked"}
            elif name == "manual_evidence":
                checks["manual_evidence_binding"] = {"status": "blocked"}
            elif name == "network_evidence":
                checks["network_capture_binding"] = {"status": "blocked"}
            elif name == "lifecycle_evidence":
                checks["install_lifecycle_binding"] = {"status": "blocked"}
    core_paths = ("release_record", "artifact", "installed_app")
    if any(
        not (
            paths[name].is_dir()
            if name == "installed_app"
            else paths[name].is_file()
        )
        for name in core_paths
    ):
        write_proof(arguments.out, "incomplete", checks, blockers, paths, candidate_digest)
        return 1

    try:
        record = load_json(arguments.release_record, "release record")
        validate_release_record(record, arguments.release_record, arguments.artifact)
        checks["artifact_release_binding"] = {"status": "passed"}
    except ProofError as error:
        blockers.append(str(error))
        checks["artifact_release_binding"] = {"status": "blocked", "reason": str(error)}
        write_proof(arguments.out, "incomplete", checks, blockers, paths, candidate_digest)
        return 1

    try:
        verify_signature(arguments.artifact, arguments.out, "dmg")
        run(
            ["xcrun", "stapler", "validate", str(arguments.artifact)],
            description="DMG staple validation",
        )
        verify_signature(arguments.app, arguments.out, "installed-app")
        gatekeeper = run(
            ["spctl", "--assess", "--type", "execute", "--verbose=4", str(arguments.app)],
            description="installed app Gatekeeper assessment",
        )
        (arguments.out / "spctl-installed-app.txt").write_text(gatekeeper + "\n", encoding="utf-8")
        checks["notarization_and_gatekeeper"] = {"status": "passed"}
    except ProofError as error:
        blockers.append(str(error))
        checks["notarization_and_gatekeeper"] = {"status": "blocked", "reason": str(error)}

    try:
        with mounted_application(arguments.artifact) as packaged_app:
            verify_signature(packaged_app, arguments.out, "packaged-app")
            validate_app_metadata(packaged_app, record)
            validate_binary_digests(packaged_app, record)
            validate_app_metadata(arguments.app, record)
            validate_binary_digests(arguments.app, record)
            verify_signature(
                packaged_app / "Contents/MacOS/omega-identity-proof",
                arguments.out,
                "packaged-identity-proof-driver",
            )
            verify_signature(
                arguments.app / "Contents/MacOS/omega-identity-proof",
                arguments.out,
                "installed-identity-proof-driver",
            )
            if bundle_manifest(packaged_app) != bundle_manifest(arguments.app):
                raise ProofError("installed Omega.app differs from the signed DMG application tree")
        checks["packaged_installed_bundle_match"] = {"status": "passed"}
    except ProofError as error:
        blockers.append(str(error))
        checks["packaged_installed_bundle_match"] = {"status": "blocked", "reason": str(error)}

    try:
        with mounted_application(arguments.artifact) as packaged_app:
            validate_packaged_legal_and_icons(packaged_app, arguments.app, record)
        checks["packaged_legal_and_icon_binding"] = {"status": "passed"}
    except ProofError as error:
        blockers.append(str(error))
        checks["packaged_legal_and_icon_binding"] = {
            "status": "blocked",
            "reason": str(error),
        }

    try:
        with mounted_application(arguments.artifact) as packaged_app:
            validate_effectd_component(packaged_app, record, arguments.out, "packaged-app")
        checks["packaged_effectd_initialize_health"] = {"status": "passed"}
    except ProofError as error:
        blockers.append(str(error))
        checks["packaged_effectd_initialize_health"] = {
            "status": "blocked",
            "reason": str(error),
        }

    try:
        validate_effectd_component(arguments.app, record, arguments.out, "installed-app")
        checks["installed_effectd_initialize_health"] = {"status": "passed"}
    except ProofError as error:
        blockers.append(str(error))
        checks["installed_effectd_initialize_health"] = {
            "status": "blocked",
            "reason": str(error),
        }

    identity_owner: str | None = None
    identity_independent: str | None = None
    if arguments.identity_evidence.is_file():
        try:
            evidence = load_json(arguments.identity_evidence, "identity candidate evidence")
            candidate_digest = validate_identity_evidence_binding(
                evidence, record, arguments.release_record, arguments.artifact
            )
            _, identity_owner, identity_independent = validate_identity_evidence(
                evidence, record, arguments.release_record, arguments.artifact
            )
            checks["identity_candidate_admission"] = {"status": "passed"}
        except ProofError as error:
            blockers.append(str(error))
            checks["identity_candidate_admission"] = {"status": "blocked", "reason": str(error)}

    if (
        arguments.manual_evidence.is_file()
        and identity_owner
        and identity_independent
        and candidate_digest
    ):
        try:
            manual = load_json(arguments.manual_evidence, "installed brand evidence")
            validate_manual_evidence(
                manual, candidate_digest, identity_owner, identity_independent
            )
            checks["manual_evidence_binding"] = {"status": "passed"}
            for name in MANUAL_CHECKS:
                checks[name] = {"status": "passed", "evidence": manual["checks"][name]["evidence"]}
            checks["owner_observation"] = {
                "status": "passed",
                "attestor": manual["owner_observation"]["attestor"],
                "evidence": manual["owner_observation"]["evidence"],
            }
            checks["independent_verification"] = {
                "status": "passed",
                "attestor": manual["independent_verification"]["attestor"],
                "evidence": manual["independent_verification"]["evidence"],
            }
        except ProofError as error:
            blockers.append(str(error))
            checks["manual_evidence_binding"] = {"status": "blocked", "reason": str(error)}

    if arguments.network_evidence.is_file() and candidate_digest:
        try:
            validate_network_evidence(arguments.network_evidence, candidate_digest)
            checks["network_capture_binding"] = {"status": "passed"}
        except ProofError as error:
            blockers.append(str(error))
            checks["network_capture_binding"] = {
                "status": "blocked",
                "reason": str(error),
            }

    if arguments.lifecycle_evidence.is_file() and candidate_digest:
        try:
            validate_lifecycle_evidence(
                arguments.lifecycle_evidence,
                candidate_digest,
                arguments.release_record,
                arguments.artifact,
            )
            checks["install_lifecycle_binding"] = {"status": "passed"}
        except ProofError as error:
            blockers.append(str(error))
            checks["install_lifecycle_binding"] = {
                "status": "blocked",
                "reason": str(error),
            }

    if arguments.full_auto_evidence.is_file() and candidate_digest and identity_owner:
        try:
            full_auto = load_json(arguments.full_auto_evidence, "Full Auto candidate evidence")
            full_auto_owner, full_auto_independent = validate_full_auto_evidence(
                full_auto,
                record,
                arguments.release_record,
                arguments.artifact,
                candidate_digest,
                identity_owner,
            )
            checks["full_auto_candidate_assurance"] = {
                "status": "passed",
                "owner": full_auto_owner,
                "independent": full_auto_independent,
            }
        except ProofError as error:
            blockers.append(str(error))
            checks["full_auto_candidate_assurance"] = {
                "status": "blocked",
                "reason": str(error),
            }

    status = "complete" if not blockers and all(
        check.get("status") == "passed" for check in checks.values()
    ) else "incomplete"
    if status != "complete" and not blockers:
        blockers.append("one or more required gates remain pending")
    write_proof(arguments.out, status, checks, blockers, paths, candidate_digest)
    return 0 if status == "complete" else 1


def self_test() -> None:
    with tempfile.TemporaryDirectory(prefix="omega-proof-self-test-") as directory:
        root = Path(directory)
        artifact = root / "Omega-v0.2.0-rc2-macos-arm64.dmg"
        artifact.write_bytes(b"signed candidate bytes")
        record_path = root / "release.json"
        record = {
