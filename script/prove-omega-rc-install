                "kind": "comparison",
                "scope": "omega",
                "status": "passed",
                "changed_roots": [],
                "before_snapshot_sha256": sha256_file(snapshots["before_snapshot"]),
                "after_snapshot_sha256": sha256_file(snapshots["after_reinstall_snapshot"]),
            },
            "app_removal": {
                "kind": "app_removal",
                "source_path": str(DEFAULT_APP),
                "recoverable": True,
                "zed_targets_touched": False,
            },
            "app_reinstall": {
                "kind": "app_reinstall",
                "installed_path": str(DEFAULT_APP),
                "artifact_sha256": sha256_file(artifact),
                "release_record_sha256": sha256_file(record_path),
                "zed_targets_touched": False,
            },
        }
        lifecycle_paths = dict(snapshots)
        for name, value in lifecycle_values.items():
            receipt_path = lifecycle_root / f"{name}.json"
            receipt_path.write_text(
                json.dumps(
                    {
                        "schema": "openagents.omega.rc-lifecycle-proof.v1",
                        "candidate_digest": candidate_digest,
                        **value,
                    }
                ),
                encoding="utf-8",
            )
            lifecycle_paths[name] = receipt_path
        lifecycle_manifest = lifecycle_root / "manifest.json"
        lifecycle = {
            "schema": "openagents.omega.installed-lifecycle-evidence.v1",
            "status": "passed",
            "candidate_digest": candidate_digest,
            "artifact_sha256": sha256_file(artifact),
            "release_record_sha256": sha256_file(record_path),
            "receipts": {
                name: {
                    "path": receipt_path.name,
                    "sha256": sha256_file(receipt_path),
                }
                for name, receipt_path in lifecycle_paths.items()
            },
        }
        lifecycle_manifest.write_text(json.dumps(lifecycle), encoding="utf-8")
        validate_lifecycle_evidence(
            lifecycle_manifest, candidate_digest, record_path, artifact
        )
        lifecycle["receipts"]["app_reinstall"]["sha256"] = "0" * 64
        lifecycle_manifest.write_text(json.dumps(lifecycle), encoding="utf-8")
        try:
            validate_lifecycle_evidence(
                lifecycle_manifest, candidate_digest, record_path, artifact
            )
        except ProofError:
            pass
        else:
            raise ProofError("self-test accepted a forged lifecycle receipt")

        tampered = dict(record)
        tampered["digests"] = {"package_sha256": "0" * 64}
        try:
            validate_release_record(tampered, record_path, artifact)
        except ProofError:
            pass
        else:
            raise ProofError("self-test accepted a tampered artifact digest")

        stale_candidate = json.loads(json.dumps(record))
        stale_candidate["version"] = "0.2.0-rc1"
        stale_candidate["publication"]["tag"] = "v0.2.0-rc1"
        try:
            validate_release_record(stale_candidate, record_path, artifact)
        except ProofError:
            pass
        else:
            raise ProofError("self-test accepted the withdrawn rc1 candidate")

        packaged = root / "packaged.app"
        installed = root / "installed.app"
        for app in (packaged, installed):
            (app / "Contents/Resources").mkdir(parents=True)
            (app / "Contents/Resources/brand.txt").write_text("Omega", encoding="utf-8")
        if bundle_manifest(packaged) != bundle_manifest(installed):
            raise ProofError("self-test equal bundles did not compare equal")
        (installed / "Contents/Resources/brand.txt").write_text("Zed", encoding="utf-8")
        if bundle_manifest(packaged) == bundle_manifest(installed):
            raise ProofError("self-test accepted a tampered installed resource")

        component = root / "effectd"
        (component / "bin").mkdir(parents=True)
        (component / "runtime/bin").mkdir(parents=True)
        wrapper = component / "bin/omega-effectd"
        signed_node = component / "runtime/bin/node"
        wrapper.write_bytes(b"verified wrapper")
        signed_node.write_bytes(b"source node plus a Developer ID signature")
        source_node_digest = hashlib.sha256(b"pristine source node").hexdigest()
        manifest = {
            "node": {"binarySha256": source_node_digest},
            "files": {
                "bin/omega-effectd": sha256_file(wrapper),
                "runtime/bin/node": source_node_digest,
            },
        }
        effectd = {
            "source_node_sha256": source_node_digest,
            "packaged_node_sha256": sha256_file(signed_node),
        }
        validate_effectd_file_digests(component, manifest, effectd, "self-test")
        wrapper.write_bytes(b"tampered wrapper")
        try:
            validate_effectd_file_digests(component, manifest, effectd, "self-test")
        except ProofError:
            pass
        else:
            raise ProofError("self-test accepted a tampered non-Node component file")
        wrapper.write_bytes(b"verified wrapper")
        mismatched_effectd = dict(effectd)
        mismatched_effectd["source_node_sha256"] = "0" * 64
        try:
            validate_effectd_file_digests(
                component, manifest, mismatched_effectd, "self-test"
            )
        except ProofError:
            pass
        else:
            raise ProofError("self-test accepted a mismatched source Node pin")

        entitlement_fixture = plistlib.dumps(
            {
                "com.apple.security.cs.allow-jit": True,
                "com.apple.security.cs.allow-unsigned-executable-memory": True,
            }
        ).decode("utf-8")
        parsed_entitlements = parse_codesign_entitlements(
            f"{entitlement_fixture}\nExecutable=/fixture/node", "self-test"
        )
        if parsed_entitlements.get("com.apple.security.cs.allow-jit") is not True:
            raise ProofError("self-test failed to isolate codesign entitlement XML")

        manual = {
            "schema": "openagents.omega.installed-brand-evidence.v1",
            "candidate_digest": "b" * 64,
            "checks": {
                name: {"status": "passed", "evidence": f"receipt:{name}"}
                for name in MANUAL_CHECKS
            },
            "owner_observation": {
                "status": "passed",
                "attestor": "Owner",
                "observed_at": "2026-07-24T12:00:00Z",
                "evidence": "receipt:owner",
            },
            "independent_verification": {
                "status": "passed",
                "attestor": "Reviewer",
                "observed_at": "2026-07-24T12:01:00Z",
                "evidence": "receipt:reviewer",
            },
        }
        validate_manual_evidence(manual, "b" * 64, "Owner", "Reviewer")
        manual["checks"][MANUAL_CHECKS[0]]["status"] = "pending"
        try:
            validate_manual_evidence(manual, "b" * 64, "Owner", "Reviewer")
        except ProofError:
            pass
        else:
            raise ProofError("self-test accepted pending manual evidence")

        checks = pending_checks()
        checks["artifact_release_binding"] = {"status": "passed"}
        if all(check.get("status") == "passed" for check in checks.values()):
            raise ProofError("self-test allowed automated checks to imply complete")

    print("Omega installed-proof harness self-test passed")


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser()
    parser.add_argument("--harness-check", action="store_true")
    parser.add_argument("--self-test", action="store_true")
    parser.add_argument("--release-record", type=Path)
    parser.add_argument("--artifact", type=Path)
    parser.add_argument("--app", type=Path, default=DEFAULT_APP)
    parser.add_argument("--identity-evidence", type=Path)
    parser.add_argument("--full-auto-evidence", type=Path)
    parser.add_argument("--manual-evidence", type=Path)
    parser.add_argument("--network-evidence", type=Path)
    parser.add_argument("--lifecycle-evidence", type=Path)
    parser.add_argument("--out", type=Path, default=DEFAULT_OUTPUT)
    arguments = parser.parse_args()
    if arguments.self_test or arguments.harness_check:
        return arguments
    missing = [
        option
        for option in (
            "release_record",
            "artifact",
            "identity_evidence",
            "full_auto_evidence",
            "manual_evidence",
            "network_evidence",
            "lifecycle_evidence",
        )
        if getattr(arguments, option) is None
    ]
    if missing:
        options = ", ".join(f"--{name.replace('_', '-')}" for name in missing)
        parser.error(f"prove mode requires {options}")
    return arguments


def main() -> int:
    arguments = parse_arguments()
    try:
        if arguments.self_test:
            self_test()
            return 0
        if arguments.harness_check:
            self_test()
            if not (ROOT / "docs/src/development/omega-rc-installed-proof.md").is_file():
                raise ProofError("installed-proof documentation is missing")
            if "omega-rc-installed-proof.md" not in (ROOT / "docs/src/SUMMARY.md").read_text():
                raise ProofError("documentation summary link is missing")
            checks = pending_checks()
            write_proof(arguments.out, "harness_ok", checks, [], {}, None)
            print(f"Harness OK: {arguments.out / 'installed-proof.json'}")
            return 0
        return prove(arguments)
    except ProofError as error:
        print(f"error: {error}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    sys.exit(main())
