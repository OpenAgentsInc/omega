                    "wrapper_sha256": "d" * 64,
                    "bundle_sha256": "e" * 64,
                    "source_node_sha256": "f" * 64,
                    "packaged_node_sha256": "1" * 64,
                }
            },
            "notarization": {"attempted": True, "stapled": True},
            "legal": {
                "commercial_terms_attached": False,
                "notices": {
                    "LICENSE-GPL": "c" * 64,
                    "LICENSE-APACHE": "d" * 64,
                    "licenses.md": "e" * 64,
                },
            },
            "publication": {
                "repository": "OpenAgentsInc/omega",
                "tag": f"v{EXPECTED_VERSION}",
                "prerelease": True,
                "latest": False,
            },
        }
        record_path.write_text(json.dumps(record), encoding="utf-8")
        validate_release_record(record, record_path, artifact)

        candidate = {
            "omega": {
                "repository": "https://github.com/OpenAgentsInc/omega",
                "commit": "a" * 40,
                "dirty": False,
            },
            "identity_contract": {
                "version": 1,
                "source_path": "crates/omega_identity/src/contract.rs",
                "source_sha256": "3" * 64,
            },
            "public_vector": {
                "version": 1,
                "path": "crates/omega_identity/fixtures/omega_nostr_identity_v1.json",
                "sha256": "4" * 64,
            },
            "reviewed_source": {
                "repository": "https://github.com/OpenAgentsInc/buzz",
                "commit": "b" * 40,
            },
            "assurance_spec_admission": EXPECTED_ASSURANCE_BINDING,
            "packages": [
                {"name": name, "version": "1.0.0", "cargo_checksum": "5" * 64}
                for name in ("atomic-write-file", "keyring", "nostr")
            ],
            "build_cargo_lock": {
                "name": "Cargo.lock.omega-v0.2.0-rc2",
                "sha256": "6" * 64,
            },
            "artifact": {
                "name": artifact.name,
                "version": EXPECTED_VERSION,
                "sha256": sha256_file(artifact),
                "release_record_sha256": sha256_file(record_path),
                "packaged_app": {
                    "application_name": "Omega",
                    "bundle_identifier": EXPECTED_BUNDLE_ID,
