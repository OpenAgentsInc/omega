            },
            "automated_tripwires": {
                "verifier_path": "script/verify-omega-identity",
                "verifier_script_sha256": "9" * 64,
                "source_verification": "passed",
                "packaged_boundary_scan": "passed",
                "packaged_forbidden_literals": ["BUZZ_PRIVATE_KEY", "identity.key", "get_nsec"],
                "fresh_mounted_app_scan": {
                    "status": "passed",
                    "forbidden_literals": ["BUZZ_PRIVATE_KEY", "identity.key", "get_nsec"],
                    "matches": {},
                    "scope": "self-test",
                },
                "scope": "self-test",
            },
        }
        candidate_digest = hashlib.sha256(
            json.dumps(candidate, sort_keys=True, separators=(",", ":")).encode("utf-8")
        ).hexdigest()
        identity = {
            "schema": "openagents.omega.identity-candidate-evidence.v1",
            "schema_version": 1,
            "status": "admitted",
            "candidate_admitted": True,
            "candidate": candidate,
            "candidate_digest": {
                "algorithm": "sha256",
                "canonicalization": "self-test canonical JSON",
                "value": candidate_digest,
            },
            "gates": {
                name: {
                    "status": "passed",
                    "attestor": "Reviewer" if name == "independent_verification" else "Owner",
                    "observed_at": "2026-07-24T12:00:00Z",
                    "evidence": {f"self-test evidence for {name}": "sha256:" + "2" * 64},
                    "required_evidence": [f"self-test evidence for {name}"],
