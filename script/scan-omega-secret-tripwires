#!/usr/bin/env python3
"""Scan installed-proof surfaces without revealing the secret or matching paths."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import stat
import sys
import tempfile
import re
from dataclasses import dataclass
from datetime import datetime, timezone
from pathlib import Path

CHUNK_SIZE = 1024 * 1024
MINIMUM_NEEDLE_BYTES = 16
MAXIMUM_NEEDLE_BYTES = 4096


@dataclass
class SurfaceResult:
    name: str
    path_digest: str
    status: str
    files_scanned: int = 0
    symlinks_skipped: int = 0
    bytes_scanned: int = 0
    errors: int = 0
    match_detected: bool = False
    evidence_digest: str = ""

    def as_dict(self) -> dict[str, object]:
        return {
            "name": self.name,
            "path_digest": self.path_digest,
            "status": self.status,
            "files_scanned": self.files_scanned,
            "symlinks_skipped": self.symlinks_skipped,
            "bytes_scanned": self.bytes_scanned,
            "errors": self.errors,
            "match_detected": self.match_detected,
            "evidence_digest": self.evidence_digest,
        }


def digest_text(value: str) -> str:
    return hashlib.sha256(value.encode("utf-8", errors="surrogateescape")).hexdigest()


def read_needle(file_descriptor: int) -> bytes:
    chunks: list[bytes] = []
    remaining = MAXIMUM_NEEDLE_BYTES + 2
    while remaining > 0:
        chunk = os.read(file_descriptor, remaining)
        if not chunk:
            break
        chunks.append(chunk)
        remaining -= len(chunk)
    needle = b"".join(chunks).rstrip(b"\r\n")
    if not MINIMUM_NEEDLE_BYTES <= len(needle) <= MAXIMUM_NEEDLE_BYTES:
        raise ValueError(
            f"canary must contain {MINIMUM_NEEDLE_BYTES}..{MAXIMUM_NEEDLE_BYTES} bytes"
        )
    return needle


def scan_file(path: Path, needle: bytes) -> tuple[bool, int, str, int, int]:
    content_digest = hashlib.sha256()
    matched = False
    bytes_scanned = 0
    overlap = b""
    file_descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW)
    metadata = os.fstat(file_descriptor)
    if not stat.S_ISREG(metadata.st_mode):
        os.close(file_descriptor)
        raise OSError("surface entry is not a regular file")
    with os.fdopen(file_descriptor, "rb") as handle:
        while True:
            chunk = handle.read(CHUNK_SIZE)
            if not chunk:
                break
            bytes_scanned += len(chunk)
            content_digest.update(chunk)
            if needle in overlap + chunk:
                matched = True
            overlap = (overlap + chunk)[-(len(needle) - 1) :]
    return (
        matched,
        bytes_scanned,
        content_digest.hexdigest(),
        stat.S_IMODE(metadata.st_mode),
        metadata.st_size,
    )


def surface_files(root: Path) -> tuple[list[Path], int]:
    root_metadata = root.lstat()
    if stat.S_ISLNK(root_metadata.st_mode):
        return [], 1
    if stat.S_ISREG(root_metadata.st_mode):
        return [root], 0
    if not stat.S_ISDIR(root_metadata.st_mode):
        return [], 0

    files: list[Path] = []
    skipped_symlinks = 0
    for directory, directory_names, file_names in os.walk(root, followlinks=False):
        directory_path = Path(directory)
        retained_directories: list[str] = []
        for directory_name in directory_names:
            candidate = directory_path / directory_name
            if candidate.is_symlink():
                skipped_symlinks += 1
            else:
                retained_directories.append(directory_name)
        directory_names[:] = retained_directories
        for file_name in file_names:
            candidate = directory_path / file_name
            if candidate.is_symlink():
                skipped_symlinks += 1
            else:
                files.append(candidate)
    return sorted(files, key=lambda path: os.fsencode(path)), skipped_symlinks


def scan_surface(name: str, root: Path, needle: bytes) -> SurfaceResult:
    result = SurfaceResult(
        name=name,
        path_digest=digest_text(os.fspath(root.resolve(strict=False))),
        status="pass",
    )
    if not root.exists() and not root.is_symlink():
        result.status = "absent"
        result.evidence_digest = hashlib.sha256(b"absent").hexdigest()
        return result

    evidence_digest = hashlib.sha256()
    try:
        files, result.symlinks_skipped = surface_files(root)
        for path in files:
            try:
                matched, bytes_scanned, file_digest, file_mode, file_size = scan_file(path, needle)
                result.files_scanned += 1
                result.bytes_scanned += bytes_scanned
                result.match_detected = result.match_detected or matched
                relative = path.name if root.is_file() else os.fspath(path.relative_to(root))
                evidence_digest.update(digest_text(relative).encode())
                evidence_digest.update(str(file_mode).encode())
                evidence_digest.update(str(file_size).encode())
                evidence_digest.update(file_digest.encode())
            except (OSError, ValueError):
                result.errors += 1
    except OSError:
        result.errors += 1

    if result.errors:
        result.status = "error"
    elif result.match_detected:
        result.status = "match"
    result.evidence_digest = evidence_digest.hexdigest()
    return result


def parse_surface(value: str) -> tuple[str, Path]:
    name, separator, raw_path = value.partition("=")
    if not separator or not name or not raw_path:
        raise argparse.ArgumentTypeError("surface must be NAME=PATH")
    if not all(character.isalnum() or character in "_-" for character in name):
        raise argparse.ArgumentTypeError("surface name must be alphanumeric, '_' or '-'")
    return name, Path(raw_path).expanduser()


def validate_candidate_digest(value: str) -> str:
    if re.fullmatch(r"[0-9a-f]{64}", value) is None:
        raise ValueError("candidate digest must be 64 lowercase hexadecimal characters")
    return value


def build_report(
    surfaces: list[tuple[str, Path]], needle: bytes, candidate_digest: str
) -> dict[str, object]:
    names = [name for name, _ in surfaces]
    if len(names) != len(set(names)):
        raise ValueError("surface names must be unique")
    results = [scan_surface(name, path, needle) for name, path in surfaces]
    overall_status = "pass"
    if any(result.status == "error" for result in results):
        overall_status = "error"
    elif any(result.match_detected for result in results):
        overall_status = "match"
    return {
        "schema": "openagents.omega.installed-secret-tripwires.v1",
        "candidate_digest": validate_candidate_digest(candidate_digest),
        "generated_at": datetime.now(timezone.utc).isoformat(),
        "status": overall_status,
        "needle": {
            "source": "protected_file_descriptor",
            "length": len(needle),
            "value_recorded": False,
        },
        "surfaces": [result.as_dict() for result in results],
    }


def self_test() -> int:
    needle = b"nsec1-disposable-proof-canary-0001"
    with tempfile.TemporaryDirectory() as directory:
        root = Path(directory)
        (root / "clean").write_bytes(b"public evidence only")
        (root / "match").write_bytes(b"prefix" + needle + b"suffix")
        os.symlink(root / "match", root / "skipped-link")
        report = build_report(
            [("clean", root / "clean"), ("leak", root / "match"), ("missing", root / "none")],
            needle,
            "a" * 64,
        )
        results = {result["name"]: result for result in report["surfaces"]}
        assert report["status"] == "match"
        assert results["clean"]["status"] == "pass"
        assert results["leak"]["status"] == "match"
        assert results["missing"]["status"] == "absent"
        linked = scan_surface("linked", root / "skipped-link", needle)
        assert linked.status == "pass"
        assert linked.symlinks_skipped == 1
        assert not linked.match_detected
    print("secret-tripwire scanner self-test passed")
    return 0


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--needle-fd", type=int, default=0)
    parser.add_argument("--candidate-digest")
    parser.add_argument("--surface", action="append", type=parse_surface, default=[])
    parser.add_argument("--output", type=Path)
    parser.add_argument("--self-test", action="store_true")
    arguments = parser.parse_args()
    if arguments.self_test:
        return self_test()
    if arguments.candidate_digest is None:
        parser.error("--candidate-digest is required")
    if not arguments.surface:
        parser.error("at least one --surface NAME=PATH is required")
    try:
        needle = read_needle(arguments.needle_fd)
        report = build_report(arguments.surface, needle, arguments.candidate_digest)
    except (OSError, ValueError) as error:
        print(f"error: {error}", file=sys.stderr)
        return 2
    serialized = json.dumps(report, indent=2, sort_keys=True) + "\n"
    if arguments.output:
        with arguments.output.open("x", encoding="utf-8") as output:
            output.write(serialized)
        print(f"wrote {arguments.output}")
    else:
        sys.stdout.write(serialized)
    if report["status"] == "match":
        return 1
    if report["status"] == "error":
        return 2
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
