#!/usr/bin/env python3

from __future__ import annotations

import argparse
import json
import sys
from pathlib import Path

from omega_identity_evidence import (
    IdentityEvidenceError,
    self_test,
    validate_recovery_evidence,
)


def parse_arguments() -> argparse.Namespace:
    parser = argparse.ArgumentParser(
        description="Validate candidate-bound Omega identity recovery evidence"
    )
    parser.add_argument("--input", type=Path)
    parser.add_argument("--candidate-digest")
    parser.add_argument("--candidate-artifact-sha256")
    parser.add_argument("--candidate-binary-sha256")
    parser.add_argument("--evidence-root", type=Path)
    parser.add_argument("--self-test", action="store_true")
    return parser.parse_args()


def main() -> int:
    arguments = parse_arguments()
    try:
        inputs = (
            arguments.input,
            arguments.candidate_digest,
            arguments.candidate_artifact_sha256,
            arguments.candidate_binary_sha256,
            arguments.evidence_root,
        )
        if arguments.self_test:
            if any(value is not None for value in inputs):
                raise IdentityEvidenceError(
                    "--self-test does not accept recovery evidence inputs"
                )
            self_test()
            return 0
        if any(value is None for value in inputs):
            raise IdentityEvidenceError(
                "--input, --candidate-digest, --candidate-artifact-sha256, "
                "--candidate-binary-sha256, and --evidence-root are required"
            )
        digest = validate_recovery_evidence(
            arguments.input.absolute(),
            arguments.candidate_digest,
            arguments.candidate_artifact_sha256,
            arguments.candidate_binary_sha256,
            arguments.evidence_root.absolute(),
        )
        print(
            json.dumps(
                {
                    "schema": "openagents.omega.identity-recovery-evidence-validation.v1",
                    "status": "passed",
                    "receipt_sha256": digest,
                },
                sort_keys=True,
            )
        )
        return 0
    except (IdentityEvidenceError, OSError) as error:
        print(
            json.dumps(
                {
                    "schema": "openagents.omega.identity-recovery-evidence-validation.v1",
                    "status": "failed",
                    "reason": str(error),
                },
                sort_keys=True,
            ),
            file=sys.stderr,
        )
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
