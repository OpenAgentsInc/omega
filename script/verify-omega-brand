#!/usr/bin/env bash
#
# Omega brand gate (OMEGA-DELTA-0017, OMEGA-DELTA-0018, OMEGA-DELTA-0022,
# OMEGA-DELTA-0031).
#
# Two modes:
#
#   verify-omega-brand                 source tree
#   verify-omega-brand --app PATH      a built Omega.app, before signing
#
# The packaged mode exists because a source-level check is not a packaging
# check. 0.2.0-rc10 shipped thirteen Zed strings in a signed Info.plist and
# three Zed logo marks in the status bar while every brand check on omega#16
# passed, because those checks scanned the executable for three identity
# literals and nothing had ever read Info.plist or looked at an asset.
#
# OMEGA-DELTA-0022 widened the inventories after 0.2.0-rc11 shipped Zed
# artwork out of assets/images/ and a user-facing `zed:` command namespace,
# both of which were outside OMEGA-DELTA-0018's scope while it reported green
# about assets/icons/. The inventories here are derived from what decides what
# ships -- the assets tree, the enums that name a path into it, and every gpui
# action declaration -- rather than from a list of remembered places.
#
# OMEGA-DELTA-0031 closes the class OMEGA-DELTA-0022 named and could not
# close: arbitrary user-facing prose. The previous string rule enforced the
# compatibility allow-list's `blocked` claims, which is a written-down
# denylist, so a NEW sentence naming Zed as the product passed until somebody
# added it. This one inverts the default -- every brand-bearing prose literal
# in a derived inventory must be classified in the policy, and an unclassified
# one fails.
#
# Policy lives in script/omega-brand-gate.json and is shared with
# crates/omega_deltas so the source and packaged sides cannot drift.

set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
repository_root="${OMEGA_BRAND_VERIFY_ROOT:-$(cd "${script_dir}/.." && pwd)}"

APP_PATH=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --app)
      APP_PATH="${2:-}"
      if [[ -z "${APP_PATH}" ]]; then
        echo "error: --app needs a path to an Omega.app bundle." >&2
        exit 2
      fi
      shift
      ;;
    -h|--help)
      echo "Usage: ${0##*/} [--app PATH_TO_OMEGA_APP]"
      exit 0
      ;;
    *)
      echo "error: unknown argument: $1" >&2
      exit 2
      ;;
  esac
  shift
done

python3 - "${repository_root}" "${APP_PATH}" <<'PY'
from __future__ import annotations

import functools
import hashlib
import json
import plistlib
import re
import sys
from pathlib import Path

ROOT = Path(sys.argv[1]).resolve()
APP = Path(sys.argv[2]).resolve() if sys.argv[2] else None

POLICY = json.loads((ROOT / "script/omega-brand-gate.json").read_text(encoding="utf-8"))
WORDS = POLICY["brand"]["words"]
SUBSTRINGS = [value.lower() for value in POLICY["brand"]["substrings"]]
ICONS = POLICY["icons"]
EMBEDDED = POLICY["embedded_assets"]
ENUMS = POLICY["asset_name_enums"]
ACTIONS = POLICY["actions"]
PROSE = POLICY["prose"]
ALLOWED_STEMS = set(ICONS["third_party_allowances"])
STEM_TOKENS = [token.lower() for token in ICONS["forbidden_stem_tokens"]]
VARIANT_TOKENS = ICONS["forbidden_variant_tokens"]
REVIEWED_MARKS = ICONS["reviewed_marks"]

failures: list[str] = []


def fail(message: str) -> None:
    failures.append(message)


def brand_hits(text: str) -> list[str]:
    """Competitor brand names in `text`.

    Words match case-sensitively at ASCII alphanumeric boundaries so that
    'authorized' and 'normalized' are not reported, which is what a lowercase
    substring rule would do. Substrings match case-insensitively.
    """
    hits: list[str] = []
    for word in WORDS:
        for match in re.finditer(re.escape(word), text):
            before = text[match.start() - 1] if match.start() else ""
            after = text[match.end()] if match.end() < len(text) else ""
            if before.isalnum() or after.isalnum():
                continue
            hits.append(word)
            break
    lowered = text.lower()
    hits.extend(substring for substring in SUBSTRINGS if substring in lowered)
    return hits


def stem_is_forbidden(stem: str) -> bool:
    if stem in ALLOWED_STEMS:
        return False
    lowered = stem.lower()
    return any(token in lowered for token in STEM_TOKENS)


# ---------------------------------------------------------------- source mode


def check_info_plist_fragments() -> None:
    """OMEGA-DELTA-0017, source side.

    Every file in the fragment directory is merged into Info.plist by
    cargo-bundle, so the directory is walked rather than a list of known
    files, and every value is read rather than a list of known keys. A new
    key carrying a competitor's name is caught the same as a known one.
    """
    directory = ROOT / POLICY["info_plist"]["fragment_dir"]
    if not directory.is_dir():
        fail(f"info plist fragment directory is missing: {directory}")
        return
    fragments = sorted(path for path in directory.iterdir() if path.is_file())
    if not fragments:
        fail(f"info plist fragment directory is empty: {directory}")
        return
    for path in fragments:
        text = path.read_text(encoding="utf-8", errors="replace")
        # Report the owning key where the fragment gives one, so the failure
        # names the macOS dialog the string would appear in.
        key = None
        for match in re.finditer(r"<key>(.*?)</key>|<string>(.*?)</string>", text, re.S):
            if match.group(1) is not None:
                key = match.group(1).strip()
                continue
            value = match.group(2)
            for hit in brand_hits(value):
                where = f"{path.relative_to(ROOT)}:{key or '<unkeyed>'}"
                fail(f"OMEGA-DELTA-0017: {where} value names {hit!r}: {value.strip()!r}")
        # Belt and braces: catch a brand name in a key, comment or attribute,
        # which the key/value pass above does not read.
        for hit in brand_hits(re.sub(r"<string>.*?</string>", "", text, flags=re.S)):
            fail(
                f"OMEGA-DELTA-0017: {path.relative_to(ROOT)} names {hit!r} "
                "outside a <string> value"
            )


def check_icon_inventory() -> None:
    """OMEGA-DELTA-0018, source side.

    assets/icons and the IconName enum are kept in bijection by the icons
    crate's own tests, so scanning both is a complete inventory of every icon
    that can ship.
    """
    asset_dir = ROOT / ICONS["asset_dir"]
    stems = sorted(path.stem for path in asset_dir.glob("*.svg"))
    if not stems:
        fail(f"icon asset directory is empty: {asset_dir}")
    for stem in stems:
        if stem_is_forbidden(stem):
            fail(
                f"OMEGA-DELTA-0018: {ICONS['asset_dir']}/{stem}.svg carries a "
                "competitor's name. Replace the artwork and the file name, or "
                "record why it identifies somebody else's product in "
                "script/omega-brand-gate.json."
            )

    enum_source = (ROOT / ICONS["enum_source"]).read_text(encoding="utf-8")
    body = re.search(r"pub enum IconName \{\n(.*?)\n\}", enum_source, re.S)
    if body is None:
        fail(f"cannot find the IconName enum in {ICONS['enum_source']}")
        return
    variants = [line.strip().rstrip(",") for line in body.group(1).splitlines() if line.strip()]
    if not variants:
        fail("the IconName enum parsed as empty; this check would be vacuous")
    for variant in variants:
        stem = re.sub(r"(?<!^)(?=[A-Z])", "_", variant).lower()
        if stem in ALLOWED_STEMS:
            continue
        if any(token in variant for token in VARIANT_TOKENS):
            fail(
                f"OMEGA-DELTA-0018: IconName::{variant} carries a competitor's "
                "name. Renaming the file without renaming the variant leaves "
                "the next rebase a name to restore the artwork under."
            )

    for relative, expected in sorted(REVIEWED_MARKS.items()):
        path = ROOT / relative
        if not path.is_file():
            fail(f"OMEGA-DELTA-0018: reviewed Omega mark is missing: {relative}")
            continue
        actual = hashlib.sha256(path.read_bytes()).hexdigest()
        if actual != expected:
            fail(
                f"OMEGA-DELTA-0018: {relative} is not the reviewed artwork "
                f"({actual} != {expected}). A name check cannot see a logo. If "
                "this change is deliberate, look at the rendered icon and "
                "update the pin in script/omega-brand-gate.json."
            )


# ------------------------------------------- OMEGA-DELTA-0022, shared parsers


@functools.lru_cache(maxsize=None)
def rust_sources(root: Path) -> tuple[tuple[Path, str], ...]:
    """Every Rust source under `root`, read once and cached."""
    return tuple(
        (path, path.read_text(encoding="utf-8", errors="replace"))
        for path in sorted(root.rglob("*.rs"))
        if "/target/" not in str(path)
    )


@functools.lru_cache(maxsize=None)
def embed_folders() -> tuple[tuple[str, Path], ...]:
    """Every `#[folder = "..."]` in the repository, as (declaring file, folder).

    rust-embed resolves the path against CARGO_MANIFEST_DIR, so the base is the
    crate root, not the directory the attribute is written in.
    """
    found: list[tuple[str, Path]] = []
    for path, text in rust_sources(ROOT / EMBEDDED["embed_declaration_root"]):
        matches = re.findall(r'#\[folder\s*=\s*"([^"]+)"\]', text)
        if not matches:
            continue
        crate_root = next(
            (parent for parent in path.parents if (parent / "Cargo.toml").is_file()),
            path.parent,
        )
        for folder in matches:
            found.append((str(path.relative_to(ROOT)), (crate_root / folder).resolve()))
    return tuple(found)


@functools.lru_cache(maxsize=None)
def embedded_asset_inventory() -> tuple[str, ...]:
    """Every file rust-embed can ship, repository-relative.

    The asset tree plus every directory any `#[folder = ...]` in the repository
    points at. Not a list of asset directories: rust-embed ships whole
    directories, so the directories it names are the inventory, and a list of
    the ones somebody remembered is how assets/images/zed_logo.svg reached a
    signed, notarized 0.2.0-rc11 while OMEGA-DELTA-0018 reported assets/icons/
    clean, truthfully.

    Deriving the roots from the embed declarations rather than writing them
    here means a rust-embed folder added tomorrow is inside the gate the day it
    is added, instead of being outside it until somebody notices.
    """
    roots = [ROOT / EMBEDDED["asset_root"]]
    roots.extend(folder for _source, folder in embed_folders())
    files: set[str] = set()
    for root in roots:
        if not root.is_dir():
            continue
        for path in root.rglob("*"):
            if path.is_file() and path.name != ".DS_Store":
                try:
                    files.add(str(path.resolve().relative_to(ROOT)))
                except ValueError:
                    continue
    return tuple(sorted(files))


def action_declarations() -> list[tuple[str, str, str]]:
    """Every gpui action in the repository as (namespace, name, file).

    There are exactly two ways to declare one, and both are read here, so this
    is the complete set of `namespace: action name` labels the command palette
    can display.
    """
    declarations: list[tuple[str, str, str]] = []
    root = ROOT / ACTIONS["search_root"]
    for path, text in rust_sources(root):
        relative = str(path.relative_to(ROOT))
        for match in re.finditer(r"(?:gpui::)?actions!\(\s*", text):
            head = re.match(r"([A-Za-z_][A-Za-z0-9_]*)(\s*,\s*\[)", text[match.end() :])
            if head is None:
                continue
            namespace = head.group(1)
            start = match.end() + head.end(2)
            depth, index = 1, start
            while index < len(text) and depth:
                if text[index] == "[":
                    depth += 1
                elif text[index] == "]":
                    depth -= 1
                index += 1
            for line in text[start : index - 1].splitlines():
                stripped = line.strip().rstrip(",")
                if re.fullmatch(r"[A-Z][A-Za-z0-9]*", stripped):
                    declarations.append((namespace, stripped, relative))
        for match in re.finditer(
            r"#\[action\(([^)]*)\)\]"
            r"(?:\s*#\[[^\]]*\])*\s*pub\s+(?:struct|enum)\s+([A-Za-z0-9_]+)",
            text,
            re.S,
        ):
            namespace = re.search(
                r"namespace\s*=\s*([A-Za-z_][A-Za-z0-9_]*)", match.group(1)
            )
            if namespace is not None:
                declarations.append((namespace.group(1), match.group(2), relative))
    return declarations


# --------------------------------------------------- OMEGA-DELTA-0022, source


@functools.lru_cache(maxsize=None)
def asset_path_directories() -> frozenset[str]:
    """Leading path segment of every embedded asset, as rust-embed keys it."""
    root = Path(EMBEDDED["asset_root"])
    directories = set()
    for relative in embedded_asset_inventory():
        path = Path(relative)
        if path.parts[0] == root.name and len(path.parts) > 2:
            directories.add(path.parts[1])
    return frozenset(directories)


def check_embedded_assets() -> None:
    """OMEGA-DELTA-0022, source side."""
    inventory = embedded_asset_inventory()
    allowed = set(EMBEDDED["third_party_allowances"])
    tokens = [token.lower() for token in EMBEDDED["forbidden_path_tokens"]]
    minimum = EMBEDDED["minimum_inventory"]
    if len(inventory) < minimum:
        fail(
            f"OMEGA-DELTA-0022: only {len(inventory)} embeddable files were "
            f"found, below the {minimum} floor. The walk broke and this check "
            "is reporting green about nothing."
        )
    if not embed_folders():
        fail(
            "OMEGA-DELTA-0022: no rust-embed #[folder] declarations were found, "
            "so the inventory is no longer derived from what decides what ships"
        )
    for relative in inventory:
        if relative in allowed:
            continue
        if any(token in relative.lower() for token in tokens):
            fail(
                f"OMEGA-DELTA-0022: {relative} carries a competitor's name and "
                "is inside a directory rust-embed ships. Replace the artwork "
                "and the file name, or record why it identifies somebody "
                "else's product in script/omega-brand-gate.json."
            )


def check_asset_name_enums() -> None:
    """Every enum that turns an identifier into an embedded asset path.

    Discovered from the source rather than listed, because listing is what let
    VectorName sit outside OMEGA-DELTA-0018 while IconName was inside it.
    """
    tokens = ENUMS["forbidden_variant_tokens"]
    allowed = set(ENUMS["third_party_allowances"])
    directories = asset_path_directories()
    discovered: dict[str, list[str]] = {}
    for _path, text in rust_sources(ROOT / ENUMS["search_root"]):
        named = {
            match.group(1)
            for match in re.finditer(r'format!\(\s*"([A-Za-z0-9_]+)/\{', text)
            if match.group(1) in directories
        }
        if not named:
            continue
        for match in re.finditer(r"pub enum ([A-Za-z0-9_]+) \{\n(.*?)\n\}", text, re.S):
            name, body = match.group(1), match.group(2)
            variants = [
                line.strip().rstrip(",")
                for line in body.splitlines()
                if re.fullmatch(r"[A-Z][A-Za-z0-9]*,?", line.strip())
            ]
            if variants:
                discovered[name] = variants

    for required in ENUMS["required_discoveries"]:
        if required not in discovered:
            fail(
                f"OMEGA-DELTA-0022: the asset-name-enum discovery no longer "
                f"finds {required}. The parser broke and this check is "
                "reporting green about nothing."
            )
    for name, variants in sorted(discovered.items()):
        if len(variants) < ENUMS["minimum_variants"]:
            fail(f"OMEGA-DELTA-0022: {name} parsed as {len(variants)} variants")
        for variant in variants:
            if f"{name}::{variant}" in allowed:
                continue
            if any(token in variant for token in tokens):
                fail(
                    f"OMEGA-DELTA-0022: {name}::{variant} names a competitor "
                    "and resolves to a shipped asset. Renaming the file without "
                    "renaming the identifier leaves the next rebase a name to "
                    "restore the artwork under."
                )


def check_action_labels() -> None:
    """OMEGA-DELTA-0022. The command palette shows every action's name."""
    declarations = action_declarations()
    minimum = ACTIONS["minimum_inventory"]
    if len(declarations) < minimum:
        fail(
            f"OMEGA-DELTA-0022: only {len(declarations)} action declarations "
            f"were parsed, below the {minimum} floor; this check is vacuous"
        )
    labels = {f"{namespace}::{name}" for namespace, name, _ in declarations}
    for required in ACTIONS["required_actions"]:
        if required not in labels:
            fail(
                f"OMEGA-DELTA-0022: {required} is not in the parsed action set, "
                "so the parser is not reading the declarations it claims to"
            )
    allowed = set(ACTIONS["third_party_allowances"])
    namespace_tokens = [token.lower() for token in ACTIONS["forbidden_namespace_tokens"]]
    name_tokens = ACTIONS["forbidden_name_tokens"]
    for namespace, name, source in sorted(declarations):
        if f"{namespace}::{name}" in allowed:
            continue
        if any(token in namespace.lower() for token in namespace_tokens):
            fail(
                f"OMEGA-DELTA-0022: the command palette would offer "
                f"'{namespace}: ...' from {source}. An action namespace is a "
                "user-facing label, not an internal seam."
            )
        if any(token in name for token in name_tokens):
            fail(
                f"OMEGA-DELTA-0022: the command palette would offer "
                f"'{namespace}::{name}' from {source}, which names a competitor."
            )


# ------------------------------------------- OMEGA-DELTA-0031, prose inventory


PROSE_CLASSIFIED = PROSE["classified"]
PROSE_CORPUS = set(PROSE["corpus_files"])
SUGAR_DOC_LINE = re.compile(r"^\s*(?:///|//!)(.*)$")
# `#[doc = "..."]` and `#[cfg_attr(<predicate>, doc = "...")]` are doc comments
# written the long way, and clap and schemars read them exactly the same. The
# gate did not, which is why `~/Library/Application Support/Zed` was printed as
# the data directory by `cli --help` in every candidate up to 0.2.0-rc14 while
# this file reported green -- the line is a `cfg_attr`, and nothing here had
# ever looked inside one (omega#89).
# Either `#[... doc = "..."]` on one line, or the `doc = "..."` line of an
# attribute written across several. Anchoring on the line start keeps a Rust
# `let doc = "..."` binding out.
ATTR_DOC_LINE = re.compile(r'^\s*(?:#\[.*?)?\bdoc\s*=\s*"((?:[^"\\]|\\.)*)"')


def doc_line_body(line: str) -> str | None:
    """The text of a doc comment, however it was spelled."""
    match = SUGAR_DOC_LINE.match(line)
    if match is not None:
        return match.group(1)
    match = ATTR_DOC_LINE.match(line)
    if match is not None:
        return match.group(1)
    return None
DERIVES_SCHEMA = re.compile(r"#\[derive\([^)]*JsonSchema")
DERIVES_CLAP = re.compile(r"#\[derive\([^)]*(?:Parser|Args|Subcommand)|#\[command\(|clap::Parser")
PLAIN_WORD = re.compile(r"[A-Za-z']+")


def normalize_prose(text: str) -> str:
    return " ".join(text.split())


def is_prose(text: str) -> bool:
    """Prose-shaped: three tokens or more, at least two plain alphabetic words.

    The one judgement in the whole derivation. It keeps identifiers, asset
    paths and header names out of a registry that would otherwise be mostly
    noise, and it is deliberately loose: `Zed Plex Sans` is three words and is
    in the inventory, classified, rather than quietly filtered away.
    """
    tokens = text.split()
    if len(tokens) < 3:
        return False
    plain = 0
    for token in tokens:
        trimmed = token.strip(
            "".join(
                character
                for character in set(token)
                if not ("a" <= character.lower() <= "z") and character != "'"
            )
        )
        if trimmed and PLAIN_WORD.fullmatch(trimmed):
            plain += 1
    return plain >= 2


def rust_string_literals(text: str) -> list[tuple[int, str]]:
    """(start line, contents) for every Rust string literal in `text`.

    Raw strings and multi-line strings included, comments skipped. A regex over
    single lines misses exactly the literals that carry the longest copy: the
    OAuth callback page, the root-user warning and four provider error
    messages are all multi-line.
    """
    out: list[tuple[int, str]] = []
    index, length, line = 0, len(text), 1
    while index < length:
        char = text[index]
        if char == "\n":
            line += 1
            index += 1
            continue
        if text.startswith("//", index):
            while index < length and text[index] != "\n":
                index += 1
            continue
        if text.startswith("/*", index):
            depth, index = 1, index + 2
            while index < length and depth:
                if text.startswith("/*", index):
                    depth += 1
                    index += 2
                elif text.startswith("*/", index):
                    depth -= 1
                    index += 2
                else:
                    if text[index] == "\n":
                        line += 1
                    index += 1
            continue
        if char == "r" and index + 1 < length and text[index + 1] in '"#':
            cursor = index + 1
            hashes = 0
            while cursor < length and text[cursor] == "#":
                hashes += 1
                cursor += 1
            if cursor < length and text[cursor] == '"':
                start_line, cursor = line, cursor + 1
                close = '"' + "#" * hashes
                end = text.find(close, cursor)
                if end == -1:
                    break
                body = text[cursor:end]
                line += body.count("\n")
                out.append((start_line, body))
                index = end + len(close)
                continue
        if char == '"':
            start_line = line
            cursor, buffer = index + 1, []
            while cursor < length:
                if text[cursor] == "\\":
                    line += text.count("\n", cursor, cursor + 2)
                    buffer.append(text[cursor : cursor + 2])
                    cursor += 2
                    continue
                if text[cursor] == '"':
                    break
                if text[cursor] == "\n":
                    line += 1
                buffer.append(text[cursor])
                cursor += 1
            out.append((start_line, "".join(buffer)))
            index = cursor + 1
            continue
        if char == "'":
            if text.startswith("\\", index + 1):
                index += 4
            elif index + 2 < length and text[index + 2] == "'":
                index += 3
            else:
                index += 1
            continue
        index += 1
    return out


TEST_PATH = re.compile(r"(^|/)(tests?|benches|examples|fixtures)/|_tests?\.rs$")


def cfg_test_lines(text: str) -> set[int]:
    """Line numbers inside a `#[cfg(test)]` item, which a release does not build.

    Over-excluding here would be a hole, so the packaged half below reads the
    binary that was actually built and does not honour this at all.
    """
    out: set[int] = set()
    lines = text.splitlines()
    for start, line in enumerate(lines):
        if not re.match(r"\s*#\[cfg\(\s*(?:any\([^)]*)?test", line):
            continue
        depth, opened = 0, False
        for cursor in range(start, len(lines)):
            depth += lines[cursor].count("{") - lines[cursor].count("}")
            if "{" in lines[cursor]:
                opened = True
            out.add(cursor + 1)
            if opened and depth <= 0:
                break
    return out


def action_doc_lines(text: str) -> set[int]:
    """Doc lines the keymap editor renders as an action's description."""
    out: set[int] = set()
    lines = text.splitlines()
    for match in re.finditer(r"(?:gpui::)?actions!\(", text):
        depth, index = 0, match.end() - 1
        while index < len(text):
            if text[index] == "(":
                depth += 1
            elif text[index] == ")":
                depth -= 1
                if depth == 0:
                    break
            index += 1
        out.update(
            range(text.count("\n", 0, match.start()) + 1, text.count("\n", 0, index) + 2)
        )
    for index, line in enumerate(lines):
        if "#[action(" not in line:
            continue
        cursor = index - 1
        while cursor >= 0 and (
            doc_line_body(lines[cursor]) is not None
            or lines[cursor].strip().startswith("#[")
        ):
            if doc_line_body(lines[cursor]) is not None:
                out.add(cursor + 1)
            cursor -= 1
    return out


@functools.lru_cache(maxsize=None)
def prose_inventory() -> tuple[tuple[tuple[str, str, int, str], ...], dict[str, int]]:
    """Every brand-bearing prose literal that can reach a user, plus read counts.

    The counts are the anti-vacuity guard. They measure what the scanners read,
    not what they found, because a clean tree finds nothing and a broken parser
    also finds nothing.
    """
    items: list[tuple[str, str, int, str]] = []
    read = dict(rust_files=0, literals=0, schema_docs=0, action_docs=0, clap_docs=0, embedded=0)
    for path, text in rust_sources(ROOT / PROSE["rust_root"]):
        relative = str(path.relative_to(ROOT))
        read["rust_files"] += 1
        literals = rust_string_literals(text)
        read["literals"] += len(literals)
        lines = text.splitlines()
        code = "\n".join("" if doc_line_body(line) is not None else line for line in lines)
        schema = bool(DERIVES_SCHEMA.search(code))
        clap = bool(DERIVES_CLAP.search(code))
        actions = action_doc_lines(text)
        for number, line in enumerate(lines, 1):
            if doc_line_body(line) is None:
                continue
            if number in actions:
                read["action_docs"] += 1
            elif schema:
                read["schema_docs"] += 1
            elif clap:
                read["clap_docs"] += 1
        if not brand_hits(text):
            continue
        is_test_file = bool(TEST_PATH.search(relative))
        skipped = set() if is_test_file else cfg_test_lines(text)
        for number, body in literals:
            if is_test_file or number in skipped:
                continue
            if brand_hits(body) and is_prose(body):
                items.append(("rust_string", relative, number, normalize_prose(body)))
        for number, line in enumerate(lines, 1):
            if is_test_file or number in skipped:
                continue
            doc = doc_line_body(line)
            if doc is None or not brand_hits(doc) or not is_prose(doc):
                continue
            if number in actions:
                kind = "action_doc"
            elif schema:
                kind = "schema_doc"
            elif clap:
                kind = "clap_doc"
            else:
                continue
            items.append((kind, relative, number, normalize_prose(doc)))

    for relative in embedded_asset_inventory():
        read["embedded"] += 1
        try:
            text = (ROOT / relative).read_text(encoding="utf-8")
        except (OSError, UnicodeDecodeError):
            continue
        if not brand_hits(text):
            continue
        for number, line in enumerate(text.splitlines(), 1):
            if brand_hits(line) and is_prose(line):
                items.append(("asset", relative, number, normalize_prose(line)))
    return tuple(items), read


def check_prose_inventory() -> None:
    """OMEGA-DELTA-0031, source side."""
    items, read = prose_inventory()
    floors = [
        ("minimum_rust_files", read["rust_files"], "Rust sources"),
        ("minimum_rust_string_literals", read["literals"], "Rust string literals"),
        ("minimum_schema_doc_lines", read["schema_docs"], "settings-schema doc lines"),
        ("minimum_action_doc_lines", read["action_docs"], "action doc lines"),
        ("minimum_clap_doc_lines", read["clap_docs"], "--help doc lines"),
        ("minimum_embedded_files", read["embedded"], "embedded asset files"),
    ]
    for key, actual, label in floors:
        if actual < PROSE[key]:
            fail(
                f"OMEGA-DELTA-0031: only {actual} {label} were read, below the "
                f"{PROSE[key]} floor. That parser broke, and a check that reads "
                "nothing reports green about nothing."
            )

    unclassified: list[str] = []
    for kind, relative, number, text in items:
        if relative in PROSE_CORPUS or text in PROSE_CLASSIFIED:
            continue
        unclassified.append(f"{relative}:{number} [{kind}] {text[:160]!r}")
    for entry in sorted(set(unclassified)):
        fail(
            f"OMEGA-DELTA-0031: unclassified brand-bearing prose at {entry}. "
            "Substitute our own name: if the sentence stays true with 'Omega' "
            "in it, the brand was standing where our product's name belongs -- "
            "rewrite it. If it becomes false, it names somebody else's product "
            "and belongs in prose.classified with a class and a reason."
        )

    present = {text for _kind, _relative, _number, text in items}
    for text, entry in PROSE_CLASSIFIED.items():
        if entry.get("packaged_only") or text in present:
            continue
        fail(
            f"OMEGA-DELTA-0031: prose.classified records {text[:80]!r}, which is "
            "no longer anywhere in the tree. Either the sentence was removed and "
            "the entry should go with it, or a scanner stopped reading the "
            "stream that used to find it."
        )


# -------------------------------------------------------------- packaged mode


def walk_plist(value, path: str):
    if isinstance(value, dict):
        for key, item in value.items():
            yield f"{path}.{key}" if path else key, key
            yield from walk_plist(item, f"{path}.{key}" if path else key)
    elif isinstance(value, (list, tuple)):
        for index, item in enumerate(value):
            yield from walk_plist(item, f"{path}[{index}]")
    elif isinstance(value, str):
        yield path, value


def check_packaged_info_plist(app: Path) -> None:
    """OMEGA-DELTA-0017, packaged side.

    Reads the merged Info.plist that actually ships, walking every value
    rather than a list of keys, because macOS renders these strings in its own
    permission dialogs under our Developer ID signature.
    """
    plists = sorted(app.rglob("*.plist"))
    info = app / "Contents/Info.plist"
    if not info.is_file():
        fail(f"packaged Info.plist is missing: {info}")
        return
    for path in plists:
        try:
            data = plistlib.loads(path.read_bytes())
        except Exception as error:  # noqa: BLE001 - report, do not swallow
            fail(f"cannot parse packaged plist {path}: {error}")
            continue
        for key_path, text in walk_plist(data, ""):
            for hit in brand_hits(text):
                fail(
                    f"OMEGA-DELTA-0017: packaged {path.relative_to(app.parent)} "
                    f"{key_path} names {hit!r}: {text!r}"
                )


# ---------------------------------- OMEGA-DELTA-0038, every shipped executable


MACHO_MAGIC = (
    b"\xcf\xfa\xed\xfe",  # 64-bit little-endian
    b"\xce\xfa\xed\xfe",  # 32-bit little-endian
    b"\xca\xfe\xba\xbe",  # universal
    b"\xbe\xba\xfe\xca",  # universal, byte-swapped
)


@functools.lru_cache(maxsize=None)
def bundle_executables(app: Path) -> tuple[Path, ...]:
    """Every Mach-O executable the bundle ships, found by walking it.

    Not a list of binary names. `script/bundle-omega-rc` copies and signs
    `cli` and `omega-identity-proof` into `Contents/MacOS` beside `omega`, and
    every packaged check here used to open `Contents/MacOS/omega` and nothing
    else. That is why `cli` shipped an uninstaller that deleted a competitor's
    application and none of ours through two published prereleases (omega#88),
    with the gate reporting green about the bundle: the defect was never in a
    file any check opened.

    A helper added to the bundle tomorrow is inside the gate the day it is
    added, the same way rust-embed's `#[folder]` declarations made the asset
    inventory derived rather than remembered.
    """
    found: list[Path] = []
    for path in sorted(app.rglob("*")):
        if path.is_symlink() or not path.is_file():
            continue
        try:
            head = path.open("rb").read(4)
        except OSError:
            continue
        if head in MACHO_MAGIC:
            found.append(path)
    return tuple(found)


def main_binary(app: Path) -> Path:
    return app / "Contents/MacOS/omega"


def check_packaged_executable_inventory(app: Path) -> None:
    """Anti-vacuity for the walk above, and for the bundle it walked."""
    executables = bundle_executables(app)
    if not executables:
        fail(
            "OMEGA-DELTA-0038: no Mach-O executable was found anywhere in "
            f"{app}. The walk broke, and every packaged check below is "
            "reporting green about nothing."
        )
        return
    if main_binary(app) not in executables:
        fail(
            f"OMEGA-DELTA-0038: {main_binary(app)} is not among the "
            "executables found in the bundle"
        )
    minimum = POLICY.get("packaged", {}).get("minimum_executables", 2)
    if len(executables) < minimum:
        fail(
            f"OMEGA-DELTA-0038: only {len(executables)} executables were found "
            f"in the bundle, below the {minimum} floor. A bundle that ships a "
            "companion binary and a scan that sees one binary is exactly the "
            "shape omega#88 shipped in."
        )


def printable_runs(data: bytes, minimum: int = 8):
    """Every printable ASCII run in a binary, as (start offset, text)."""
    for run in re.finditer(rb"[\x20-\x7e]{%d,}" % minimum, data):
        yield run.start(), run.group(0).decode("ascii")


def check_packaged_first_party_agent(app: Path) -> None:
    """OMEGA-DELTA-0024, packaged side.

    `first_party_agent.phrases` had been applied to nothing by either half of
    this gate since it was written: `grep -c first_party_agent
    script/verify-omega-brand` returned 0, and the only reader was a Rust test
    over the source tree. A reviewer had to run it by hand against a package
    every time, which is the same as not having it (omega#89).
    """
    agent = POLICY["first_party_agent"]
    phrases = [phrase.lower() for phrase in agent["phrases"]]
    symbols = agent.get("symbols", [])
    if not phrases:
        fail("OMEGA-DELTA-0024: first_party_agent.phrases is empty; check vacuous")
        return
    identity = agent["identity"]
    carried = False
    for binary in bundle_executables(app):
        data = binary.read_bytes()
        if identity.encode() in data:
            carried = True
        for _offset, blob in printable_runs(data):
            lowered = blob.lower()
            for phrase in phrases:
                if phrase in lowered:
                    at = lowered.index(phrase)
                    window = blob[max(0, at - 60) : at + len(phrase) + 60]
                    fail(
                        f"OMEGA-DELTA-0024: packaged "
                        f"{binary.relative_to(app.parent)} presents somebody "
                        f"else's agent as the first-party one: ...{window}..."
                    )
        for symbol in symbols:
            if symbol.encode() in data:
                fail(
                    f"OMEGA-DELTA-0024: packaged "
                    f"{binary.relative_to(app.parent)} still carries the "
                    f"symbol {symbol!r}"
                )
    if not carried:
        fail(
            f"OMEGA-DELTA-0024: no packaged executable carries {identity!r}, so "
            "this scan found nothing because it read nothing"
        )


# ------------------------------- OMEGA-DELTA-0038, help as the user reads it


HELP_SUBCOMMAND = re.compile(r"^\s{2,}([a-z][a-z0-9-]*)(?:\s|$)")


def rendered_output(binary: Path, arguments: list[str]) -> str | None:
    """Run the shipped binary and return what it printed, or None if it could
    not be run at all."""
    import subprocess

    try:
        completed = subprocess.run(
            [str(binary), *arguments],
            capture_output=True,
            timeout=120,
            check=False,
            cwd="/",
            env={"PATH": "/usr/bin:/bin", "HOME": "/nonexistent-omega-brand-gate"},
        )
    except (OSError, subprocess.SubprocessError):
        return None
    return (completed.stdout + completed.stderr).decode("utf-8", errors="replace")


def help_subcommands(text: str) -> list[str]:
    """Subcommand names out of a clap `Commands:` block."""
    names: list[str] = []
    inside = False
    for line in text.splitlines():
        if line.rstrip().endswith(":"):
            inside = line.strip() in ("Commands:", "Subcommands:")
            continue
        if not inside:
            continue
        if not line.strip():
            continue
        match = HELP_SUBCOMMAND.match(line)
        if match and match.group(1) not in ("help",):
            names.append(match.group(1))
    return names


def help_units(text: str) -> list[str]:
    """What a person reads, as they read it: whole descriptions, not lines.

    clap wraps a description to the terminal width, so the sentence the user
    sees arrives split across several lines. Reading line by line hid exactly
    the defect this gate was written for: `~/Library/Application Support/Zed`
    lands as `... location: \`~/Library/Application` on one line and
    `Support/Zed\`` on the next, and neither fragment is three words. Blocks
    are joined back before anything is judged, and the individual lines are
    kept too, so a short label is still read on its own.
    """
    units: list[str] = []
    block: list[str] = []
    for line in text.splitlines():
        stripped = line.strip()
        if stripped:
            units.append(stripped)
            block.append(stripped)
            continue
        if block:
            units.append(" ".join(block))
            block = []
    if block:
        units.append(" ".join(block))
    return units


def check_rendered_help(app: Path) -> None:
    """OMEGA-DELTA-0038. The `--help` a person actually sees.

    Every other stream in OMEGA-DELTA-0031 reads *source*: the doc line, the
    literal, the schema comment. clap does not print source. It joins several
    doc lines into one sentence, resolves `cfg_attr` for the platform it was
    built for, prints the flag *name* beside the description, and lays the
    whole thing out at run time. Nothing had ever read that output, which is
    how `--zed <ZED>`, `Run zed in the foreground` and a `--user-data-dir`
    line naming the wrong product's data directory all shipped in
    `0.2.0-rc14` under a green gate (omega#89).

    This runs the binaries that ship, with `--help`, and reads what comes back.
    Subcommands are enumerated from the output rather than listed, so a
    subcommand added tomorrow is read the day it is added.
    """
    executables = bundle_executables(app)
    if not executables:
        return
    rendered = 0
    for binary in executables:
        pending: list[list[str]] = [["--help"], ["--version"]]
        seen: set[tuple[str, ...]] = set()
        while pending:
            arguments = pending.pop(0)
            key = tuple(arguments)
            if key in seen:
                continue
            seen.add(key)
            text = rendered_output(binary, arguments)
            if text is None:
                continue
            rendered += 1
            if arguments[-1] == "--help":
                for name in help_subcommands(text):
                    if len(arguments) < 4:
                        pending.append([*arguments[:-1], name, "--help"])
            where = f"{binary.relative_to(app.parent)} {' '.join(arguments)}"

            # A flag name, a value placeholder and a subcommand are labels, not
            # sentences, so the prose rule below cannot see them -- `--zed
            # <ZED>` is two tokens. They are read here on their own terms, the
            # way an action namespace is: the palette shows `omega: about`, and
            # `--help` shows `--zed`, and both are copy the user reads.
            for token in set(re.findall(r"--[A-Za-z0-9][A-Za-z0-9-]*", text)):
                if brand_hits(token):
                    fail(
                        f"OMEGA-DELTA-0038: `{where}` offers the option "
                        f"{token!r}, which names a competitor. An option name is "
                        "a user-facing label; renaming the description and "
                        "leaving the flag is half a rename."
                    )
            for token in set(re.findall(r"<([A-Za-z0-9_]+)>", text)):
                if brand_hits(token) or brand_hits(token.capitalize()):
                    fail(
                        f"OMEGA-DELTA-0038: `{where}` names the value "
                        f"placeholder <{token}>, which carries a competitor's "
                        "name."
                    )
            if arguments[-1] == "--help":
                for name in help_subcommands(text):
                    if brand_hits(name):
                        fail(
                            f"OMEGA-DELTA-0038: `{where}` offers the subcommand "
                            f"{name!r}, which names a competitor."
                        )

            for stripped in help_units(text):
                if not brand_hits(stripped):
                    continue
                normalized = normalize_prose(stripped)
                if normalized in PROSE_CLASSIFIED:
                    continue
                if any(
                    fragment in normalized
                    for fragment in packaged_covering_fragments()
                ):
                    continue
                if not is_prose(normalized):
                    continue
                fail(
                    f"OMEGA-DELTA-0038: `{where}` prints a line naming a "
                    f"competitor: {normalized!r}. This is the sentence the user "
                    "reads; clap builds it at run time out of doc lines the "
                    "source scan sees separately, so fixing it means fixing the "
                    "text, not the check."
                )
    minimum = POLICY.get("packaged", {}).get("minimum_rendered_invocations", 4)
    if rendered < minimum:
        fail(
            f"OMEGA-DELTA-0038: only {rendered} rendered outputs were read, "
            f"below the {minimum} floor. The binaries did not run, and a gate "
            "that reads nothing reports green about nothing."
        )


def check_packaged_icons(app: Path) -> None:
    """OMEGA-DELTA-0018, packaged side.

    Icons are embedded into the executable by rust-embed, so the packaged app
    has no assets directory. Both the asset path literals and the raw SVG
    bytes survive in the binary, so this checks the names AND the artwork.
    """
    binary = main_binary(app)
    if not binary.is_file():
        fail(f"packaged Omega binary is missing: {binary}")
        return
    data = binary.read_bytes()

    # The name rule runs over every executable in the bundle; the artwork pin
    # runs over the one that embeds the assets.
    embedded_anywhere: set[str] = set()
    for executable in bundle_executables(app):
        blob = executable.read_bytes()
        embedded = sorted(
            {match.decode() for match in re.findall(rb"icons/[A-Za-z0-9_]+\.svg", blob)}
        )
        embedded_anywhere.update(embedded)
        for relative in embedded:
            stem = relative[len("icons/") : -len(".svg")]
            if stem_is_forbidden(stem):
                fail(
                    f"OMEGA-DELTA-0018: packaged "
                    f"{executable.relative_to(app.parent)} embeds {relative}"
                )
    if not embedded_anywhere:
        fail(
            "no embedded icon asset paths were found in any packaged binary; "
            "this check would be vacuous"
        )

    for relative, expected in sorted(REVIEWED_MARKS.items()):
        source = ROOT / relative
        if not source.is_file():
            fail(f"OMEGA-DELTA-0018: reviewed Omega mark is missing: {relative}")
            continue
        artwork = source.read_bytes()
        if hashlib.sha256(artwork).hexdigest() != expected:
            fail(f"OMEGA-DELTA-0018: {relative} is not the reviewed artwork")
            continue
        if artwork not in data:
            fail(
                f"OMEGA-DELTA-0018: the reviewed artwork for {relative} is not "
                "in the packaged binary. The package was built from different "
                "bytes than the ones that were reviewed."
            )


def check_packaged_assets_and_actions(app: Path) -> None:
    """OMEGA-DELTA-0022, packaged side.

    Assets are embedded into the executable by rust-embed and action names are
    built at compile time, so both survive in the binary as strings. The asset
    directories searched for are derived from the assets tree rather than
    listed, so a directory added tomorrow is read the same way assets/images/
    now is -- it was the missing directory in rc11, not a missing rule.
    """
    binary = main_binary(app)
    if not binary.is_file():
        fail(f"packaged Omega binary is missing: {binary}")
        return
    data = binary.read_bytes()

    root = Path(EMBEDDED["asset_root"])
    directories = sorted(asset_path_directories())
    if not directories:
        fail("OMEGA-DELTA-0022: no asset directories were derived; check vacuous")
        return
    allowed = [
        relative[len(f"{root}/") :]
        for relative in EMBEDDED["third_party_allowances"]
        if relative.startswith(f"{root}/")
    ]
    tokens = [token.lower() for token in EMBEDDED["forbidden_path_tokens"]]
    directory_group = "|".join(re.escape(name) for name in directories)

    # Rust string tables have no separators, so a match runs on into the next
    # literal. The scan is anchored on the forbidden token rather than trying
    # to find where one path ends: a match is reported only when a competitor's
    # name is inside something shaped like an embedded asset path, and an
    # allowance is accepted as a prefix of the run-on match.
    if not re.search(rb"(?:" + directory_group.encode() + rb")/", data):
        fail(
            "OMEGA-DELTA-0022: no embedded asset paths were found in the "
            "packaged binary; this check would be vacuous"
        )
    token_group = "|".join(re.escape(token) for token in tokens)
    pattern = rf"(?:{directory_group})/[\w./-]*(?:{token_group})[\w./-]*".encode()
    for executable in bundle_executables(app):
        blob = executable.read_bytes()
        for match in sorted({found.decode() for found in re.findall(pattern, blob)}):
            if any(match.startswith(entry) for entry in allowed):
                continue
            fail(
                f"OMEGA-DELTA-0022: packaged "
                f"{executable.relative_to(app.parent)} embeds {match}"
            )

    # Action labels, checked by presence of the current ones.
    #
    # A stripped binary's string table has no separators and no type
    # information: `zed::About` appears as `zed::AboutOpens`, and a Rust module
    # path like `zed_edit_prediction_delegate::ZedEditPredictionDelegate` is
    # indistinguishable from an action name. An exhaustive absence check over
    # that is noise, and a noisy gate gets deleted. The absence rule is enforced
    # on the source, where a declaration can actually be read; what the package
    # can prove is that the labels the source declares are the labels that were
    # built. 0.2.0-rc11 carries `zed::About` and not `omega::About`, so this
    # rejects it, and a package built from a reverted tree fails the same way.
    required = ACTIONS["required_actions"]
    if not required:
        fail("OMEGA-DELTA-0022: actions.required_actions is empty; check vacuous")
    for label in required:
        if label.encode() not in data:
            fail(
                f"OMEGA-DELTA-0022: packaged Omega does not carry the action "
                f"label {label!r}. The package was built from a tree that still "
                "declares a competitor's namespace, whatever the source scan "
                "above says about this checkout."
            )



@functools.lru_cache(maxsize=None)
def packaged_covering_fragments() -> list[str]:
    """Classified prose as it survives compilation, normalized.

    A classified entry is the literal as written; the binary holds the value.
    Three differences matter and each produced a false failure the first time
    it was hit: a `\\` line continuation joins two lines with no separator, a
    `\\n` becomes a real newline that splits the printable run in half, and a
    non-ASCII character does the same thing. The packaged scan matches
    `[\\x20-\\x7e]` runs, so an em-dash or a curly quote inside a classified
    sentence ends the run there. A sentence whose brand mention sits past such
    a character could never cover its own occurrence, and the gate reported an
    offender that had been correctly classified all along.

    Splitting is conservative rather than permissive: coverage requires a
    fragment to *span* the brand occurrence, so shorter fragments cover less,
    never more.
    """
    fragments: list[str] = []
    for text in PROSE_CLASSIFIED:
        joined = text.replace("\\ ", " ")
        # A `{}` placeholder is not in the binary either: rustc splits a format
        # string at every placeholder and stores the pieces, so a classified
        # sentence written with one could never cover its own occurrence in the
        # string table. Splitting there is conservative in the same direction as
        # the rules above -- shorter fragments cover less, never more.
        for part in re.split(r"\\[nrt]|\{[^{}]*\}|[^\x20-\x7e]+", joined):
            part = normalize_prose(part)
            if part and brand_hits(part):
                fragments.append(part)
    return fragments


def normalized_with_offsets(text: str) -> tuple[str, list[int]]:
    """`normalize_prose(text)` plus the source index each output character came
    from, so a brand occurrence in the raw run can be located in the normalized
    one."""
    out: list[str] = []
    offsets: list[int] = []
    pending = False
    for index, char in enumerate(text):
        if char.isspace():
            pending = bool(out)
            continue
        if pending:
            out.append(" ")
            offsets.append(index)
            pending = False
        out.append(char)
        offsets.append(index)
    return "".join(out), offsets


def check_packaged_prose(app: Path) -> None:
    """OMEGA-DELTA-0031, packaged side.

    Every brand-bearing prose literal in the executable that actually ships,
    read out of the binary rather than out of the tree it was supposedly built
    from. This half does not honour `#[cfg(test)]`, does not care which crate a
    string came from, and sees generated files: the licence attribution page is
    gitignored and exists only here.

    A stripped string table has no separators, so a literal runs on into its
    neighbour. The scan is therefore anchored on each brand occurrence and
    reports one only when the brand sits in running text AND no classified
    sentence spans that position.
    """
    binary = main_binary(app)
    if not binary.is_file():
        fail(f"packaged Omega binary is missing: {binary}")
        return

    covering = packaged_covering_fragments()
    if not covering:
        fail("OMEGA-DELTA-0031: no classified prose carries a brand; check vacuous")
        return

    scanned, offenders = 0, set()
    main_scanned = 0
    for executable in bundle_executables(app):
        data = executable.read_bytes()
        before = scanned
        scanned, found = scan_binary_prose(data, covering, scanned)
        if executable == binary:
            main_scanned = scanned - before
        for window in found:
            offenders.add((str(executable.relative_to(app.parent)), window))
    if scanned == 0 or main_scanned == 0:
        fail(
            "OMEGA-DELTA-0031: no brand-bearing prose was found in the packaged "
            "binaries at all, not even the classified third-party references. "
            "The string scan broke; a clean package still carries those."
        )
    for where, window in sorted(offenders):
        fail(
            f"OMEGA-DELTA-0031: packaged {where} carries unclassified prose: "
            f"...{window}... The package was built from a tree that still "
            "presents a competitor as the product, whatever the source scan "
            "above says about this checkout."
        )


# A brand occurrence only counts as prose when it is written as a word in
# running text. `/Zed/` in a path list, `ENV=Zed` in a task-template
# placeholder and `X-Zed-Predict-Edits-Mode` in an HTTP header are all
# neighbours of real sentences in a stripped string table, and reporting them
# is how a gate earns the reputation that gets it deleted.
BEFORE_OK = set(" (\"'`\t*[|>\u2014-")
AFTER_OK = set(" .,:;!?)]}'\"`<>/\u2014\u2026\t-")


def scan_binary_prose(
    data: bytes, covering: list[str], scanned: int
) -> tuple[int, set[str]]:
    """Brand occurrences in one executable's string table that no classified
    sentence spans. Returns the running scanned count and the offenders."""
    offenders: set[str] = set()
    for run in re.finditer(rb"[\x20-\x7e]{8,}", data):
        blob = run.group(0).decode("ascii")
        if not any(word in blob for word in WORDS):
            continue
        flat, offsets = normalized_with_offsets(blob)
        for word in WORDS:
            for match in re.finditer(re.escape(word), blob):
                start, end = match.start(), match.end()
                before = blob[start - 1] if start else " "
                after = blob[end] if end < len(blob) else " "
                if before.isalnum() or after.isalnum():
                    continue
                if before not in BEFORE_OK or after not in AFTER_OK:
                    continue
                # A brand hyphenated on both sides is part of an identifier.
                if before == "-" and after == "-":
                    continue
                window = blob[max(0, start - 90) : end + 90]
                if not is_prose(window):
                    continue
                scanned += 1
                try:
                    flat_start = offsets.index(start)
                except ValueError:
                    continue
                flat_end = flat_start + (end - start)
                covered = False
                for fragment in covering:
                    at = flat.find(fragment)
                    while at != -1 and not covered:
                        if at <= flat_start and flat_end <= at + len(fragment):
                            covered = True
                        at = flat.find(fragment, at + 1)
                    if covered:
                        break
                if not covered:
                    offenders.add(normalize_prose(window))
    return scanned, offenders


check_info_plist_fragments()
check_icon_inventory()
check_embedded_assets()
check_asset_name_enums()
check_action_labels()
check_prose_inventory()
if APP is not None:
    if not APP.is_dir():
        fail(f"packaged application is missing: {APP}")
    else:
        check_packaged_executable_inventory(APP)
        check_packaged_info_plist(APP)
        check_packaged_icons(APP)
        check_packaged_assets_and_actions(APP)
        check_packaged_prose(APP)
        check_packaged_first_party_agent(APP)
        check_rendered_help(APP)

if failures:
    print("Omega brand gate FAILED:", file=sys.stderr)
    for failure in failures:
        print(f"  - {failure}", file=sys.stderr)
    raise SystemExit(1)

scope = "source tree" if APP is None else f"source tree and {APP}"
print(f"Omega brand gate ok ({scope})")
