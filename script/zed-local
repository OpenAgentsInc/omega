#!/usr/bin/env node
// Compatibility wrapper: prefer `script/omega-local` (OMEGA-DELTA-0190 / omega#174).
const { spawnSync } = require("child_process");
const path = require("path");
const result = spawnSync(
  process.execPath,
  [path.join(__dirname, "omega-local"), ...process.argv.slice(2)],
  { stdio: "inherit" }
);
process.exit(result.status ?? 1);
